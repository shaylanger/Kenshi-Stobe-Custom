diff -urN a/src/ActivityTravelArrival.h b/src/ActivityTravelArrival.h
--- a/src/ActivityTravelArrival.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/ActivityTravelArrival.h	2026-10-16 17:57:33.733241200 -0600
@@ -0,0 +1,16 @@
+#pragma once
+// imm26-fix26a3 (row 26-a): pure arrival decision for a scoped native Travel order (no game types, testable offline).
+// The engine removes a MOVE_CUS_ORDERED order itself at its OWN completion radius, which is wider than our 8 u 3D arrival test
+// (NATIVE_TRAVEL_ORDER_ENDED planar=9.0 dy=3.0 arrived8=0 in run 26-a-op14g; NativeTravelRouteTarget::kEngineEndRadius = 16 u planar
+// for the route order). An ended order near the point is an arrival, not "owned_order_changed_or_ended".
+#include <cmath>
+namespace Stobe { namespace ActivityTravel {
+const double kEngineEndRadius = 16.0; // planar (x,z; y is up in Kenshi), only when the order list is EMPTY (the engine ended the order)
+// dx,dz = actor minus destination on the ground plane. orderListEmpty = the actor's order list has no entry at all
+// (a foreign / replaced order is a conflict, never an arrival).
+inline bool EndedNearPoint(bool orderListEmpty, double dx, double dz) {
+ if(!orderListEmpty) return false;
+ if(!(dx==dx) || !(dz==dz)) return false; // NaN
+ return dx*dx+dz*dz<=kEngineEndRadius*kEngineEndRadius;
+}
+} }
