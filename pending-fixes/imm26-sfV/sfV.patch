+    if ($sid !== '') return $sid;
+    // imm26 sfV: some NPC rows carry no storage id in metadata, which silently dropped the told-facts
+    // read/write and keyed principles by name. Fall back to the id the info panel itself sends
+    // (hand_<live serial>, also the storage alias used elsewhere). One resolver for read AND write.
+    $col = normalizeStorageIdToken(strval($npcData['storage_id'] ?? ''));
+    if ($col !== '') return $col;
+    $name = trim($nameHint !== '' ? $nameHint : strval($npcData['name'] ?? ''));
+    if ($name !== '' && function_exists('stobeResolveLiveParticipantSerial')) {
+        try { $serial = intval(stobeResolveLiveParticipantSerial($name)); } catch (Throwable $e) { $serial = 0; }
+        if ($serial > 0) return 'hand_' . $serial;
+    }
+    return '';
 }
 
