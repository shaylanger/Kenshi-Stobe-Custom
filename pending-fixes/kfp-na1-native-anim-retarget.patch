+static void vm_na_apply(void *b[2][4], float w)
+{
+    Vec3 S[2], Sc[2];
+    for (int i = 0; i < 2; i++) {
+        const Vec3 *ps = g_oldnode_getdpos(b[i][0]);
+        if (!readable((void *)ps, 12)) return;
+        S[i] = *ps; Sc[i] = vm_na_s2c(S[i]); g_vm_na_nat[i] = vm_na_s2c(g_vm_nhp[i]);
+    }
+    if (w <= 0.001f) { g_vm_na_have[0] = g_vm_na_have[1] = 0; return; }
+    const char *st = g_vm_state ? g_vm_state : "";
+    int blk = !strcmp(st, "blocking"), fit = !g_fpc_fs_tech && (blk || !strcmp(st, "ready"));
+    g_vm_na_frz = !fit;
+    for (int i = 0; i < 2; i++) {
+        Vec3 h; Quat Rc;
+        if (g_vm_na_mode == 1) {
+            Vec3 G = blk ? g_vm_na_gb : g_vm_na_g; if (!i) G.x = -G.x;
+            Vec3 v = vm_sub(g_vm_na_nat[i], Sc[i]), t = vm_sub(G, Sc[i]);
+            if (fit && vm_len(v) > 1e-3f && vm_len(t) > 1e-3f) {
+                Quat Rt = vm_fromto(v, t); Vec3 Dt = vm_sub(t, quat_rotvec(Rt, v));
+                float a = g_vm_na_have[i] ? 1.0f - expf(-fminf(g_vm_dt, g_vm_maxdt) / fmaxf(g_vm_na_tau, 1e-3f)) : 1.0f;
+                g_vm_na_R[i] = g_vm_na_have[i] ? quat_norm(quat_slerp(g_vm_na_R[i], Rt, a)) : Rt;
+                g_vm_na_D[i] = g_vm_na_have[i] ? vm_lerp(g_vm_na_D[i], Dt, a) : Dt; g_vm_na_have[i] = 1;
+            }
+            if (!g_vm_na_have[i]) return;
+            Rc = g_vm_na_R[i];
+            h = vm_add(vm_add(Sc[i], quat_rotvec(Rc, v)), g_vm_na_D[i]);
+        } else {   /* modes 0 and 2: one rigid turn of both arms about the shoulder midpoint (coherent: no amplification) */
+            Vec3 M = vm_mul(vm_add(Sc[0], Sc[1]), 0.5f);
+            h = vm_add(vm_add(M, vm_na_rot(vm_sub(g_vm_na_nat[i], M))), g_vm_na_off);
+            h.x += (i ? 1.0f : -1.0f) * g_vm_na_spread;
+            Rc = (Quat){ 1, 0, 0, 0 };
+            if (g_vm_na_mode == 2) {   /* + per-arm shift fitted so the native ready/block hand sits on G/GB, frozen during techniques */
+                Vec3 G = blk ? g_vm_na_gb : g_vm_na_g; if (!i) G.x = -G.x;
