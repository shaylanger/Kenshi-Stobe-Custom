+                    g_vm_na_D[i] = g_vm_na_have[i] ? vm_lerp(g_vm_na_D[i], Dt, a) : Dt; g_vm_na_have[i] = 1; }
+                if (!g_vm_na_have[i]) return;
+                h = vm_add(h, g_vm_na_D[i]);
+            }
+        }
+        g_vm_na_out[i] = h;
+        /* the same turn in skeleton space (images of two axes; the camera frame may be mirrored against the skeleton) */
+        Vec3 ex = g_vm_na_mode == 1 ? vm_w2s_dir(vm_c2w_dir(quat_rotvec(Rc, vm_w2c_dir(vm_s2w_dir(vm_v(1, 0, 0)))))) : vm_na_rot_s(vm_v(1, 0, 0));
+        Vec3 ey = g_vm_na_mode == 1 ? vm_w2s_dir(vm_c2w_dir(quat_rotvec(Rc, vm_w2c_dir(vm_s2w_dir(vm_v(0, 1, 0)))))) : vm_na_rot_s(vm_v(0, 1, 0));
+        Quat Rs = vm_frame_quat(ex, ey);
+        Vec3 Ph = vm_w2s_pos(vm_c2w_pos(h));
+        Quat Qh = quat_norm(quat_mul(Rs, g_vm_nhq[i]));
+        if (!vm_ik(i, b[i][0], b[i][1], b[i][2], Ph, Qh, 0, g_vm_tpole[i], w, NULL, 0.0f)) g_vm_ikfail++;
+    }
+    g_vm_na_n++; g_vm_applied++;
+}
