+/* NA1: skeleton <-> camera numbers, and the retarget rotation (camera numbers: x right, y up, z forward) */
+static Vec3 vm_na_s2c(Vec3 s) { return vm_w2c_dir(vm_sub(vm_add(g_vm_cmw, vm_s2w_dir(vm_sub(s, g_vm_cms))), vm_c2w_pos(vm_v(0, 0, 0)))); }   /* c2w_pos(0) = eye */
+static Vec3 vm_na_rot(Vec3 v)
+{
