diff -urN a/src/ActivityOffMeshReach.h b/src/ActivityOffMeshReach.h
--- a/src/ActivityOffMeshReach.h	1969-12-31 18:00:00.000000000 -0600
+++ b/src/ActivityOffMeshReach.h	2026-10-16 18:42:09.294511200 -0600
@@ -0,0 +1,20 @@
+#pragma once
+// imm26-fix26anav (row 26-a NC31): reachability for a visible Hunt target when the actor itself reports off-navmesh.
+// NC31 required avatar->isOnNavmesh() before pathExists(); right after the route arrival Malzin stood 6.7 u from the (mesh-projected) route point
+// with isOnNavmesh()==0 for the whole 16-scan grace (ACTIVITY_SCAN_DIAG onMesh=0 rawPath=99 reach=0), so pathExists was never asked and
+// the agreed goat 31 u away was "current_native_path_unconfirmed" -> no_observed_suitable_reachable_target. pathExists can only start from the
+// avatar, so an off-mesh avatar cannot be probed; accept a short-range, visible, mesh-adjacent target instead (the native order paths itself;
+// the Goal no-progress timeout still ends an order that cannot get there). Pure (no game types), testable offline.
+namespace Stobe { namespace ActivityReach {
+const double kOffMeshShortRange = 35.0; // planar (x,z) actor-to-target limit
+const double kOffMeshMaxDy = 12.0;      // vertical limit (roof / ledge is not "near")
+const float  kTargetSnapRadius = 20.0f; // getClosestPoint radius used by the caller to prove the TARGET stands on/next to walkable mesh
+// dx,dz,dy = target minus actor. onMesh = avatar->isOnNavmesh(). Only the off-mesh case is decided here; an on-mesh avatar keeps the pathExists verdict.
+inline bool OffMeshShortRange(bool huntKind, bool onMesh, bool visible, bool targetOnMesh, double dx, double dz, double dy) {
+ if(!huntKind || onMesh || !visible || !targetOnMesh) return false;
+ if(!(dx==dx) || !(dz==dz) || !(dy==dy)) return false; // NaN
+ const double adx = dy<0 ? -dy : dy;
+ if(adx>kOffMeshMaxDy) return false;
+ return dx*dx+dz*dz<=kOffMeshShortRange*kOffMeshShortRange;
+}
+} }
