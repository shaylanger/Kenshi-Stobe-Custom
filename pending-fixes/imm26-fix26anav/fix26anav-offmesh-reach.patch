+ if(!t.reachable && a.kind==Hunt && actor && avatar && world_->navmesh && t.visible && _finite(p.x)&&_finite(p.y)&&_finite(p.z) && !avatar->isOnNavmesh()) {
+  Ogre::Vector3 snap; bool targetOnMesh=false;
