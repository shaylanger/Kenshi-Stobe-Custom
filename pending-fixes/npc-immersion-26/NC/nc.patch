diff -ruN --binary a/legacy-v1/ActivityGoals.cpp b/legacy-v1/ActivityGoals.cpp
--- a/legacy-v1/ActivityGoals.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/legacy-v1/ActivityGoals.cpp	2026-10-15 15:43:16.856413643 -0500
@@ -0,0 +1,222 @@
+#include "ActivityGoals.h"
+#include <algorithm>
+#include <sstream>
+
+namespace Stobe { namespace ActivityV1Legacy {
+Agreement::Agreement() : actor(0), requester(0), kind(Hunt), quantity(0),
+ maximumTargets(1), maximumReplans(3), expiresAt(0), noProgressTimeout(0) {}
+Target::Target() : serial(0), visible(false), reachable(false), hostile(false),
+ legalHunt(false), resourceUsable(false), lootPermitted(false), dead(false),
+ defeated(false), harvestable(false), hasRequestedItem(false) {}
+Facts::Facts() : actorLoaded(false), actorAlive(false), actorConscious(false),
+ revoked(true), conflictingOrder(true), inventorySpace(false), arrived(false),
+ pathFailed(false), delivered(0) {}
+Receipt::Receipt() : status(Pending) {}
+Goal::Goal() : phase_(Dormant), stopPhase_(Dormant), stopPending_(false), replanPending_(false), lastProgress_(0), lastNow_(0), delivered_(0),
+ replans_(0), sequence_(0), pendingCommand_(Travel) {}
+
+bool Goal::Start(const Agreement& terms, Clock now, Host& host) {
+  if (phase_ != Dormant) return false; // One agreement per instance; no id reuse.
+  std::string denial;
+  if (terms.id.empty() || terms.worldId.empty() || !terms.actor || !terms.requester ||
+      terms.expiresAt <= now ||
+      !terms.noProgressTimeout || !terms.maximumTargets || terms.maximumTargets > 64 ||
+      terms.maximumReplans > 16 || terms.sourceId.empty() ||
+      (terms.kind != Hunt && terms.kind != Mine && terms.kind != ClearGroup) ||
+      ((terms.kind == Hunt || terms.kind == Mine) &&
+       (!terms.quantity || terms.quantity > 1000 || terms.resourceId.empty())) ||
+      (terms.kind == ClearGroup && (terms.agreedTargets.empty() ||
+                                   terms.agreedTargets.size() > terms.maximumTargets)) ||
+      !host.Authorized(terms, now, denial)) {
+    reason_ = denial.empty() ? "invalid_activity_agreement" : denial;
+    return false;
+  }
+  std::vector<unsigned int> targets = terms.agreedTargets;
+  std::sort(targets.begin(), targets.end());
+  if (std::find(targets.begin(), targets.end(), 0) != targets.end() ||
+      std::adjacent_find(targets.begin(), targets.end()) != targets.end() ||
+      std::find(targets.begin(), targets.end(), terms.actor) != targets.end() ||
+      std::find(targets.begin(), targets.end(), terms.requester) != targets.end()) {
+    reason_ = "invalid_agreed_target_set"; return false;
+  }
+  terms_ = terms;
+  phase_ = Searching;
+  lastNow_ = lastProgress_ = now;
+  reason_ = "activity_agreed";
+  return true;
+}
+
+bool Goal::Release(Host& host) {
+  if (pending_.empty()) return true;
+  if (!host.CancelOwned(pending_)) return false;
+  pending_.clear();
+  return true;
+}
+void Goal::Stop(Phase phase, Host& host, const std::string& why) {
+  stopPending_=true; stopPhase_=phase; stopReason_=why; replanPending_=false;
+  if (!Release(host)) { reason_ = "owned_order_cleanup_pending: " + why; return; }
+  stopPending_=false;
+  phase_ = phase;
+  reason_ = why;
+}
+void Goal::Cancel(Host& host, const std::string& why) { Stop(Cancelled, host, why); }
+bool Goal::Suitable(const Target& t) const {
+  if (!t.serial || t.serial == terms_.actor || t.serial == terms_.requester ||
+      (terms_.kind != ClearGroup && t.sourceId != terms_.sourceId) || !t.visible || !t.reachable || t.candidateId.empty() ||
+      std::find(attempted_.begin(), attempted_.end(), t.serial) != attempted_.end()) return false;
+  if (terms_.kind == Mine) return t.resourceUsable;
+  if (terms_.kind == ClearGroup)
+    return t.hostile && !t.dead && !t.defeated &&
+      std::find(terms_.agreedTargets.begin(), terms_.agreedTargets.end(), t.serial) != terms_.agreedTargets.end();
+  return t.harvestable ? (t.lootPermitted && t.hasRequestedItem) : (!t.dead && t.legalHunt);
+}
+bool Goal::Issue(Command command, Host& host) {
+  Request r;
+  std::ostringstream id;
+  id << terms_.id << ":" << ++sequence_;
+  r.id = id.str(); r.agreementId = terms_.id; r.actor = terms_.actor;
+  r.target = target_.serial; r.candidateId = target_.candidateId;
+  r.resourceId = terms_.resourceId;
+  r.quantity = terms_.quantity > delivered_ ? terms_.quantity - delivered_ : 0;
+  r.command = command;
+  std::string why;
+  pending_ = r.id; pendingCommand_ = command; // Retain even partial failed dispatch for cleanup.
+  if (!host.Dispatch(terms_, r, why)) { reason_ = why.empty() ? "dispatch_rejected" : why; return false; }
+  pending_ = r.id; pendingCommand_ = command;
+  return true;
+}
+void Goal::Replan(Clock now, Host& host, const std::string& why) {
+  replanPending_=true; replanReason_=why;
+  if (!Release(host)) { reason_ = "owned_order_cleanup_pending: " + why; return; }
+  replanPending_=false;
+  if (target_.serial) attempted_.push_back(target_.serial);
+  if (++replans_ > terms_.maximumReplans || attempted_.size() >= terms_.maximumTargets) {
+    phase_ = Failed; reason_ = why; return;
+  }
+  target_ = Target(); phase_ = Searching; reason_ = why;
+  // Replanning is not progress: retain the last independently verified progress time.
+  (void)now;
+}
+
+void Goal::Tick(Clock now, Host& host) {
+  if (stopPending_) { Stop(stopPhase_,host,stopReason_); return; }
+  if (phase_ == Dormant || phase_ == Complete || phase_ == Cancelled) return;
+  if (phase_ == Failed) { if (!pending_.empty()) Release(host); return; }
+  std::string denial;
+  if (now < lastNow_ || now >= terms_.expiresAt || !host.Authorized(terms_, now, denial)) {
+    Stop(Cancelled, host, denial.empty() ? "agreement_expired_or_clock_reset" : denial); return;
+  }
+  lastNow_ = now;
+  if (replanPending_) { Replan(now,host,replanReason_); return; }
+  Facts f = host.Observe(terms_, target_.serial);
+  if (f.worldId != terms_.worldId || !f.actorLoaded || !f.actorAlive || !f.actorConscious ||
+      f.revoked || f.conflictingOrder) {
+    Stop(Cancelled, host, "actor_world_authority_or_order_changed"); return;
+  }
+  if (f.delivered < delivered_) { Stop(Failed, host, "progress_counter_regressed"); return; }
+  if (f.delivered > delivered_) { delivered_ = f.delivered; lastProgress_ = now; }
+  if (terms_.kind != ClearGroup && delivered_ >= terms_.quantity) {
+    Stop(Complete, host, "agreed_quantity_delivered"); return;
+  }
+
+  if (terms_.kind != ClearGroup && !f.inventorySpace) {
+    Stop(Failed, host, "inventory_full"); return;
+  }
+  // Independently defeated agreed members count only on fresh identity-bound
+  // observation; missing/despawned characters never count as defeated.
+  if (terms_.kind == ClearGroup) {
+    for (size_t i=0; i<terms_.agreedTargets.size(); ++i) {
+      unsigned int serial=terms_.agreedTargets[i];
+      bool already=std::find(completed_.begin(), completed_.end(), serial)!=completed_.end();
+      Facts member=host.Observe(terms_,serial);
+      if (member.worldId==terms_.worldId && member.target.serial==serial &&
+          member.target.visible && (member.target.dead || member.target.defeated)) {
+        if(member.target.dead && std::find(confirmedDead_.begin(),confirmedDead_.end(),serial)==confirmedDead_.end())confirmedDead_.push_back(serial);
+        if(!already) { completed_.push_back(serial); attempted_.push_back(serial); lastProgress_=now; }
+      } else if(already && (std::find(confirmedDead_.begin(),confirmedDead_.end(),serial)==confirmedDead_.end() ||
+          (member.worldId==terms_.worldId && member.target.serial==serial && member.target.visible))) {
+        completed_.erase(std::remove(completed_.begin(),completed_.end(),serial),completed_.end());
+        attempted_.erase(std::remove(attempted_.begin(),attempted_.end(),serial),attempted_.end());
+      }
+    }
+    if (completed_.size()==terms_.agreedTargets.size()) {
+      Stop(Complete,host,"agreed_targets_defeated"); return;
+    }
+  }
+  if (now - lastProgress_ >= terms_.noProgressTimeout) {
+    Stop(Failed, host, "activity_no_verified_progress"); return;
+  }
+  if (phase_ == Searching) {
+    const std::vector<Target> candidates = host.Candidates(terms_);
+    for (size_t i = 0; i < candidates.size(); ++i) {
+      if (Suitable(candidates[i])) { target_ = candidates[i];
+        // A later search with no candidates must not erase the actionable
+        // reason that caused this replan. Clear it only after a replacement
+        // target has actually passed the policy gate.
+        replanReason_.clear();
+        if (Issue(Travel, host)) phase_ = Travelling;
+        else Replan(now, host, reason_);
+        return;
+      }
+    }
+    const std::string noTargetReason = replanReason_.empty()
+      ? "no_observed_suitable_reachable_target"
+      : replanReason_ + "; no_observed_suitable_reachable_target";
+    Stop(Failed, host, noTargetReason); return;
+  }
+  if (f.target.serial != target_.serial || f.target.sourceId != target_.sourceId || !f.target.visible) {
+    Replan(now, host, "target_unavailable_or_identity_changed"); return;
+  }
+  // Preserve the agreed registry point until the host explicitly revalidates it.
+  target_.dead = f.target.dead; target_.defeated = f.target.defeated;
+  target_.hostile = f.target.hostile; target_.legalHunt = f.target.legalHunt;
+  target_.lootPermitted = f.target.lootPermitted;
+  target_.hasRequestedItem = f.target.hasRequestedItem; target_.harvestable = f.target.harvestable;
+  target_.resourceUsable = f.target.resourceUsable;
+  if (f.pathFailed) { Replan(now, host, "path_failed"); return; }
+  if (terms_.kind == ClearGroup && (target_.dead || target_.defeated)) {
+    if (!Release(host)) { reason_="owned_order_cleanup_pending"; return; }
+    if (std::find(completed_.begin(), completed_.end(), target_.serial)==completed_.end()) { completed_.push_back(target_.serial); attempted_.push_back(target_.serial); }
+    lastProgress_ = now;
+    if (completed_.size() == terms_.agreedTargets.size()) { Stop(Complete, host, "agreed_targets_defeated"); return; }
+    phase_ = Searching; target_ = Target(); return;
+  }
+  if ((terms_.kind == ClearGroup && !target_.hostile) ||
+      (terms_.kind == Hunt && !target_.harvestable && !target_.legalHunt) ||
+      (terms_.kind == Mine && !target_.resourceUsable)) {
+    Replan(now, host, "target_no_longer_authorized_or_usable"); return;
+  }
+  // A fresh legally harvestable target ends the owned hunt attack before the
+  // dispatch policy would correctly refuse another attack on that target.
+  if (!pending_.empty() && pendingCommand_ == Attack && terms_.kind == Hunt && target_.harvestable) {
+    if (!Release(host)) { reason_="owned_order_cleanup_pending";return; }
+    phase_=Verifying;
+  }
+  if (!pending_.empty()) {
+    Receipt receipt = host.Poll(pending_);
+    if (receipt.status == Receipt::Pending) {
+      // Killing is not completion: stop the owned attack before harvesting.
+      if (!(pendingCommand_ == Attack && terms_.kind == Hunt && target_.harvestable)) return;
+    } else if (receipt.status == Receipt::Rejected || receipt.status == Receipt::Interrupted) {
+      Replan(now, host, receipt.reason.empty() ? "action_interrupted" : receipt.reason); return;
+    }
+    if (!Release(host)) { reason_="owned_order_cleanup_pending"; return; }
+    phase_ = Verifying;
+    if (pendingCommand_ == Travel && !f.arrived) { Replan(now, host, "arrival_not_verified"); return; }
+    if (pendingCommand_ == TakeItem) { reason_="harvest_transfer_verified_recheck_remaining"; return; }
+    if (pendingCommand_ == WorkResource) { reason_="resource_transfer_verified_recheck_quantity"; return; }
+    if (pendingCommand_ == Attack && !target_.dead && !target_.defeated && !target_.harvestable) {
+      Replan(now, host, "attack_ended_without_verified_result"); return;
+    }
+  }
+  Command next = WorkResource;
+  if (terms_.kind != Mine) {
+    if (terms_.kind == Hunt && target_.harvestable) {
+      if (!target_.lootPermitted || !target_.hasRequestedItem) { Replan(now, host, "requested_loot_unavailable_or_not_permitted"); return; }
+      next = TakeItem;
+    } else next = Attack;
+  }
+  if (Issue(next, host)) phase_ = Performing;
+  else Replan(now, host, reason_);
+}
+} }
diff -ruN --binary a/legacy-v1/ActivityGoals.h b/legacy-v1/ActivityGoals.h
--- a/legacy-v1/ActivityGoals.h	1969-12-31 18:00:00.000000000 -0600
+++ b/legacy-v1/ActivityGoals.h	2026-10-15 15:43:16.871807043 -0500
@@ -0,0 +1,93 @@
+#pragma once
+#include <string>
+#include <vector>
+
+namespace Stobe { namespace ActivityV1Legacy {
+typedef unsigned long long Clock;
+enum Kind { Hunt, Mine, ClearGroup };
+enum Phase { Dormant, Searching, Travelling, Performing, Verifying, Complete, Cancelled, Failed };
+enum Command { Travel, Attack, WorkResource, TakeItem };
+
+// Created by the trusted agreement layer, never directly from model output.
+// Movement agreements cannot be substituted for this explicit activity grant.
+struct Agreement {
+  std::string id, worldId, sourceId, resourceId;
+  unsigned int actor, requester;
+  Kind kind;
+  unsigned int quantity, maximumTargets, maximumReplans;
+  Clock expiresAt, noProgressTimeout;
+  std::vector<unsigned int> agreedTargets;
+  Agreement();
+};
+struct Target {
+  unsigned int serial;
+  std::string sourceId, candidateId;
+  bool visible, reachable, hostile, legalHunt, resourceUsable, lootPermitted;
+  bool dead, defeated, harvestable, hasRequestedItem;
+  Target();
+};
+struct Facts {
+  std::string worldId;
+  bool actorLoaded, actorAlive, actorConscious, revoked, conflictingOrder;
+  bool inventorySpace, arrived, pathFailed;
+  // Monotonic, goal-owned delivered quantity: NOT an actor's total inventory.
+  unsigned int delivered;
+  Target target;
+  Facts();
+};
+struct Request {
+  std::string id, agreementId, candidateId, resourceId;
+  unsigned int actor, target, quantity;
+  Command command;
+};
+struct Receipt {
+  enum Status { Pending, Succeeded, Rejected, Interrupted } status;
+  std::string reason;
+  Receipt();
+};
+
+// Implemented only by deliberate native integration. Every method runs on the
+// game thread. Existing squad-only executor gates must remain unchanged.
+class Host {
+public:
+  virtual ~Host() {}
+  virtual bool Authorized(const Agreement&, Clock now, std::string& reason) = 0;
+  virtual Facts Observe(const Agreement&, unsigned int target) = 0;
+  virtual std::vector<Target> Candidates(const Agreement&) = 0;
+  // Recheck source identity, ownership/crime, current hostility, registry/path,
+  // actor authority and inventory immediately before every actual dispatch.
+  virtual bool Dispatch(const Agreement&, const Request&, std::string& reason) = 0;
+  virtual Receipt Poll(const std::string& requestId) = 0;
+  // Remove only the order/job identified by this request's owned fingerprint.
+  // False means cleanup is unconfirmed; do not dispatch a replacement then.
+  virtual bool CancelOwned(const std::string& requestId) = 0;
+};
+
+class Goal {
+public:
+  Goal();
+  bool Start(const Agreement&, Clock now, Host&);
+  void Tick(Clock now, Host&);
+  void Cancel(Host&, const std::string& reason);
+  Phase State() const { return phase_; }
+  bool CleanupComplete() const { return pending_.empty(); }
+  const std::string& Reason() const { return reason_; }
+  const Agreement& Terms() const { return terms_; }
+private:
+  Agreement terms_;
+  Phase phase_, stopPhase_;
+  bool stopPending_, replanPending_;
+  std::string stopReason_, replanReason_;
+  std::string reason_, pending_;
+  Target target_;
+  Clock lastProgress_, lastNow_;
+  unsigned int delivered_, replans_, sequence_;
+  std::vector<unsigned int> completed_, attempted_, confirmedDead_;
+  Command pendingCommand_;
+  bool Suitable(const Target&) const;
+  bool Issue(Command, Host&);
+  bool Release(Host&);
+  void Stop(Phase, Host&, const std::string&);
+  void Replan(Clock, Host&, const std::string&);
+};
+} }
diff -ruN --binary a/legacy-v1/ActivityNativeExecutor.cpp b/legacy-v1/ActivityNativeExecutor.cpp
--- a/legacy-v1/ActivityNativeExecutor.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/legacy-v1/ActivityNativeExecutor.cpp	2026-10-15 15:43:16.883341543 -0500
@@ -0,0 +1,370 @@
+#include "ActivityNativeExecutor.h"
+#include "ActivityPolicySupport.h"
+#include "AutonomyExecutor.h"
+#include "KenshiAiCompat.h"
+#include "KenshiBuildingCompat.h"
+#include <kenshi/AI/AITaskSystem.h>
+#include <kenshi/Character.h>
+#include <kenshi/CharBody.h>
+#include <kenshi/CharMovement.h>
+#include <kenshi/Tasker.h>
+#include <kenshi/GameData.h>
+#include <kenshi/Inventory.h>
+#include <kenshi/Item.h>
+#include <algorithm>
+#include <cmath>
+#include <float.h>
+#include <cstdint>
+namespace Stobe { namespace ActivityV1Legacy {
+namespace {
+unsigned Count(Inventory* inventory, const std::string& sid) {
+ if (!inventory || sid.empty()) return 0;
+ unsigned n=0;
+ const lektor<Item*>& items=inventory->getAllItems();
+ for (unsigned i=0;i<items.size();++i) {
+  Item* item=items.stuff[i];
+  if (item && item->data && item->data->stringID==sid)
+   n+=static_cast<unsigned>(std::max(1,item->quantity));
+ }
+ return n;
+}
+bool AliveActor(Character* actor, unsigned serial) {
+ return actor && actor->getHandle().serial==serial && !actor->isDead() && !actor->isUnconcious();
+}
+bool SameHand(const hand& a,const hand& b) {
+ return a.serial==b.serial && a.index==b.index && a.type==b.type &&
+  a.container==b.container && a.containerSerial==b.containerSerial;
+}
+Receipt Result(Receipt::Status s, const std::string& reason) {
+ Receipt r; r.status=s; r.reason=reason; return r;
+}
+}
+NativeDestination::NativeDestination():x(0),y(0),z(0) {}
+NativeExecutor::Operation::Operation():cleanupRequired(false),mineLease(false),orderCaptured(false),orderRemoved(false),orderStartTime(0),outputBaseline(0),transferRecovery(false),detached(NULL),transferSource(NULL),transferAmount(0),sourceBefore(0),recipientBefore(0) {}
+NativeExecutor::NativeExecutor(NativePolicy& policy):policy_(policy),world_(NULL),now_(0) {}
+bool NativeExecutor::CaptureOwned(Character* actor,Operation& op,bool initial) {
+ if(!actor || !SameHand(actor->getHandle(),op.actorIdentity) || op.orderRemoved)return false;
+ OrdersReceiver* orders=actor->getOrdersReciever();
+ if(!orders || orders->orders.list.size()!=1)return false;
+ Tasker* first=orders->orders.list.front();
+ if(!first || !first->taskData || static_cast<int>(first->taskData->key)!=op.owned.taskType ||
+    !SameHand(first->subject,op.subjectIdentity))return false;
+ if(op.request.command==Travel) {
+  const Ogre::Vector3 p=first->getLocation();
+  if(!_finite(p.x)||!_finite(p.y)||!_finite(p.z) || std::fabs(p.x-op.owned.x)>0.5 ||
+     std::fabs(p.y-op.owned.y)>0.5 || std::fabs(p.z-op.owned.z)>0.5)return false;
+ }
+ const unsigned long long pointer=reinterpret_cast<unsigned long long>(first);
+ if(!initial && (!op.orderCaptured || pointer!=op.owned.runtimePointer || first->startTime!=op.orderStartTime))return false;
+ if(initial) {op.owned.runtimePointer=pointer;op.owned.orderCount=1;op.orderStartTime=first->startTime;op.orderCaptured=true;}
+ return true;
+}
+bool NativeExecutor::NativeEnded(Character* actor,const Operation& op) {
+ if(!actor || !SameHand(actor->getHandle(),op.actorIdentity))return false;
+ OrdersReceiver* orders=actor->getOrdersReciever();
+ if(!orders || !orders->orders.list.empty())return false;
+ const TaskMatch& goal=orders->getCurrentGoal();
+ if(goal.taskData && SameHand(goal.subject,op.subjectIdentity) &&
+    (static_cast<int>(goal.key())==op.owned.taskType || op.subjectIdentity.serial!=0))return false;
+ CharBody* body=actor->getBody();if(!body)return false;
+ Tasker* action=body->currentAction;
+ if(action && action->taskData && SameHand(action->subject,op.subjectIdentity) &&
+    (static_cast<int>(action->taskData->key)==op.owned.taskType || op.subjectIdentity.serial!=0))return false;
+ CharMovement* movement=actor->getMovement();
+ return movement && !movement->isCurrentlyMoving();
+}
+void NativeExecutor::Bind(GameWorld* world,const std::string& id,Clock now) {
+ // A world change invalidates pointers; never cancel an old world's order in a new one.
+ if (world_!=world || worldId_!=id) { operations_.clear(); delivered_.clear(); }
+ world_=world; worldId_=id; now_=now;
+}
+unsigned NativeExecutor::Delivered(const std::string& id) const {
+ std::map<std::string,unsigned>::const_iterator it=delivered_.find(id);
+ return it==delivered_.end()?0:it->second;
+}
+bool NativeExecutor::Observe(const Agreement& a,Target& target,Facts& facts) {
+ if (!world_ || a.worldId!=worldId_) return false;
+ try {
+  const KenshiAi::CharacterSnapshot actor=KenshiAi::CaptureCharacter(world_,a.actor);
+  facts.actorLoaded=actor.found && actor.identityMatches;
+  facts.actorAlive=facts.actorLoaded && !actor.dead;
+  facts.actorConscious=facts.actorAlive && !actor.unconscious;
+  facts.pathFailed=actor.pathFailed; facts.delivered=Delivered(a.id);
+  Character* inventoryActor=KenshiAi::ResolveCharacter(world_,a.actor);
+  // Capacity is authoritative at giveItem; presence permits an attempt, never credits progress.
+  facts.inventorySpace=inventoryActor && inventoryActor->getInventory()!=NULL;
+  bool owns=false;
+  for (std::map<std::string,Operation>::iterator it=operations_.begin();it!=operations_.end();++it) {
+   Operation& op=it->second;
+   if (op.agreement.id!=a.id || !op.cleanupRequired) continue;
+   Character* c=KenshiAi::ResolveCharacter(world_,a.actor);
+   if (c && CaptureOwned(c,op,false)) owns=true;
+   else if (actor.order.orderCount>0) facts.conflictingOrder=true;
+   if (op.request.command==Travel) {
+    const double dx=actor.x-op.destination.x,dy=actor.y-op.destination.y,dz=actor.z-op.destination.z;
+    facts.arrived=dx*dx+dy*dy+dz*dz<=64.0;
+   }
+  }
+  if (actor.order.orderCount>0 && !owns) facts.conflictingOrder=true;
+  if (a.kind!=Mine && target.serial) {
+   Character* t=KenshiAi::ResolveCharacter(world_,target.serial);
+   Character* c=KenshiAi::ResolveCharacter(world_,a.actor);
+   if (!t || !c || t->getHandle().serial!=target.serial) { target.visible=false; return true; }
+   target.dead=t->isDead(); target.defeated=target.dead || t->isUnconcious();
+   target.hostile=c->isEnemy(t,true);
+   target.hasRequestedItem=Count(t->getInventory(),a.resourceId)>0;
+  }
+  facts.target=target; return true;
+ } catch (...) { return false; }
+}
+bool NativeExecutor::Transfer(Operation& op,Inventory* source,std::string& reason) {
+ Character* actor=KenshiAi::ResolveCharacter(world_,op.agreement.actor);
+ if (!source || !AliveActor(actor,op.agreement.actor) || !SameHand(actor->getHandle(),op.actorIdentity)) { reason="inventory_unavailable"; return false; }
+ Inventory* recipient=actor->getInventory();
+ if (!recipient || source==recipient) { reason="invalid_transfer_inventory"; return false; }
+ const std::string& sid=op.agreement.resourceId;
+ const unsigned already=Delivered(op.agreement.id);
+ if (already>=op.agreement.quantity || !op.request.quantity) { reason="quantity_already_satisfied"; return false; }
+ const unsigned beforeSource=Count(source,sid),beforeActor=Count(recipient,sid);
+ unsigned available=beforeSource;
+ if (op.request.command==WorkResource) {
+  if (beforeSource<=op.outputBaseline) { reason="awaiting_verified_output"; return false; }
+  available=std::min(beforeSource-op.outputBaseline,MineOutputCredit(op.agreement.id));
+ }
+ Item* item=NULL;
+ const lektor<Item*>& items=source->getAllItems();
+ for(unsigned i=0;i<items.size();++i) {
+  Item* x=items.stuff[i];
+  if(x && x->data && x->data->stringID==sid && !x->isEquipped) { item=x; break; }
+ }
+ if(!item) { reason="exact_resource_item_absent"; return false; }
+ const unsigned amount=std::min(std::min(op.request.quantity,op.agreement.quantity-already),
+  std::min(available,static_cast<unsigned>(std::max(1,item->quantity))));
+ if(!amount) { reason="no_new_output"; return false; }
+ Item* detached=source->removeItemDontDestroy_returnsItem(item,static_cast<int>(amount),false);
+ if(!detached) { reason="detach_rejected"; return false; }
+ op.transferRecovery=true; op.detached=detached; op.transferSource=source; op.transferAmount=amount;
+ op.sourceBefore=beforeSource; op.recipientBefore=beforeActor;
+ bool accepted=false;
+ try { accepted=actor->giveItem(detached,false,false); } catch (...) {}
+ if(!accepted) {
+  bool restored=false;
+  try { restored=source->addItem(detached,static_cast<int>(amount),false,false); } catch (...) {}
+  if(restored) {
+   op.detached=NULL;
+   if(Count(source,sid)==beforeSource && Count(recipient,sid)==beforeActor) { op.transferRecovery=false; op.transferSource=NULL; }
+  }
+  reason=restored?"recipient_full":"transfer_rollback_unconfirmed"; return false;
+ }
+ op.detached=NULL; // Successful add may merge/destroy the detached instance.
+ const unsigned afterActor=Count(recipient,sid),afterSource=Count(source,sid);
+ if(afterActor!=beforeActor+amount || beforeSource!=afterSource+amount) {
+  reason="transfer_postcondition_failed"; return false;
+ }
+ if(op.request.command==WorkResource && !ConfirmMineOutputTaken(op.agreement.id,amount)) {reason="mine_output_credit_unconfirmed";return false;}
+ op.transferRecovery=false; op.detached=NULL; op.transferSource=NULL;
+ delivered_[op.agreement.id]=already+amount;
+ reason="exact_resource_transfer_verified"; return true;
+}
+bool NativeExecutor::Dispatch(const Agreement& a,const Request& r,const NativeDestination& dest,std::string& reason) {
+ if (!world_ || a.worldId!=worldId_ || now_>=a.expiresAt || r.id.empty() ||
+     r.agreementId!=a.id || r.actor!=a.actor || r.target!=dest.facts.serial ||
+     r.candidateId!=dest.facts.candidateId || r.resourceId!=a.resourceId ||
+     r.quantity>a.quantity || operations_.count(r.id)) { reason="invalid_scoped_request"; return false; }
+ for(std::map<std::string,Operation>::iterator it=operations_.begin();it!=operations_.end();++it)
+  if(it->second.request.actor==a.actor && it->second.cleanupRequired) { reason="previous_owned_order_not_released"; return false; }
+ Target current=dest.facts;
+ if(!policy_.Revalidate(a,r,current,reason)) return false;
+ if(current.serial!=r.target || current.candidateId!=r.candidateId ||
+   (a.kind!=ClearGroup && current.sourceId!=a.sourceId) || !current.visible || !current.reachable) {
+  reason="target_scope_or_reachability_changed"; return false;
+ }
+ Operation op; op.agreement=a; op.request=r; op.destination=dest; op.destination.facts=current;
+ try {
+  Character* actor=KenshiAi::ResolveCharacter(world_,a.actor);
+  if(!AliveActor(actor,a.actor)) { reason="actor_unavailable"; return false; }
+  op.actorIdentity=actor->getHandle();
+  OrdersReceiver* orders=actor->getOrdersReciever();
+  if(!orders || orders->hasPlayerOrders() || !orders->orders.list.empty()) { reason="existing_order"; return false; }
+  Character* target=NULL; Building* resource=NULL;
+  if(a.kind==Mine) {
+   resource=policy_.ResolveResource(a,r.target);
+   if(!resource || resource->getHandle().serial!=r.target || !resource->getGameData() ||
+      resource->getGameData()->stringID!=a.sourceId) { reason="resource_identity_changed"; return false; }
+  } else {
+   target=KenshiAi::ResolveCharacter(world_,r.target);
+   if(!target || target==actor || target->getHandle().serial!=r.target || target->isPlayerCharacter()) {
+    reason="target_identity_or_protection"; return false;
+   }
+   if(a.kind==Hunt && (!target->isAnimal() ||
+      !(current.legalHunt || (r.command!=Attack && current.lootPermitted && current.harvestable)) || !target->getGameData() ||
+      target->getGameData()->stringID!=a.sourceId)) { reason="not_legal_exact_hunt_source"; return false; }
+   if(a.kind==ClearGroup && (std::find(a.agreedTargets.begin(),a.agreedTargets.end(),r.target)==a.agreedTargets.end() ||
+      !actor->isEnemy(target,true))) { reason="not_agreed_current_hostile"; return false; }
+  }
+  op.targetIdentity=resource?resource->getHandle():target->getHandle();
+  if(r.command==TakeItem) {
+   if(a.kind!=Hunt || !current.lootPermitted || !current.harvestable ||
+      !(target->isDead() || target->isUnconcious()) ||
+      actor->getPosition().squaredDistance(target->getPosition())>225.0f) { reason="loot_not_permitted_or_out_of_range"; return false; }
+   operations_[r.id]=op; Operation& stored=operations_[r.id];
+   if(!Transfer(stored,target->getInventory(),reason)) { stored.receipt=Result(Receipt::Rejected,reason); return false; }
+   stored.receipt=Result(Receipt::Succeeded,reason); return true;
+  }
+  TaskType task=MOVE_CUS_ORDERED;
+  hand subject;
+  Ogre::Vector3 point(static_cast<float>(dest.x),static_cast<float>(dest.y),static_cast<float>(dest.z));
+  if(!_finite(dest.x)||!_finite(dest.y)||!_finite(dest.z)) { reason="invalid_trusted_point"; return false; }
+  if(r.command==Attack) {
+   if(a.kind==Mine || !target || target->isDead() || target->isUnconcious()) { reason="attack_target_not_active"; return false; }
+   // Policy must reject protected/tamed sources and any ceasefire. Never break one here.
+   task=UNPROVOKED_FOCUSED_MELEE_ATTACK; subject=target->getHandle(); point=target->getPosition();
+  } else if(r.command==WorkResource) {
+   if(a.kind!=Mine || !current.resourceUsable || !resource || resource->_NV_getSpecialFunction()!=BF_MINE_NATURAL ||
+      resource->_NV_isDestroyed() || resource->_NV_isBroken()) { reason="resource_not_usable_natural_mine"; return false; }
+   resource->forceValidUsageNodesValidation();
+   if(!resource->hasAnyGoodPositionMarkersLeft()) { reason="resource_occupied"; return false; }
+   operations_[r.id]=op;
+   if(!BeginMineLease(a.id,actor,resource,a.resourceId,reason))return false;
+   op.mineLease=true;operations_[r.id].mineLease=true;
+   Inventory* output=policy_.ResourceOutput(a,resource);
+   if(!output) { reason="verified_output_inventory_unavailable"; return false; }
+   op.outputBaseline=Count(output,a.resourceId);
+   task=OPERATE_MACHINERY; subject=resource->getHandle(); point=resource->getPosition();
+  } else if(r.command!=Travel) { reason="unsupported_activity_command"; return false; }
+  const int jobs=orders->getPermajobCount(); const bool enabled=orders->isJobsEnabled();
+  // Register before mutation so any exception retains an identifiable cleanup obligation.
+  op.owned.taskType=static_cast<int>(task); op.owned.subjectSerial=r.command==Travel?0:r.target;
+  op.owned.x=point.x; op.owned.y=point.y; op.owned.z=point.z;op.subjectIdentity=subject;
+  op.cleanupRequired=true;
+  operations_[r.id]=op; Operation& stored=operations_[r.id];
+  orders->addOrder(task,subject,point,false,false);
+  if(!CaptureOwned(actor,stored,true) || jobs!=orders->getPermajobCount() || enabled!=orders->isJobsEnabled()) {
+   reason="owned_order_or_jobs_unconfirmed"; stored.receipt=Result(Receipt::Rejected,reason); return false;
+  }
+  if(r.command==Attack) actor->attackTarget(target);
+  actor->reThinkCurrentAIAction();
+  reason="scoped_native_order_dispatched"; return true;
+ } catch (...) {
+  reason="native_dispatch_exception";
+  std::map<std::string,Operation>::iterator it=operations_.find(r.id);
+  if(it!=operations_.end()) {
+   it->second.receipt=Result(Receipt::Rejected,reason);
+   // addOrder may have mutated before throwing. Record the single order from
+   // this uninterrupted game-thread call; no unrelated existing order was allowed.
+   try {
+    Character* c=KenshiAi::ResolveCharacter(world_,a.actor);
+    if(c && !it->second.orderCaptured && it->second.cleanupRequired)CaptureOwned(c,it->second,true);
+   } catch (...) {}
+  }
+  return false;
+ }
+}
+Receipt NativeExecutor::Poll(const std::string& id) {
+ std::map<std::string,Operation>::iterator it=operations_.find(id);
+ if(it==operations_.end()) return Result(Receipt::Rejected,"unknown_request");
+ Operation& op=it->second;
+ if(op.receipt.status!=Receipt::Pending) return op.receipt;
+ try {
+  Character* actor=KenshiAi::ResolveCharacter(world_,op.request.actor);
+  Target current=op.destination.facts; std::string reason;
+  if(now_>=op.agreement.expiresAt || !AliveActor(actor,op.request.actor) || !SameHand(actor->getHandle(),op.actorIdentity) ||
+     !policy_.Revalidate(op.agreement,op.request,current,reason))
+   return op.receipt=Result(Receipt::Interrupted,reason.empty()?"agreement_or_actor_unavailable":reason);
+  OrdersReceiver* orders=actor->getOrdersReciever();
+  // Natural task completion can remove the order before this frame's poll.
+  if(op.request.command==Travel) {
+   Ogre::Vector3 end(static_cast<float>(op.destination.x),static_cast<float>(op.destination.y),static_cast<float>(op.destination.z));
+   if(actor->getPosition().squaredDistance(end)<=64.0f)
+    return op.receipt=Result(Receipt::Succeeded,"arrived_at_scoped_point");
+  }
+  if(op.request.command==Attack) {
+   Character* target=KenshiAi::ResolveCharacter(world_,op.request.target);
+   if(target && SameHand(target->getHandle(),op.targetIdentity) && (target->isDead() || target->isUnconcious()))
+    return op.receipt=Result(Receipt::Succeeded,"target_defeated");
+  }
+  if(!CaptureOwned(actor,op,false)) return op.receipt=Result(Receipt::Interrupted,"owned_order_changed_or_ended");
+  if(op.request.command==Travel) {
+   Ogre::Vector3 p(static_cast<float>(op.destination.x),static_cast<float>(op.destination.y),static_cast<float>(op.destination.z));
+   if(actor->getPosition().squaredDistance(p)<=64.0f) return op.receipt=Result(Receipt::Succeeded,"arrived_at_scoped_point");
+   if(KenshiAi::CaptureCharacter(world_,op.request.actor).pathFailed) return op.receipt=Result(Receipt::Interrupted,"path_failed");
+  } else if(op.request.command==Attack) {
+   Character* target=KenshiAi::ResolveCharacter(world_,op.request.target);
+   if(!target || !SameHand(target->getHandle(),op.targetIdentity)) return op.receipt=Result(Receipt::Interrupted,"target_unloaded");
+   if(target->isDead() || target->isUnconcious()) return op.receipt=Result(Receipt::Succeeded,"target_defeated");
+   if(op.agreement.kind==ClearGroup && !actor->isEnemy(target,true)) return op.receipt=Result(Receipt::Interrupted,"target_no_longer_hostile");
+   if(op.agreement.kind==Hunt && !current.legalHunt) return op.receipt=Result(Receipt::Interrupted,"hunt_no_longer_legal");
+  } else if(op.request.command==WorkResource) {
+   Building* b=policy_.ResolveResource(op.agreement,op.request.target);
+   if(!b || b->getHandle().serial!=op.request.target || !current.resourceUsable ||
+      actor->getPosition().squaredDistance(b->getPosition())>225.0f) return op.receipt;
+   if(Transfer(op,policy_.ResourceOutput(op.agreement,b),reason)) {
+    if(Delivered(op.agreement.id)>=op.agreement.quantity) return op.receipt=Result(Receipt::Succeeded,reason);
+    return op.receipt;
+   }
+   if(reason!="awaiting_verified_output" && reason!="exact_resource_item_absent" && reason!="no_new_output")
+    return op.receipt=Result(Receipt::Interrupted,reason);
+  }
+ } catch (...) { return op.receipt=Result(Receipt::Interrupted,"native_poll_exception"); }
+ return op.receipt;
+}
+bool NativeExecutor::RecoverTransfer(Operation& op) {
+ if(!op.transferRecovery) return true;
+ try {
+  Character* actor=KenshiAi::ResolveCharacter(world_,op.request.actor);
+  if(!actor || !SameHand(actor->getHandle(),op.actorIdentity) || !actor->getInventory()) return false;
+  Inventory* source=NULL;
+  if(op.agreement.kind==Mine) {
+   Building* resource=policy_.ResolveResource(op.agreement,op.request.target);
+   if(resource && SameHand(resource->getHandle(),op.targetIdentity)) source=RetainedMineOutput(op.agreement.id,resource,actor);
+  } else {
+   Character* target=KenshiAi::ResolveCharacter(world_,op.request.target);
+   if(target && SameHand(target->getHandle(),op.targetIdentity)) source=target->getInventory();
+  }
+  // Never access a saved inventory pointer after its owning source unloads.
+  if(!source || source!=op.transferSource) return false;
+  const unsigned n=Count(source,op.agreement.resourceId),m=Count(actor->getInventory(),op.agreement.resourceId);
+  if(n+op.transferAmount==op.sourceBefore && m==op.recipientBefore+op.transferAmount) {
+   if(op.request.command==WorkResource && !ConfirmMineOutputTaken(op.agreement.id,op.transferAmount))return false;
+   delivered_[op.agreement.id]+=op.transferAmount; op.transferRecovery=false; op.detached=NULL; op.transferSource=NULL; return true;
+  }
+  if(n==op.sourceBefore && m==op.recipientBefore) { op.transferRecovery=false; op.detached=NULL; op.transferSource=NULL; return true; }
+  if(n+op.transferAmount!=op.sourceBefore || m!=op.recipientBefore) return false;
+  if(!op.detached) return false;
+  if(!source->addItem(op.detached,static_cast<int>(op.transferAmount),false,false)) return false;
+  op.detached=NULL;
+  if(Count(source,op.agreement.resourceId)!=op.sourceBefore) return false;
+  op.transferRecovery=false; op.transferSource=NULL; return true;
+ } catch (...) { return false; }
+}
+bool NativeExecutor::CancelOwned(const std::string& id) {
+ std::map<std::string,Operation>::iterator it=operations_.find(id);
+ if(it==operations_.end()) return true;
+ Operation& op=it->second;
+ if(op.agreement.worldId!=worldId_) { op.cleanupRequired=false; return true; }
+ // Stop owned activity before inventory recovery: an uncertain transfer must
+ // never keep a revoked mining/combat order running.
+ if(op.cleanupRequired) {
+  try {
+   Character* actor=KenshiAi::ResolveCharacter(world_,op.request.actor);
+   if(!actor || !SameHand(actor->getHandle(),op.actorIdentity))return false;
+   OrdersReceiver* orders=actor->getOrdersReciever();if(!orders)return false;
+   if(!orders->orders.list.empty()) {
+    // Validate actual task key, full subject, start timestamp and fixed travel
+    // destination before using the shared pointer/count cancellation helper.
+    if(!CaptureOwned(actor,op,false))return false;
+    std::string reason;
+    if(!Autonomy::TryCancelOwnedOrder(world_,op.request.actor,op.owned,reason))return false;
+    op.orderRemoved=true;
+   }
+   // Empty order queue alone is not proof: GOAP/body/movement may still run.
+   if(!NativeEnded(actor,op))return false;
+   op.cleanupRequired=false;
+  } catch (...) {return false;}
+  if(op.receipt.status==Receipt::Pending) op.receipt=Result(Receipt::Interrupted,"owned_native_activity_ended");
+ }
+ if(!RecoverTransfer(op))return false;
+ if(op.mineLease){EndMineLease(op.agreement.id);op.mineLease=false;}
+ return true;
+}
+} }
diff -ruN --binary a/legacy-v1/ActivityNativeExecutor.h b/legacy-v1/ActivityNativeExecutor.h
--- a/legacy-v1/ActivityNativeExecutor.h	1969-12-31 18:00:00.000000000 -0600
+++ b/legacy-v1/ActivityNativeExecutor.h	2026-10-15 15:43:16.850309043 -0500
@@ -0,0 +1,55 @@
+#pragma once
+#include "ActivityGoals.h"
+#include "AutonomyMonitor.h"
+#include <map>
+#include <kenshi/util/hand.h>
+class GameWorld;
+class Character;
+class Building;
+class Inventory;
+class Item;
+namespace Stobe { namespace ActivityV1Legacy {
+struct NativeDestination { Target facts; double x, y, z; NativeDestination(); };
+// Required trusted policy: checks current agreement authority, source identity,
+// actor-specific ownership/crime/protection/ceasefire and fresh target facts.
+// Called on the game thread immediately before dispatch and during polling.
+class NativePolicy {
+public:
+ virtual ~NativePolicy() {}
+ virtual bool Revalidate(const Agreement&, const Request&, Target&, std::string&) = 0;
+ virtual Building* ResolveResource(const Agreement&, unsigned int serial) = 0;
+ // Only an explicitly permitted production-output inventory, never inputs or
+ // arbitrary building storage. Must verify actor is the exclusive producer;
+ // shared production cannot be credited to this goal. Returning null fails closed.
+ virtual Inventory* ResourceOutput(const Agreement&, Building*) = 0;
+};
+class NativeExecutor {
+public:
+ explicit NativeExecutor(NativePolicy&);
+ void Bind(GameWorld*, const std::string& worldId, Clock now);
+ bool Observe(const Agreement&, Target&, Facts&);
+ bool Dispatch(const Agreement&, const Request&, const NativeDestination&, std::string&);
+ Receipt Poll(const std::string& requestId);
+ bool CancelOwned(const std::string& requestId);
+ unsigned int Delivered(const std::string& agreementId) const;
+private:
+ struct Operation {
+   Agreement agreement; Request request; NativeDestination destination;
+   Autonomy::OrderFingerprint owned; Receipt receipt;
+   bool cleanupRequired, mineLease, orderCaptured, orderRemoved; int orderStartTime;
+   hand actorIdentity, subjectIdentity, targetIdentity;
+   unsigned int outputBaseline;
+   bool transferRecovery; Item* detached; Inventory* transferSource;
+   unsigned int transferAmount, sourceBefore, recipientBefore;
+   Operation();
+ };
+ NativePolicy& policy_; GameWorld* world_; std::string worldId_; Clock now_;
+ std::map<std::string, Operation> operations_;
+ std::map<std::string, unsigned int> delivered_;
+ bool Transfer(Operation&, Inventory*, std::string&);
+ bool RecoverTransfer(Operation&);
+ bool CaptureOwned(Character*, Operation&, bool initial);
+ bool NativeEnded(Character*, const Operation&);
+};
+} }
+
diff -ruN --binary a/legacy-v1/ActivityPolicySupport.cpp b/legacy-v1/ActivityPolicySupport.cpp
--- a/legacy-v1/ActivityPolicySupport.cpp	1969-12-31 18:00:00.000000000 -0600
+++ b/legacy-v1/ActivityPolicySupport.cpp	2026-10-15 15:43:16.880446243 -0500
@@ -0,0 +1,248 @@
+#include "ActivityPolicySupport.h"
+#include "Functions.h"
+#include "KenshiBuildingCompat.h"
+#include <core/Functions.h>
+#include <kenshi/Character.h>
+#include <kenshi/GameData.h>
+#include <kenshi/Inventory.h>
+#include <kenshi/Item.h>
+#include <kenshi/Faction.h>
+#include <kenshi/Platoon.h>
+#include <map>
+#include <algorithm>
+#include <float.h>
+#include <limits>
+namespace Stobe { namespace ActivityV1Legacy {
+namespace {
+bool HasRef(GameData* data,const char* list,const std::string& sid) {
+ const Ogre::vector<GameDataReference>::type* refs=data ? data->getReferenceListIfExists(list):NULL;
+ if(!refs) return false;
+ for(size_t i=0;i<refs->size();++i) if((*refs)[i].sid==sid) return true;
+ return false;
+}
+bool ProvenWild(Character* target) {
+ Faction* faction=target->getFaction();
+ ActivePlatoon* active=target->getPlatoon();
+ if(!faction || !faction->data || !faction->isNotARealFaction() ||
+    faction->fundamentalNPCType!=OT_NONE || !active || !active->isAnimalsOnly ||
+    active->getIsTrader() || !active->me) return false;
+ Platoon* squad=active->me;
+ const Ownerships& owned=squad->ownerships;
+ if(squad->getSquadType()!=SQ_ROAMING || squad->myBaseHomeTownData ||
+    owned._homeTown || owned._homeBuilding.serial || owned.occupiedTown ||
+    !owned.slaves.empty() || owned.stuff.size() || !squad->squadTemplate ||
+    !target->getGameData()) return false;
+ // Require both species membership and current faction to match explicit loaded
+ // squad-template provenance. A purchased/recruited animal no longer qualifies.
+ // Missing/inherited or mod-ambiguous faction provenance is deliberately refused.
+ return HasRef(squad->squadTemplate,"faction",faction->data->stringID) &&
+  (HasRef(squad->squadTemplate,"animals",target->getGameData()->stringID) ||
+   HasRef(squad->squadTemplate,"animals2",target->getGameData()->stringID));
+}
+struct MineLease {
+ std::string id,item;
+ Building* building; Character* actor;
+ unsigned buildingSerial,actorSerial;
+ Inventory* inventory; InventorySection* section;
+ unsigned expected,credit;
+ bool valid,firstEmission,contribution;
+ MineLease():building(NULL),actor(NULL),buildingSerial(0),actorSerial(0),inventory(NULL),section(NULL),
+ expected(0),credit(0),valid(true),firstEmission(true),contribution(false) {}
+};
+std::map<std::string,MineLease> leases;
+typedef void (__fastcall *OperateFn)(ProductionBuilding*,Character*,float);
+typedef void (__fastcall *OutputFn)(ProductionBuilding*,float);
+OperateFn originalOperate=NULL;
+OutputFn originalOutput=NULL;
+bool hookAttempted=false, hooksReady=false;
+
+InventorySection* ExactSection(Building* b,const std::string& item) {
+ if(!b || static_cast<int>(b->_NV_getSpecialFunction())!=27 ||
+    b->_NV_isDestroyed() || !b->_NV_getProductionBuilding()) return NULL;
+ StorageBuilding::ConsumptionItem* product=b->_NV_getProductionBuilding()->getProductionItem();
+ if(!product || !product->item || product->item->stringID!=item || !product->inventorySection) return NULL;
+ InventorySection* out=product->inventorySection;
+ Inventory* inventory=b->getInventory();
+ if(!inventory || out->getInventory()!=inventory) return NULL;
+ // Executor uses inventory-level detach; allow that only when EVERY stored item
+ // belongs to this exact output section. Inputs or unrelated storage fail closed.
+ const lektor<Item*>& all=inventory->getAllItems();
+ for(unsigned i=0;i<all.size();++i)
+  if(!all.stuff[i] || !all.stuff[i]->data || all.stuff[i]->data->stringID!=item ||
+     !out->hasItem(all.stuff[i])) return NULL;
+ return out;
+}
+unsigned Count(InventorySection* section) {
+ unsigned total=0;
+ const Ogre::vector<InventorySection::SectionItem>::type& items=section->getItems();
+ for(size_t i=0;i<items.size();++i) {
+  if(!items[i].item) continue;
+  const unsigned q=static_cast<unsigned>(std::max(1,items[i].item->quantity));
+  if(total>std::numeric_limits<unsigned>::max()-q) throw 0;
+  total+=q;
+ }
+ return total;
+}
+bool Identity(MineLease& l) {
+ return l.actor && l.building && l.actor->getHandle().serial==l.actorSerial &&
+ l.building->getHandle().serial==l.buildingSerial &&
+ ExactSection(l.building,l.item)==l.section && l.section->getInventory()==l.inventory;
+}
+bool Check(MineLease& l) {
+ if(!l.valid) return false;
+ if(!Identity(l) || Count(l.section)!=l.expected) {l.valid=false;return false;}
+ return true;
+}
+void __fastcall Operate(ProductionBuilding* b,Character* actor,float amount) {
+ // Observe all contributors; never change native work or unrelated buildings.
+ try {
+  for(std::map<std::string,MineLease>::iterator i=leases.begin();i!=leases.end();++i) {
+   MineLease& l=i->second;
+   if(l.building!=b || !l.valid) continue;
+   if(!Check(l) || !actor || actor!=l.actor || actor->getHandle().serial!=l.actorSerial ||
+      !_finite(amount) || amount<0) {l.valid=false;continue;}
+   if(amount>0) l.contribution=true;
+  }
+ } catch(...) {
+  for(std::map<std::string,MineLease>::iterator i=leases.begin();i!=leases.end();++i)
+   if(i->second.building==b) i->second.valid=false;
+ }
+ originalOperate(b,actor,amount);
+}
+void __fastcall Output(ProductionBuilding* b,float amount) {
+ // Check before native output so an external deposit cannot masquerade as output.
+ try {
+  for(std::map<std::string,MineLease>::iterator i=leases.begin();i!=leases.end();++i)
+   if(i->second.building==b && i->second.valid) Check(i->second);
+ } catch(...) {
+  for(std::map<std::string,MineLease>::iterator i=leases.begin();i!=leases.end();++i)
+   if(i->second.building==b) i->second.valid=false;
+ }
+ originalOutput(b,amount);
+ try {
+  for(std::map<std::string,MineLease>::iterator i=leases.begin();i!=leases.end();++i) {
+   MineLease& l=i->second;
+   if(l.building!=b || !l.valid) continue;
+   if(!Identity(l)) {l.valid=false;continue;}
+   const unsigned now=Count(l.section);
+   if(now<l.expected) {l.valid=false;continue;}
+   const unsigned emitted=now-l.expected;
+   if(emitted) {
+    // Whole first output event may include work accumulated before the lease.
+    // It is deliberately never credited, even when the output was initially empty.
+    if(!l.firstEmission && l.contribution && _finite(amount) && amount>0) {
+     if(l.credit>std::numeric_limits<unsigned>::max()-emitted) l.valid=false;
+     else l.credit+=emitted;
+    }
+    l.firstEmission=false; l.contribution=false;
+   }
+   l.expected=now;
+  }
+ } catch(...) {
+  for(std::map<std::string,MineLease>::iterator i=leases.begin();i!=leases.end();++i)
+   if(i->second.building==b) i->second.valid=false;
+ }
+}
+bool Install() {
+ if(hookAttempted) return hooksReady;
+ hookAttempted=true;
+ const bool op=KenshiLib::AddHook((void*)KenshiLib::GetRealAddress(&ProductionBuilding::_NV_operate),
+  (void*)Operate,(void**)&originalOperate)==KenshiLib::SUCCESS;
+ const bool out=KenshiLib::AddHook((void*)KenshiLib::GetRealAddress(&ProductionBuilding::_NV_updateOutput),
+  (void*)Output,(void**)&originalOutput)==KenshiLib::SUCCESS;
+ hooksReady=op && out; return hooksReady;
+}
+}
+bool IsProtectedActivityTarget(Character* actor,Character* target,std::string& reason) {
+ if(!actor || !target || actor==target) {reason="target_identity_unavailable";return true;}
+ try {
+  if(target->isPlayerCharacter() || actor->getFaction()==target->getFaction() ||
+     actor->isAlly(target,true) || target->isAlly(actor,true)) {reason="player_same_faction_or_ally";return true;}
+  if(ShouldSuppressFactionCeasefireAttack(actor,target) || HasActivePersonalTruce(actor,target)) {
+   reason="active_ceasefire";return true;
+  }
+  if(target->getMySlaveOwner().serial) {reason="owned_target";return true;}
+  if(target->isAnimal()) {
+   if(!ProvenWild(target)) {reason="animal_ownership_not_proven_wild";return true;}
+   reason.clear();return false;
+  }
+  if(!actor->isEnemy(target,true)) {reason="non_hostile_target";return true;}
+  reason.clear();return false;
+ } catch(...) {reason="target_protection_unavailable";return true;}
+}
+bool BeginMineLease(const std::string& id,Character* actor,Building* b,const std::string& item,std::string& reason) {
+ if(id.empty() || !actor || !b || item.empty()) {reason="invalid_mine_lease";return false;}
+ try {
+  std::map<std::string,MineLease>::iterator found=leases.find(id);
+  if(found!=leases.end()) {
+   MineLease& l=found->second;
+   if(l.actor==actor && l.building==b && l.item==item && Check(l)) return true;
+   reason="mine_lease_identity_or_contribution_changed";return false;
+  }
+  for(std::map<std::string,MineLease>::iterator i=leases.begin();i!=leases.end();++i)
+   if(i->second.building==b || i->second.actor==actor) {reason="conflicting_mine_lease";return false;}
+  std::string resolvedItem;
+  if(!MineSourcePermitted(b,actor,resolvedItem,reason) || resolvedItem!=item) {
+   if(reason.empty()) reason="resource_identity_changed";return false;
+  }
+  InventorySection* section=ExactSection(b,item);
+  if(!section || !Install()) {reason="exact_output_or_observer_unavailable";return false;}
+  MineLease l; l.id=id;l.actor=actor;l.building=b;l.item=item;
+  l.actorSerial=actor->getHandle().serial;l.buildingSerial=b->getHandle().serial;
+  l.section=section;l.inventory=section->getInventory();l.expected=Count(section);
+  leases[id]=l;reason.clear();return true;
+ } catch(...) {reason="mine_lease_unavailable";return false;}
+}
+void EndMineLease(const std::string& id) {leases.erase(id);}
+void ResetMineLeases() {leases.clear();}
+unsigned MineOutputCredit(const std::string& id) {
+ try {std::map<std::string,MineLease>::iterator i=leases.find(id);
+ return i!=leases.end() && Check(i->second) ? i->second.credit:0;} catch(...) {return 0;}
+}
+bool ConfirmMineOutputTaken(const std::string& id,unsigned amount) {
+ try {
+  std::map<std::string,MineLease>::iterator i=leases.find(id);if(i==leases.end()) return false;
+  MineLease& l=i->second;
+  if(!l.valid || !Identity(l) || !amount || amount>l.credit || amount>l.expected ||
+     Count(l.section)!=l.expected-amount) {l.valid=false;return false;}
+  l.expected-=amount;l.credit-=amount;return true;
+ } catch(...) {return false;}
+}
+Inventory* NaturalResourceOutput(Building* b,Character* actor,const std::string& item,bool exclusive,std::string& reason) {
+ try {
+  for(std::map<std::string,MineLease>::iterator i=leases.begin();i!=leases.end();++i) {
+   MineLease& l=i->second;
+   if(l.building==b && l.actor==actor && l.item==item && exclusive && Check(l)) {
+    reason.clear();return l.inventory;
+   }
+  }
+ } catch(...) {}
+ reason="exclusive_output_lease_unavailable";return NULL;
+}
+Inventory* RetainedMineOutput(const std::string& id,Building* b,Character* actor) {
+ try {
+  std::map<std::string,MineLease>::iterator i=leases.find(id);
+  if(i!=leases.end() && i->second.building==b && i->second.actor==actor && Identity(i->second)) return i->second.inventory;
+ } catch(...) {}
+ return NULL;
+}
+} }
+namespace Stobe { namespace ActivityV1Legacy {
+bool MineSourcePermitted(Building* b,Character* actor,std::string& item,std::string& reason) {
+ item.clear();
+ try {
+  if(!b || !actor || actor->isDead() || actor->isUnconcious() ||
+     static_cast<int>(b->_NV_getSpecialFunction())!=27 || b->_NV_isDestroyed()) {
+   reason="natural_source_unavailable";return false;
+  }
+  if(b->getFaction() && b->getFaction()!=actor->getFaction()) {
+   reason="resource_owned_by_other_faction";return false;
+  }
+  ProductionBuilding* production=b->_NV_getProductionBuilding();
+  StorageBuilding::ConsumptionItem* product=production ? production->getProductionItem():NULL;
+  if(!product || !product->item || product->item->stringID.empty() ||
+     !ExactSection(b,product->item->stringID)) {reason="exact_output_unavailable";return false;}
+  item=product->item->stringID;reason.clear();return true;
+ } catch(...) {reason="resource_facts_unavailable";return false;}
+}
+} }
diff -ruN --binary a/legacy-v1/ActivityPolicySupport.h b/legacy-v1/ActivityPolicySupport.h
--- a/legacy-v1/ActivityPolicySupport.h	1969-12-31 18:00:00.000000000 -0600
+++ b/legacy-v1/ActivityPolicySupport.h	2026-10-15 15:43:16.877674843 -0500
@@ -0,0 +1,24 @@
+#pragma once
+#include <string>
+class Character;
+class Building;
+class Inventory;
+namespace Stobe { namespace ActivityV1Legacy {
+// All calls are game-thread only. True includes uncertain protection.
+bool IsProtectedActivityTarget(Character*, Character*, std::string& reason);
+bool BeginMineLease(const std::string& agreement, Character*, Building*,
+                    const std::string& itemSid, std::string& reason);
+void EndMineLease(const std::string& agreement);
+void ResetMineLeases();
+unsigned MineOutputCredit(const std::string& agreement);
+bool ConfirmMineOutputTaken(const std::string& agreement, unsigned amount);
+Inventory* NaturalResourceOutput(Building*, Character*, const std::string& itemSid,
+                                 bool requireExclusive, std::string& reason);
+// Recovery only. Caller must first resolve original actor/building identity in
+// original world. This verifies retained original section/inventory, without
+// granting new work after cancellation or producer contamination.
+Inventory* RetainedMineOutput(const std::string& agreement, Building*, Character*);
+} }
+namespace Stobe { namespace ActivityV1Legacy {
+bool MineSourcePermitted(Building*, Character*, std::string& resourceId, std::string& reason);
+} }
