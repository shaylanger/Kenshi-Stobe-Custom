+bool InspectMineLease(const std::string& id,Character* expectedActor,Building* expectedBuilding,MineLeaseSnapshot& out) {
+ out=MineLeaseSnapshot();
+ try {
+  std::map<std::string,MineLease>::const_iterator i=leases.find(id);
