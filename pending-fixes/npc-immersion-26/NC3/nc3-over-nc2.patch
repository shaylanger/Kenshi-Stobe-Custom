+bool RegisterCharacterHandle(Character *character, unsigned int expectedSerial) {
+  if (!expectedSerial || !IsValidCharacter(character)) {
+    return false;
+  }
+  try {
+    const hand runtimeHandle = character->getHandle();
+    if (runtimeHandle.serial != expectedSerial || runtimeHandle.isNull() ||
+        !runtimeHandle.isValid()) {
+      return false;
+    }
+    g_characterHandles[expectedSerial] = runtimeHandle;
+    return true;
+  } catch (...) {
+    return false;
+  }
+}
