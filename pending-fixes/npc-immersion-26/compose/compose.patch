+    $socialRepairEvalMeta = $socialRepairFinalMeta;
+}
+
+if (isset($deferredRelationshipEval)) {
+    try {
+        stobeEvaluateRelationshipsForTurn($targetNpc, $replyTarget, $deferredRelationshipEval[0], $deferredRelationshipEval[1], $npcData, 'chat', $socialRepairEvalMeta);
