     updated_at TIMESTAMP NOT NULL DEFAULT NOW()
 );
 
+
+-- IMM26 WP-C1 item 2: stated or voiced NPC principles (derived from the profile text, never destructive).
+-- Also created lazily by lib/imm26_c1_principles.php.
+CREATE TABLE IF NOT EXISTS imm26_npc_principle (
+    id BIGSERIAL PRIMARY KEY,
+    npc_key TEXT NOT NULL,
+    npc_name TEXT NOT NULL DEFAULT '',
+    topic TEXT NOT NULL,
+    stance TEXT NOT NULL,
+    strength TEXT NOT NULL DEFAULT 'flexible',
+    source TEXT NOT NULL,
+    evidence TEXT NOT NULL DEFAULT '',
+    profile_hash TEXT NOT NULL DEFAULT '',
+    first_gamets BIGINT NOT NULL DEFAULT 0,
+    voiced_gamets BIGINT NOT NULL DEFAULT 0,
+    gate_count INT NOT NULL DEFAULT 0,
+    last_gate_gamets BIGINT NOT NULL DEFAULT 0,
+    updated_at TIMESTAMP NOT NULL DEFAULT NOW(),
+    UNIQUE (npc_key, topic)
+);
