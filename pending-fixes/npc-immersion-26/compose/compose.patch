+        if (($offered['id'] ?? null) !== ($observed['id'] ?? null)
+            || intval($offered['actor_serial'] ?? 0) !== intval($observed['actor_serial'] ?? 0)) return false;
+    } elseif (($offered['source'] ?? '') !== 'visited_location') {
+        return false;
+    }
+    foreach (['x','y','z'] as $axis) {
+        if (!is_numeric($offered[$axis] ?? null) || !is_numeric($observed[$axis] ?? null)
+            || !is_finite(floatval($offered[$axis])) || !is_finite(floatval($observed[$axis]))
+            || floatval($offered[$axis]) !== floatval($observed[$axis])) return false;
+    }
+    return true;
