--- a/lib/activity/ActivityEvents.php	1969-12-31 18:00:00.000000000 -0600
+++ b/lib/activity/ActivityEvents.php	2026-10-15 13:31:32.184882020 -0500
@@ -0,0 +1,84 @@
+<?php
+declare(strict_types=1);
+/**
+ * Signed in-progress activity events (imm26 items 22 and 26).
+ * The native side reports WHAT it observed (structured fields). The server composes the sentence the NPC may
+ * say, so no free text from the game or the model ever becomes an instruction. Fail closed on anything unknown.
+ *
+ * Native contract (operation "event", same HMAC envelope as report/poll):
+ *   {"operation":"event","context":{"worldId","actor","requester","now"},"agreementId":"...",
+ *    "event":{"id":"<[A-Za-z0-9:_-]{1,64}, unique per occurrence>","kind":"threat|injury|progress|phase|arrival|handback",
+ *      threat:   "subject":"<hostile name>","distance":<units, optional>
+ *      injury:   "who":"actor|requester","healthPercent":0..100
+ *      progress: "delivered":n,"quantity":n,"resource":"<name>"   (quantity/resource optional)
+ *      phase:    "phase":"searching|travelling|performing|verifying|returning"
+ *      arrival:  "place":"<name, optional>"
+ *      handback: "resource":"<name>","count":n,"toRequester":true  (reward handed to the player)}}
+ */
+function stobeActivityEventText(mixed $value,int $max=48): string {
+    $text=preg_replace('/[^\p{L}\p{N} \'\-.,]/u','',strval($value));
+    $text=trim(preg_replace('/\s+/u',' ',strval($text)));
+    return mb_substr($text,0,$max);
+}
+
+/** Returns ['event_id','activity_id','kind','fact'] ready for stobeSituatedRecordEvent. Throws on any problem. */
+function stobeActivityEventNormalize(array $record,mixed $event,array $context): array {
+    if (!is_array($event)) throw new InvalidArgumentException('Missing event');
+    $agreement=$record['agreement']??[];
+    foreach (['worldId','actor','requester'] as $key) {
+        if (($agreement[$key]??null)!==($context[$key]??null)) throw new RuntimeException('Event identity mismatch');
+    }
+    if (($record['status']??'')!=='accepted') throw new RuntimeException('Event for an agreement that is not running');
+    if (!is_int($context['now']??null) || $context['now']<=0) throw new InvalidArgumentException('Missing native game clock');
+    $id=strval($event['id']??'');
+    if (!preg_match('/\A[A-Za-z0-9:_-]{1,64}\z/D',$id)) throw new InvalidArgumentException('Invalid event id');
+    $kindLabel=strtolower(stobeActivityEventText($agreement['kind']??'activity',24));
+    $verb=['hunt'=>'hunt','mine'=>'mining','cleargroup'=>'camp-clearing','gather'=>'gathering','scout'=>'scouting','escort'=>'escort'][$kindLabel]??$kindLabel;
+    $kind=strval($event['kind']??'');
+    $fact='';$mapped='';
+    switch ($kind) {
+        case 'threat':
+            $subject=stobeActivityEventText($event['subject']??'');
+            $distance=isset($event['distance'])&&is_numeric($event['distance'])?intval($event['distance']):-1;
+            $fact='A hostile '.($subject!==''?$subject:'creature or enemy').' has been spotted'
+                .($distance>=0&&$distance<=2000?' about '.max(1,intval(round($distance/10))).' m away':' nearby')
+                .' during the shared '.$verb.' activity.';
+            $mapped='threat';break;
+        case 'injury':
+            $who=strval($event['who']??'');
+            $pct=$event['healthPercent']??null;
+            if (!in_array($who,['actor','requester'],true) || !is_int($pct)&&!is_float($pct) || $pct<0 || $pct>100) throw new InvalidArgumentException('Invalid injury event');
+            $level=$pct<=25?'badly hurt':($pct<=60?'hurt':'slightly hurt');
+            $fact=($who==='actor'?'You have been wounded and are now '.$level:'Your activity partner has been wounded and looks '.$level)
+                .' (health about '.intval(round($pct)).'%) during the shared '.$verb.' activity.';
+            $mapped='injury';break;
+        case 'progress':
+            $delivered=$event['delivered']??null;$quantity=$event['quantity']??null;
+            if (!is_int($delivered)||$delivered<0||$delivered>100000) throw new InvalidArgumentException('Invalid progress event');
