+}
+const P = ['Abn Victim'=>[701,'Blue',false], 'Abn Partner'=>[702,'Blue',false], 'Abn Victim Two'=>[703,'Blue',false], 'Abn Victim Three'=>[704,'Blue',false],
+    'Abn Victim Four'=>[705,'Blue',false], 'Abn Lender'=>[706,'Blue',false], 'Abn Lender Two'=>[707,'Blue',false], 'Abn Player'=>[710,'Nameless',true],
+    'Abn Victim Five'=>[708,'Blue',false], 'Abn Victim Six'=>[709,'Blue',false]];
+foreach (['social_event_inbox','social_incident','social_belief','social_effect','social_evidence','social_checkpoint'] as $t) sql("DELETE FROM $t");
