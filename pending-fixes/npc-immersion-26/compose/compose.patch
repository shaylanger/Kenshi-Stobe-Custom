+
+// Registration/revocation metadata is deterministic, after spoken output and saved baselines.
+// It bypasses ordinary speech formatting only through the repair agreement queue owner.
+if (function_exists('stobeSocialRepairFlushAgreementTickets')) {
+    stobeSocialRepairFlushAgreementTickets();
+}
+
+if (function_exists('stobeTrainingCapture')) {
+    stobeTrainingCapture('chat_turn_final', [
