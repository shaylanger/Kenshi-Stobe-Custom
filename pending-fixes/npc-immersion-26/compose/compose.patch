+$grounded = 0;
+$routeFresh = true;
+$adapter = new ActivityAgreementAdapter(
+    static function(array $c, array $a, array $d) use (&$grounded, $camp): bool {
+        ++$grounded;
+        $campMatches = isset($a['campZone']) ? $a['campZone'] === $camp : (($a['scopeVersion'] ?? 1) === 1);
+        return $d === ['candidateId'=>'activity-candidate-1','targetSerial'=>303]
+            && ($a['kind'] ?? '') === 'ClearGroup' && $campMatches
+            && ($a['agreedTargets'] ?? []) === [303, 404];
+    },
+    static function(string $op, array $c, array $a): bool { return true; },
+    static function(string $op, array $c, array $record, $evidence): bool {
+        return $evidence === 'exact-displayed-consent' && $record['status'] === 'proposed';
+    }, true,
+    static function(array $c, string $id, ?array $expected) use (&$routeFresh, $route): ?array {
+        if (!$routeFresh || $id !== $route['candidateId']) { return null; }
+        return $route;
+    }
+);
+$context = ['worldId'=>'world-test-1','actor'=>101,'requester'=>202,'now'=>1000];
+$intent = ['kind'=>'ClearGroup','sourceId'=>'camp-threats','resourceId'=>'','quantity'=>0,
