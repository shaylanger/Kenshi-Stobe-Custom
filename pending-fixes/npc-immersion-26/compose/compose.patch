+        $verb='(?:get|collect|'.preg_quote($info['verb'],'/').')';
+        if (preg_match('/\A'.$prefix."let(?:'s|s| us) ".$verb.' (?:some |the agreed )?'.preg_quote($name,'/').'\z/Du',$text)) return true;
+    }
