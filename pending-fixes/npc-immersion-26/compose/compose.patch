+            $fact=$delivered.(is_int($quantity)&&$quantity>0&&$quantity<=100000?' of '.$quantity:'').($resource!==''?' '.$resource:' item(s)')
+                .' secured so far in the shared '.$verb.' activity.';
+            $mapped='progress';break;
+        case 'phase':
+            $phase=strval($event['phase']??'');
+            $text=['searching'=>'You are searching for a suitable target.','travelling'=>'You are heading to the target.',
+                'performing'=>'You are now carrying out the '.$verb.' task.','verifying'=>'You are checking that the task worked out.',
+                'returning'=>'You are heading back to hand over the result.'][$phase]??'';
+            if ($text==='') throw new InvalidArgumentException('Invalid phase event');
+            $fact='Shared '.$verb.' activity update: '.$text;
+            $mapped='progress';break;
+        case 'arrival':
+            $place=stobeActivityEventText($event['place']??'');
+            $fact='You have reached '.($place!==''?$place:'the target area').' for the agreed '.$verb.' activity.';
+            $mapped='arrival';break;
+        case 'handback':
+            $count=$event['count']??null;
+            if (!is_int($count)||$count<1||$count>100000||($event['toRequester']??false)!==true) throw new InvalidArgumentException('Invalid handback event');
+            $resource=stobeActivityEventText($event['resource']??($agreement['resourceId']??''));
+            $fact='You handed '.$count.' '.($resource!==''?$resource:'item(s)').' from the shared '.$verb.' activity over to your partner.';
+            $mapped='progress';break;
+        default: throw new InvalidArgumentException('Unknown event kind');
+    }
+    return ['event_id'=>'activity:'.strval($agreement['id']??'').':ev:'.$id,'activity_id'=>strval($agreement['id']??''),
+        'kind'=>$mapped,'fact'=>$fact];
+}
