+check('identity mismatch rejected', throws(fn() => stobeActivityEventNormalize($record, ['id'=>'x','kind'=>'arrival'], ['actor'=>1] + $ctx)));
+check('not accepted rejected', throws(fn() => stobeActivityEventNormalize(['status'=>'completed'] + $record, ['id'=>'x','kind'=>'arrival'], $ctx)));
+check('handback needs requester flag', throws(fn() => stobeActivityEventNormalize($record, ['id'=>'x','kind'=>'handback','count'=>1], $ctx)));
