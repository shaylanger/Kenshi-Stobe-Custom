+try { $adapter->propose($context, $tampered); } catch (InvalidArgumentException $e) { $rejected = true; }
+expect($rejected, 'native object names cannot be substituted for opaque camp tokens');
+
+$routeFresh = false;
+$rejected = false;
+try { $adapter->accept($context, $proposal, 'exact-displayed-consent'); } catch (RuntimeException $e) { $rejected = true; }
+expect($rejected, 'acceptance fails closed if the exact route candidate is no longer grounded');
