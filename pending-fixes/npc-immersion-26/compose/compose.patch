+<?php
+// Row 13-d: a loan deal's RETURN_ITEM is measured against the NPC's inventory AFTER it lent the item.
+// STOBE_DB_NAME=stobe_test php tests/negotiation_return_item_baseline_regression.php
+require __DIR__ . '/../lib/bootstrap.php';
+$db = $GLOBALS['db'];
+$pass = 0; $fail = 0;
+function check(string $name, bool $ok, $detail = null): void {
+    global $pass, $fail;
+    if ($ok) { $pass++; echo "PASS $name\n"; } else { $fail++; echo "FAIL $name" . ($detail !== null ? ' :: ' . json_encode($detail) : '') . "\n"; }
+}
+$npc = 'RetBaseTestCind';
+$player = 'RetBaseTestShay';
+$db->exec("DELETE FROM core_npc_master WHERE name=$1", [$npc]);
+$db->exec(
+    "INSERT INTO core_npc_master (name, metadata, inventory, equipment, personality, blood, faction, created_at, updated_at)
+     VALUES ($1, '{}'::jsonb, $2, '', 'Calm.', '100/100', 'Test', NOW(), NOW())",
+    [$npc, 'Metal Junk x1 value 10']
+);
+$now = time();
+$give = ['kind'=>'GIVE_ITEM', 'by'=>'npc', 'item'=>'Metal Junk', 'quantity'=>1, 'status'=>'VERIFIED'];
+$ret = ['kind'=>'RETURN_ITEM', 'by'=>'player', 'item'=>'Metal Junk', 'quantity'=>1, 'status'=>'AWAITING_PLAYER',
+        'dispatched_unix'=>$now - 5, 'deadline_unix'=>$now + 600];
+// Baseline taken at accept: the NPC had 1 Metal Junk BEFORE lending; it now holds 0 after lending, then gets it back.
+$deal = ['contract_id'=>'ret-base-test', 'npc_name'=>$npc, 'player_name'=>$player, 'kind'=>'loan',
+         'baseline'=>['npc_inventory'=>['metal junk'=>1], 'at'=>$now - 60],
+         'term_state'=>[$give, $ret]];
+
+// Lent quantity helper.
+check('lent quantity counts the verified npc give', stobeNegLentQuantity($deal, 'Metal Junk') === 1);
+check('lent quantity ignores other items', stobeNegLentQuantity($deal, 'Bread') === 0);
+check('lent quantity ignores unverified give', stobeNegLentQuantity(['term_state'=>[['status'=>'DISPATCHED'] + $give]], 'Metal Junk') === 0);
+
+// Lent but NOT returned: the NPC holds 0 -> still waiting.
+$db->exec("UPDATE core_npc_master SET inventory='' WHERE name=$1", [$npc]);
+$r = stobeNegEvaluateTerm($ret, $deal, $player, $now);
+check('not returned yet stays AWAITING_PLAYER', ($r['status'] ?? '') === 'AWAITING_PLAYER', $r);
+
+// Returned: the NPC holds the Metal Junk again (delta vs the pre-loan baseline is 0, vs post-loan is 1).
+$db->exec("UPDATE core_npc_master SET inventory=$2 WHERE name=$1", [$npc, 'Metal Junk x1 value 10']);
+$r = stobeNegEvaluateTerm($ret, $deal, $player, $now);
+check('returned item VERIFIES the RETURN_ITEM', ($r['status'] ?? '') === 'VERIFIED', $r);
+
+// A plain GIVE_ITEM by the player (no npc lend) is unchanged: baseline 0 -> now 1 verifies, baseline 1 -> now 1 does not.
+$gp = ['kind'=>'GIVE_ITEM', 'by'=>'player', 'item'=>'Metal Junk', 'quantity'=>1, 'status'=>'AWAITING_PLAYER',
+       'dispatched_unix'=>$now - 5, 'deadline_unix'=>$now + 600];
+$d2 = $deal; $d2['term_state'] = [$gp];
+$r = stobeNegEvaluateTerm($gp, $d2, $player, $now);
+check('player GIVE_ITEM with pre-held item is not counted', ($r['status'] ?? '') === 'AWAITING_PLAYER', $r);
+$d2['baseline']['npc_inventory'] = [];
+$r = stobeNegEvaluateTerm($gp, $d2, $player, $now);
+check('player GIVE_ITEM with new item verifies', ($r['status'] ?? '') === 'VERIFIED', $r);
+
+$db->exec("DELETE FROM core_npc_master WHERE name=$1", [$npc]);
+echo "\n$pass passed, $fail failed\n";
+exit($fail > 0 ? 1 : 0);
