+    // stobe-tests runs non-social_* suites on stobe_test: re-run ourselves on the dedicated social DB.
+    putenv('STOBE_DB_NAME=stobe_social_phase1_test');
+    passthru(escapeshellarg(PHP_BINARY) . ' -r ' . escapeshellarg('require ' . var_export(__FILE__, true) . ';'), $rc);
