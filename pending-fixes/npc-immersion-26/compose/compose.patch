--- a/lib/activity/ActivityKinds.php	1969-12-31 18:00:00.000000000 -0600
+++ b/lib/activity/ActivityKinds.php	2026-10-15 13:28:47.595950572 -0500
@@ -0,0 +1,89 @@
+<?php
+declare(strict_types=1);
+/**
+ * Activity kind registry (imm26 items 25 and 26). One table decides, for every kind the server can agree to:
+ *   shape   collect = needs resourceId + quantity (Hunt, Mine, Gather)
+ *           targets = needs a fixed target set, no resource (ClearGroup)
+ *           place   = needs only the route destination, no resource/quantity/targets (Scout, Escort)
+ *   verb    offer wording ("to <verb> <qty> <resource> together"), gerund for status lines
+ *   accept  regex fragment for the natural acceptance grammar ("let's <accept>")
+ *   native  true when the installed DLL produces facts of this kind. Agreement is still gated on native facts of the SAME kind,
+ *           so a registry entry with native=false can never start anything: it fails closed until native supplies matching facts.
+ *   handback  the finished reward goes back to the requester (player) with a hand-over event
+ *   purposes  words in the player's request that map to the kind (data-driven purpose map, see stobeActivityKindForPurpose)
+ */
+function stobeActivityKinds(): array {
+    static $kinds = [
+        'Hunt' => ['shape'=>'collect','verb'=>'hunt for','gerund'=>'hunting','accept'=>'(?:go )?hunt(?:ing)?','native'=>true,'handback'=>true,
+            'purposes'=>['hunt','meat','food','game','skin','hide','leather']],
+        'Mine' => ['shape'=>'collect','verb'=>'mine','gerund'=>'mining','accept'=>'(?:go )?min(?:e|ing)','native'=>true,'handback'=>true,
+            'purposes'=>['mine','mining','ore','iron','copper','stone','coal','metal']],
+        'ClearGroup' => ['shape'=>'targets','verb'=>'clear out','gerund'=>'clearing','accept'=>'(?:go )?clear (?:that|the) group','native'=>true,'handback'=>false,
+            'purposes'=>['clear','camp','bandits','raiders','kill','fight','eliminate']],
+        'Gather' => ['shape'=>'collect','verb'=>'gather','gerund'=>'gathering','accept'=>'(?:go )?gather(?:ing)?','native'=>false,'handback'=>true,
+            'purposes'=>['gather','forage','plants','herbs','berries','wood','fiber']],
+        'Scout' => ['shape'=>'place','verb'=>'scout','gerund'=>'scouting','accept'=>'(?:go )?scout(?:ing)?(?: ahead)?','native'=>false,'handback'=>false,
+            'purposes'=>['scout','look around','explore','search the area','survey']],
+        'Escort' => ['shape'=>'place','verb'=>'escort you to','gerund'=>'escorting','accept'=>'(?:go )?(?:with you|escort)','native'=>false,'handback'=>false,
+            'purposes'=>['escort','guard me','protect me','bodyguard']],
+    ];
+    return $kinds;
+}
+
+function stobeActivityKindNames(): array { return array_keys(stobeActivityKinds()); }
+
+function stobeActivityKindInfo(string $kind): ?array { return stobeActivityKinds()[$kind] ?? null; }
+
+function stobeActivityKindShape(string $kind): string { return stobeActivityKinds()[$kind]['shape'] ?? ''; }
+
+/** Offer sentence for a proposal; the caller supplies grounded names (route label, resource name, quantity, target count). */
+function stobeActivityOfferText(string $kind,string $routeLabel,string $resource,int $quantity,int $targetCount,string $zone=''): string {
+    $info = stobeActivityKindInfo($kind);
+    if ($info === null) throw new InvalidArgumentException('Unsupported activity');
+    switch ($info['shape']) {
+        case 'targets':
+            $where = $zone !== '' ? ' at '.$zone : ' with that group';
+            return 'Shall we travel to '.$routeLabel.' and clear out the identified group'.$where.'? The agreement covers only the '.$targetCount.' enemies we have identified.';
+        case 'collect':
+            if ($resource === '') throw new RuntimeException('Missing grounded resource name');
+            return 'Shall we travel to '.$routeLabel.' to '.$info['verb'].' '.$quantity.' '.$resource.' together? Once we have collected that amount, the job is done'
+                .(!empty($info['handback']) && function_exists('stobeActivityHandbackEnabled') && stobeActivityHandbackEnabled() ? ', and I will hand it over to you.' : '.');
+        default:
+            return 'Shall we travel to '.$routeLabel.' and '.$info['verb'].' the area together? We will stop when the area has been covered, and I will tell you what I found.';
+    }
+}
+
+/**
+ * Data-driven purpose map: which kinds does a player request plausibly mean? Pure word matching (a ranking aid for the
+ * prompt and for tests, never consent): returns kinds ordered by number of matching purpose words, best first.
+ * Extra purposes can be added without code in /var/lib/stobe/activity-purposes.json: {"Hunt":["fish"],...}
+ */
+function stobeActivityKindForPurpose(string $request): array {
+    $text = ' '.mb_strtolower(preg_replace('/[^\p{L}\p{N} ]+/u',' ',$request)).' ';
+    $extra = [];
+    $file = '/var/lib/stobe/activity-purposes.json';
+    if (is_file($file)) {
+        $decoded = json_decode((string)file_get_contents($file), true);
+        if (is_array($decoded)) $extra = $decoded;
+    }
+    $scores = [];
+    foreach (stobeActivityKinds() as $kind => $info) {
+        $words = array_merge($info['purposes'], is_array($extra[$kind] ?? null) ? array_filter($extra[$kind], 'is_string') : []);
+        $score = 0;
+        foreach ($words as $word) if (str_contains($text, ' '.mb_strtolower($word).' ') || str_contains($text, ' '.mb_strtolower($word))) $score++;
+        if ($score > 0) $scores[$kind] = $score;
+    }
+    arsort($scores);
+    return array_keys($scores);
+}
+
+/** Compact line for the activity prompt: kinds the model may propose today (native-capable) and the others held back. */
+function stobeActivityKindPromptLine(): string {
+    $live = []; $held = [];
+    foreach (stobeActivityKinds() as $kind => $info) {
+        $entry = $kind.'('.$info['shape'].')';
+        if ($info['native']) $live[] = $entry; else $held[] = $entry;
+    }
+    return 'Activity kinds with native support now: '.implode(', ', $live).'. Kinds that need a matching observed source from the game and stay unavailable otherwise: '.implode(', ', $held).'. '
+        .'A kind is proposable only when the observed activity source list contains a source of that same kind.';
+}
