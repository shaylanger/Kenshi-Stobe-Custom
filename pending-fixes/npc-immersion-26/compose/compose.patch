+/** Stable identity for one concrete immutable travel offer. */
+function stobeTravelPlanHash(string $actor, string $speaker, string $purpose, string $leader, array $point): string {
+    $actorSerial = stobeTravelActorSerial($actor);
+    $speakerSerial = stobeResolveLiveParticipantSerial($speaker);
+    if ($actorSerial <= 0 || $speakerSerial <= 0 || !in_array($leader, ['npc','player'], true)
+        || !in_array($purpose, ['same_route','detour','guide','duel_meeting','truce_meeting','surrender_meeting'], true)) return '';
+    $source = $point['source'] ?? '';
+    $label = trim(strval($point['label'] ?? ''));
+    if (!in_array($source, ['native_local','visited_location'], true) || $label === '' || strlen($label) > 240
+        || preg_match('/[@|;\\r\\n]/', $label)) return '';
+    $destination = ['source'=>$source, 'label'=>$label];
+    if ($source === 'native_local') {
+        $id = strval($point['id'] ?? '');
+        $destinationActor = intval($point['actor_serial'] ?? 0);
+        if (!preg_match('/^[A-Za-z0-9_.:-]{1,96}$/D', $id) || $destinationActor <= 0 || $destinationActor !== $actorSerial) return '';
+        $destination['id'] = $id;
+        $destination['actor_serial'] = $destinationActor;
+    }
+    foreach (['x','y','z'] as $axis) {
+        if (!is_numeric($point[$axis] ?? null) || !is_finite(floatval($point[$axis]))
+            || abs(floatval($point[$axis])) > 10000000) return '';
+        $destination[$axis] = floatval($point[$axis]);
+    }
+    $canonical = ['actor_serial'=>$actorSerial, 'speaker_serial'=>$speakerSerial,
+        'purpose'=>$purpose, 'leader'=>$leader, 'destination'=>$destination];
+    $json = json_encode($canonical, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRESERVE_ZERO_FRACTION);
