+<?php
+declare(strict_types=1);
+/**
+ * WP-A item 16: a personality that stays itself.
+ *  - a small anchor (3 core traits + 2 verbal habits) derived once from the profile and stored in the NPC metadata
+ *    ('imm26_anchor'); it rides in every prompt, and the dynamic profile refresh may not drop a core trait;
+ *  - openness is a ladder set by trust and temperament, never by repeated asking;
+ *  - stock-phrase repetition is measured from the NPC's own recent replies and named back to the model.
+ * Deterministic and cheap: no LLM call.
+ */
+
+function imm26PhraseSplit(string $text, int $max, int $maxLen = 60, bool $skipBoilerplate = false): array
+{
+    $text = trim(preg_replace('/\s+/u', ' ', $text) ?? $text);
+    if ($text === '') return [];
+    $parts = preg_split('/\s*(?:[,;.:\n]|\band\b|\bbut\b)\s*/iu', $text) ?: [];
+    $out = [];
+    foreach ($parts as $part) {
+        $part = trim($part, " \t\"'()-");
+        if (mb_strlen($part) < 4) continue;
+        // imm26-batch5: generated profiles open with "this character ..."; a cut-off fragment of that never survives a rewrite.
+        if ($skipBoilerplate && preg_match('/\b(?:this character|this person)\b/iu', $part) === 1) continue;
+        $part = mb_substr($part, 0, $maxLen);
+        if (!in_array(mb_strtolower($part), array_map('mb_strtolower', $out), true)) $out[] = $part;
+        if (count($out) >= $max) break;
+    }
+    return $out;
+}
+
+/** Pure: the anchor a profile would get. [] when the profile has no usable personality text. */
+function imm26AnchorDerive(array $npc): array
+{
+    $personality = trim(strval($npc['personality'] ?? ''));
+    $traits = imm26PhraseSplit($personality, 3, 60, true) ?: imm26PhraseSplit($personality, 3);
+    if (!$traits) return [];
+    $ext = function_exists('normalizeCoreNpcExtendedData') ? normalizeCoreNpcExtendedData($npc['extended_data'] ?? []) : (is_array($npc['extended_data'] ?? null) ? $npc['extended_data'] : []);
+    $quirks = $ext['deep_identity']['habits_and_quirks'] ?? '';
+    if (is_array($quirks)) $quirks = implode('. ', array_map('strval', array_filter($quirks, 'is_scalar')));
+    $tics = imm26PhraseSplit(strval($quirks), 2, 70);
+    if (!$tics) $tics = imm26PhraseSplit(strval($npc['speechstyle'] ?? ''), 2, 70);
+    return ['v'=>2, 'traits'=>$traits, 'tics'=>$tics, 'src'=>sha1($personality)];
+}
+
+/** Does a text still carry a trait? Significant words (>= 4 letters), 5-letter stems, at least half must remain. */
+function imm26TraitSurvives(string $trait, string $text): bool
+{
+    $stem = static fn(string $w): string => mb_substr(mb_strtolower($w), 0, 5);
+    preg_match_all('/\p{L}{4,}/u', $trait, $m);
+    $words = array_values(array_unique(array_map($stem, $m[0])));
+    if (!$words) return true;
+    $hay = mb_strtolower($text);
+    $hit = 0;
+    foreach ($words as $w) if (str_contains($hay, $w)) $hit++;
+    return $hit * 2 >= count($words);
+}
+
+/** The stored anchor, created (or kept in step with a manual profile edit) on first use. */
+function imm26PersonalityAnchor(string $name, array $npc, bool $persist = true): array
+{
+    $meta = function_exists('normalizeCoreNpcMetadata') ? normalizeCoreNpcMetadata($npc['metadata'] ?? []) : [];
+    $stored = is_array($meta['imm26_anchor'] ?? null) ? $meta['imm26_anchor'] : [];
+    $personality = trim(strval($npc['personality'] ?? ''));
+    if ($personality === '') return $stored;
+    $hash = sha1($personality);
+    if ($stored && (int)($stored['v'] ?? 1) < 2) $stored = []; // v1 traits were boilerplate fragments: derive again
+    if ($stored && ($stored['src'] ?? '') === $hash) return $stored;
+    if ($stored) {
+        // The text changed. A refresh that kept every core trait only moves the hash; anything else is a deliberate edit.
+        $kept = true;
+        foreach ((array)($stored['traits'] ?? []) as $trait) if (!imm26TraitSurvives(strval($trait), $personality)) { $kept = false; break; }
+        $next = $kept ? ['src'=>$hash] + $stored : imm26AnchorDerive($npc);
+    } else {
+        $next = imm26AnchorDerive($npc);
+    }
+    if ($next && $persist && function_exists('stobePatchNpcMetadataByName')) {
+        try { stobePatchNpcMetadataByName($name, ['imm26_anchor'=>$next]); } catch (Throwable $e) { /* prompt still uses it this turn */ }
+    }
+    return $next;
+}
+
+/** Openness ladder: what this NPC shares with this person right now. */
+function imm26DisclosureLadder(int $aff): string
+{
+    if ($aff <= -6) return 'almost nothing personal; short, guarded answers';
+    if ($aff <= 5) return 'public facts and work talk only';
+    if ($aff <= 30) return 'opinions and everyday history, not fears or secrets';
+    if ($aff <= 55) return 'personal stories and ordinary worries';
+    if ($aff <= 75) return 'fears, hopes and private history, in your own time';
+    return 'your deepest history and secrets, if your temperament allows it';
+}
+
+/** The NPC's last replies, newest first. */
+function imm26RecentReplies(string $name, int $limit = 8): array
+{
+    try {
+        $rows = $GLOBALS['db']->fetchAll("SELECT data FROM eventlog WHERE type IN ('chat','rechat') AND data ILIKE $1 ORDER BY rowid DESC LIMIT " . max(1, min(20, $limit)),
+            [str_replace(['\\', '%', '_'], ['\\\\', '\\%', '\\_'], $name) . ':%']) ?: [];
+    } catch (Throwable $e) { return []; }
+    $out = [];
+    foreach ($rows as $row) {
+        $parsed = function_exists('parseDialogueEventData') ? parseDialogueEventData(strval($row['data'])) : ['speaker'=>$name, 'message'=>strval($row['data'])];
+        if (strcasecmp(strval($parsed['speaker'] ?? ''), $name) !== 0) continue;
+        $msg = trim(strval($parsed['message'] ?? ''));
+        if ($msg !== '') $out[] = $msg;
+    }
+    return $out;
+}
+
+/** Phrases (3-word runs) or openers that recur across the replies. Pure. */
+function imm26OverusedPhrases(array $replies, int $minReplies = 3, int $max = 3): array
+{
+    $words = static function (string $s): array {
+        preg_match_all("/[\\p{L}']+/u", mb_strtolower($s), $m);
+        return $m[0];
+    };
+    $seen = [];
+    $openers = [];
+    foreach (array_slice($replies, 0, 8) as $reply) {
+        $w = $words($reply);
+        $uniq = [];
+        for ($i = 0; $i + 2 < count($w); $i++) $uniq[implode(' ', array_slice($w, $i, 3))] = true;
+        foreach (array_keys($uniq) as $g) $seen[$g] = ($seen[$g] ?? 0) + 1;
+        if (count($w) >= 2) { $o = implode(' ', array_slice($w, 0, 2)); $openers[$o] = ($openers[$o] ?? 0) + 1; }
+    }
+    $stop = ['i', 'the', 'a', 'you', 'to', 'and', 'of', 'it', 'is', 'in', 'that', 'we', 'my', 'your', 'me', 'for', 'on', 'be', 'do', 'not', "i'm", "it's", 'with', 'this'];
+    $out = [];
+    arsort($seen);
+    foreach ($seen as $g => $n) {
+        if ($n < $minReplies) break;
+        $ws = explode(' ', (string)$g);
+        if (count(array_diff($ws, $stop)) < 2) continue;
+        foreach ($out as $kept) if (str_contains($kept, (string)$g) || str_contains((string)$g, $kept)) continue 2;
+        $out[] = (string)$g;
+        if (count($out) >= $max) return $out;
+    }
+    arsort($openers);
+    foreach ($openers as $o => $n) {
+        if ($n < $minReplies + 1 || count($out) >= $max) break;
+        if (count(array_diff(explode(' ', (string)$o), $stop)) < 1) continue;
+        $out[] = (string)$o . '...';
+    }
+    return $out;
+}
+
+/** Reader for stobeNpcConversationTail. */
+function imm26PersonalityAnchorContext(string $actor, array $npc, string $listener, int $gameTs = 0): string
+{
+    if (function_exists('getSettingBool') && !getSettingBool('IMM26_PERSONALITY_ANCHOR', true)) return '';
+    if (trim($actor) === '' || (function_exists('stobeIsNarratorName') && stobeIsNarratorName($actor))) return '';
+    $anchor = imm26PersonalityAnchor($actor, $npc);
+    $overused = imm26OverusedPhrases(imm26RecentReplies($actor));
+    if (!$anchor && !$overused) return '';
+    $lines = ['<personality_anchor>'];
+    if ($anchor) {
+        $entry = $listener !== '' && function_exists('stobeRelationshipEntryFor') ? stobeRelationshipEntryFor($npc, $listener) : null;
+        $aff = max(-100, min(100, intval($entry['aff'] ?? $entry['affinity'] ?? 0)));
+        $line = 'Stay recognisably yourself in every reply: ' . implode('; ', array_map('strval', $anchor['traits'] ?? [])) . '.';
+        if (!empty($anchor['tics'])) $line .= ' Habits of speech (use sparingly, never in every reply): ' . implode('; ', array_map('strval', $anchor['tics'])) . '.';
+        $lines[] = stobePromptXmlEscape($line);
+        $lines[] = 'What you share with ' . stobePromptXmlEscape($listener !== '' ? $listener : 'this person') . ' right now: ' . imm26DisclosureLadder($aff)
+            . '. Trust and your temperament set this, not repeated asking or flattery. Mood and circumstance change how you express your traits, never which traits you have.';
+    }
+    if ($overused) $lines[] = 'Your last replies leaned on: "' . stobePromptXmlEscape(implode('", "', $overused)) . '". Say it differently or leave it out; a distinct person does not repeat stock phrases.';
+    $lines[] = '</personality_anchor>';
+    return implode("\n", $lines);
+}
+
+/**
+ * Dynamic profile refresh guard: a generated personality that drops a core trait is rejected (the other generated fields
+ * still apply). Called with the normalised updates before they are returned to the writer.
+ */
+function imm26PersonalityGuardUpdates(string $npcName, array $npcData, array $updates): array
+{
+    try {
+        if (!isset($updates['personality']) || !getSettingBool('IMM26_PERSONALITY_ANCHOR', true)) return $updates;
+        $anchor = imm26PersonalityAnchor($npcName, $npcData); // creates it from the pre-refresh profile if missing
+        if (!is_array($anchor) || empty($anchor['traits'])) return $updates;
+        foreach ($anchor['traits'] as $trait) {
+            if (imm26TraitSurvives(strval($trait), strval($updates['personality']))) continue;
+            // imm26 16-c: the scheduler's writer requires every requested field (dps_save: Incomplete/Invalid generated profile), so a rejected
+            // personality keeps the CURRENT text instead of being dropped; the other generated fields then still apply.
+            $current = trim(strval($npcData['personality'] ?? ''));
+            if ($current !== '') $updates['personality'] = $current; else unset($updates['personality']);
+            if (function_exists('stobeLogInfo')) stobeLogInfo('Dynamic profile personality rejected: core trait dropped', ['npc'=>$npcName, 'trait'=>strval($trait)]);
+            break;
+        }
+    } catch (Throwable $e) { /* never block a refresh on the guard */ }
+    return $updates;
+}
diff -ruN -x log -x __pycache__ -x soundcache -x '*.orig' -x '*.rej' a/lib/imm26_plans.php b/lib/imm26_plans.php
--- a/lib/imm26_plans.php	1969-12-31 18:00:00.000000000 -0600
+++ b/lib/imm26_plans.php	2026-10-15 19:09:00.872564430 -0500
@@ -0,0 +1,277 @@
+<?php
+/** WP-D: negotiated alternatives (14), shared plans (19), natural plan changes (20),
+ * clear endings (23). Hooks live in travel_companionship.php / commitment_lifecycle.php.
+ * Nothing here grants consent or execution: it resolves wording, records origin,
+ * offers grounded alternatives through the normal PROPOSE record, and reports endings.
+ */
+
+function stobeImm26Norm(string $s): string {
+    $s = mb_strtolower($s);
+    $s = preg_replace('/[^\p{L}\p{N}]+/u', ' ', $s) ?? $s;
+    $s = preg_replace('/\b(the|a|an|to|of|at|in|near|outside)\b/u', ' ', $s) ?? $s;
+    return trim(preg_replace('/\s+/u', ' ', $s) ?? $s);
+}
+
+/** Map a loosely worded destination onto exactly one candidate id or known-place name.
+ * Unique matches only (ambiguous or unknown wording is returned unchanged). */
+function stobeImm26CanonicalDestination(string $actor, array|false $npc, string $requested): string {
+    $requested = trim($requested);
+    if ($requested === '' || !is_array($npc)) return $requested;
+    $pool = []; // norm => [canonical => true]
+    foreach (stobeTravelLocalCandidates($actor, $npc) as $id => $p) {
+        $pool[stobeImm26Norm(strval($p['label']))][strval($id)] = true;
+        $pool[stobeImm26Norm(strval($id))][strval($id)] = true;
+    }
+    foreach (stobeTravelKnownPlaceNames($actor, $npc) as $name) $pool[stobeImm26Norm(strval($name))][strval($name)] = true;
+    $needle = stobeImm26Norm($requested);
+    if ($needle === '') return $requested;
+    $hits = [];
+    foreach ($pool as $norm => $canon) {
+        $norm = strval($norm);
+        if ($norm === '') continue;
+        if ($norm === $needle) { $hits = $canon; break; }
+        if ((mb_strlen($norm) >= 4 && preg_match('/\b' . preg_quote($norm, '/') . '\b/u', $needle))
+            || (mb_strlen($needle) >= 4 && preg_match('/\b' . preg_quote($needle, '/') . '\b/u', $norm))) {
+            $hits += $canon;
+        }
+    }
+    return count($hits) === 1 ? strval(array_key_first($hits)) : $requested;
+}
+
+// ---- separate alternatives / postponed-ask record (never overwrites the agreement) ----
+function stobeImm26AltKey(string $actor, string $speaker): string {
+    $a = stobeResolveLiveParticipantSerial($actor,true);
+    $b = stobeResolveLiveParticipantSerial($speaker);
+    return $a > 0 && $b > 0 ? 'travel-alt-v1:' . $a . ':' . $b . ':' : '';
+}
+function stobeImm26AltRead(string $actor, string $speaker, int $gamets): ?array {
+    $key = stobeImm26AltKey($actor, $speaker);
+    if ($key === '' || $gamets <= 0 || !isset($GLOBALS['db'])) return null;
+    try {
+        $row = $GLOBALS['db']->fetchOne("SELECT data FROM eventlog WHERE type='travel_alternatives' AND gamets <= $2
+            AND LEFT(data,LENGTH($1))=$1 ORDER BY gamets DESC,rowid DESC LIMIT 1", [$key, $gamets]);
+        $rec = is_array($row) ? json_decode(substr(strval($row['data']), strlen($key)), true) : null;
+        return is_array($rec) ? $rec : null;
+    } catch (Throwable $e) { return null; }
+}
+function stobeImm26AltWrite(string $actor, string $speaker, int $gamets, array $rec): bool {
+    $key = stobeImm26AltKey($actor, $speaker);
+    $json = json_encode($rec, JSON_UNESCAPED_UNICODE);
+    if ($key === '' || $gamets <= 0 || !is_string($json)) return false;
+    try { return is_array(storeEvent('travel_alternatives', time(), $gamets, $key . $json, 'pending', '', '', false)); }
+    catch (Throwable $e) { return false; }
+}
+
+// ---- imm26 20-a: pending plan change (deferred confirm), kept in the alternatives record, never in the trip row ----
+function stobeImm26PendingChangeWrite(string $actor, string $speaker, int $gamets, array $offer, string $oldAgreementId): bool {
+    $alt = stobeImm26AltRead($actor, $speaker, $gamets) ?? [];
+    $alt['pending_change'] = ['offer'=>$offer, 'old_agreement_id'=>$oldAgreementId, 'gamets'=>$gamets];
+    return stobeImm26AltWrite($actor, $speaker, $gamets, $alt);
+}
+function stobeImm26PendingChangeClear(string $actor, string $speaker, int $gamets): void {
+    $alt = stobeImm26AltRead($actor, $speaker, $gamets);
+    if (!is_array($alt) || !isset($alt['pending_change'])) return;
+    unset($alt['pending_change']);
+    stobeImm26AltWrite($actor, $speaker, $gamets, $alt);
+}
+/** The pending offer when this ACCEPT turn confirms it (same destination, same accepted trip, fresh); else null. */
+function stobeImm26PendingChangeOffer(string $actor, string $speaker, int $gamets, array $accepted, string $destination, string $playerLine): ?array {
+    $alt = stobeImm26AltRead($actor, $speaker, $gamets);
+    $pc = is_array($alt) ? ($alt['pending_change'] ?? null) : null;
+    if (!is_array($pc) || !is_array($pc['offer'] ?? null)) return null;
+    $age = $gamets - intval($pc['gamets'] ?? 0);
+    if ($age < 0 || $age > 21600) return null;
+    if (strval($pc['old_agreement_id'] ?? '') === '' || strval($pc['old_agreement_id']) !== strval($accepted['agreement_id'] ?? '')) return null;
+    $offer = $pc['offer'];
+    $offered = strval($offer['destination'] ?? '');
+    if ($destination !== '') {
+        $offeredId = strval($offer['destination_point']['id'] ?? '');
+        if (strcasecmp($destination, $offered) !== 0 && ($offeredId === '' || strcasecmp($destination, $offeredId) !== 0)) return null;
+    } else {
+        // A bare yes confirms the change unless the line names the old destination.
+        $oldDest = strval($accepted['destination'] ?? '');
+        if ($oldDest !== '' && mb_stripos($playerLine, $oldDest) !== false) return null;
+    }
+    return $offer;
+}
+
+/** Grounded alternatives for a request that cannot be honoured: nearer observed
+ * candidates first (guide-only), then the NPC's own known places. Max 3. */
+function stobeImm26Alternatives(string $actor, array|false $npc, string $requested, string $preferred = ''): array {
+    $out = [];
+    $cands = stobeTravelLocalCandidates($actor, $npc);
+    uasort($cands, static fn($a, $b) => floatval($a['spatial']['distance'] ?? 1e12) <=> floatval($b['spatial']['distance'] ?? 1e12));
+    if ($preferred !== '' && isset($cands[$preferred])) $cands = [$preferred => $cands[$preferred]] + $cands;
+    foreach ($cands as $id => $p) {
+        if (stobeImm26Norm(strval($p['label'])) === stobeImm26Norm($requested)) continue;
+        $out[] = ['source'=>'native_local', 'id'=>strval($id), 'label'=>strval($p['label'])];
+        if (count($out) >= 3) return $out;
+    }
+    foreach (stobeTravelKnownPlaceNames($actor, $npc, 4) as $name) {
+        if (stobeImm26Norm(strval($name)) === stobeImm26Norm($requested)) continue;
+        $out[] = ['source'=>'known_place', 'id'=>strval($name), 'label'=>strval($name)];
+        if (count($out) >= 3) break;
+    }
+    return $out;
+}
+
+/** The request cannot be honoured: write ONE guide-only PROPOSED offer for the best
+ * alternative (unless a trip is already accepted) and return the spoken line, or ''. */
+function stobeImm26OfferAlternative(string $actor, array|false $npc, string $speaker, int $gamets, string $requested, ?array $old, string $preferred): string {
+    if (($old['status'] ?? '') === 'ACCEPTED' || trim($requested) === '' || !is_array($npc)) return '';
+    $locals = stobeTravelLocalCandidates($actor, $npc);
+    foreach (stobeImm26Alternatives($actor, $npc, $requested, $preferred) as $alt) {
+        $point = $alt['source'] === 'native_local' ? ($locals[$alt['id']] ?? false)
+            : stobeTravelResolvePlan($actor, $npc, $alt['id'], null);
+        if (!is_array($point)) continue;
+        $state = ['status'=>'PROPOSED', 'kind'=>'guide', 'leader'=>'npc', 'destination'=>$point['label'],
+            'destination_point'=>$point, 'reason'=>'Alternative to: ' . mb_substr($requested, 0, 120),
+            'alternative_for'=>mb_substr($requested, 0, 120), 'actor'=>$actor, 'speaker'=>$speaker, 'created_gamets'=>$gamets];
+        $state['plan_hash'] = stobeTravelPlanHash($actor, $speaker, 'guide', 'npc', $point);
+        if ($state['plan_hash'] === '') continue;
+        $state['origin'] = 'npc';
+        $state = stobeCommitmentPrepareTravel($state, null, 'PROPOSE', '', $gamets);
+        if (!stobeTravelWrite($actor, $speaker, $gamets, $state)) return '';
+        stobeImm26AltWrite($actor, $speaker, $gamets, ['requested'=>mb_substr($requested, 0, 120),
+            'offered'=>$point['label'], 'agreement_id'=>$state['agreement_id'], 'gamets'=>$gamets]);
+        return "I can't take you to " . mb_substr($requested, 0, 80) . " from here, but I could guide you to "
+            . $point['label'] . " instead. Shall I lead the way there?";
+    }
+    return '';
+}
+
+/** Who started the plan. Heuristic on the player's current line; '' = unknown/keep. */
+function stobeImm26TravelOrigin(?array $old, string $decision, string $playerLine): string {
+    if (is_array($old) && in_array($old['status'] ?? '', ['PROPOSED','ACCEPTED'], true)) return '';
+    if (!in_array($decision, ['PROPOSE','REPLACE'], true)) return '';
+    return preg_match("/\\b(take me|come with me|go with me|walk with me|travel with me|lead me|guide me|show me|escort|can you take|could you take|let'?s go|go to|head to|accompany)\\b/i", $playerLine) === 1
+        ? 'player' : 'npc';
+}
+
+const STOBE_IMM26_BUSY_REASONS = ['none','starving','critically_wounded','incapacitated','in_combat','on_duty','busy_with_orders','busy_with_job','other_priority'];
+
+/** Native failure tokens to honest human wording. Unknown stays unknown (''). */
+function stobeImm26FailureText(string $token): string {
+    $t = strtolower(trim($token));
+    if ($t === '') return '';
+    if (str_contains($t, 'agreement_expired') || $t === 'expired') return 'the time we had set aside ran out';
+    if (str_contains($t, 'hostile')) return 'hostile people were in the way';
+    if (str_contains($t, 'target_unconscious') || str_contains($t, 'leader_unconscious')) return 'someone went down on the way';
+    if (str_contains($t, 'incapacitated')) return 'I was no longer able to go on';
+    if (str_contains($t, 'path')) return 'the way ahead was blocked or I could not find a path';
+    return '';
+}
+
+/** Queue one natural spoken report per ended trip (completed, failed, cancelled by native). */
+function stobeImm26PlanReportQueuePending(int $limit = 80): int {
+    if (!isset($GLOBALS['db']) || !function_exists('stobeNegQueueDirective')) return 0;
+    $queued = 0;
+    try {
+        $rows = $GLOBALS['db']->fetchAll("SELECT data, gamets FROM eventlog WHERE type='travel_agreement' ORDER BY rowid DESC LIMIT " . intval($limit));
+    } catch (Throwable $e) { return 0; }
+    $seen = [];
+    foreach (is_array($rows) ? $rows : [] as $row) {
+        $data = strval($row['data'] ?? '');
+        if (!preg_match('/^travel-v1:\d+:\d+:/', $data, $m)) continue;
+        if (isset($seen[$m[0]])) continue;
+        $seen[$m[0]] = true;
+        $state = json_decode(substr($data, strlen($m[0])), true);
+        if (!is_array($state) || !in_array($state['status'] ?? '', ['COMPLETED','FAILED','CANCELLED'], true)
+            || !empty($state['execution']['reported']) || empty($state['agreement_id'])) continue;
+        $actor = strval($state['actor'] ?? '');
+        $speaker = strval($state['speaker'] ?? '');
+        if ($actor === '' || $speaker === '') continue;
+        $gamets = intval($row['gamets']);
+        $live = stobeTravelRead($actor, $speaker, $gamets);
+        if (!is_array($live) || ($live['agreement_id'] ?? '') !== $state['agreement_id']) continue;
+        $dest = mb_substr(strval($state['destination'] ?? 'our destination'), 0, 80);
+        if ($state['status'] === 'COMPLETED') {
+            $instr = "You and {$speaker} just reached {$dest}; the trip you agreed on is finished. Say so briefly and naturally (a farewell, or ask what is next). Do not invent extra results or promise a new plan.";
+        } else {
+            $why = stobeImm26FailureText(strval($live['execution']['reason'] ?? ''));
+            $instr = "The trip to {$dest} with {$speaker} has stopped before arriving. "
+                . ($why !== '' ? "Reason: {$why}. Say only that." : "You cannot tell why; say you do not know, do not guess or blame {$speaker}.")
+                . " Tell {$speaker} briefly in your own voice and ask what they want to do (a grounded alternative is fine).";
+        }
+        $live['execution']['reported'] = true;
+        if (!stobeTravelWrite($actor, $speaker, $gamets, $live)) continue;
+        stobeNegQueueDirective($actor, 'plan_report', strval($state['agreement_id']), ['instruction'=>$instr, 'actions'=>[]], false);
+        $queued++;
+    }
+    return $queued;
+}
+
+/**
+ * imm26 24-a: true when the whole player line is an open question about places or qualities ("Where would you take me to find
+ * some peace?", "What is Vain like?"), i.e. every sentence opens with an interrogative and none is a request to go somewhere.
+ * Such a turn is discussion: it creates no trip row and dispatches no movement.
+ */
+function stobeImm26OpenPlaceQuestion(string $line): bool {
+    $q = trim(preg_replace('/\s+/u', ' ', $line));
+    if ($q === '') return false;
+    $parts = preg_split('/(?<=[.!?])\s+/u', $q, -1, PREG_SPLIT_NO_EMPTY);
+    if (!$parts) return false;
+    foreach ($parts as $part) {
+        if (!preg_match('/^(?:(?:so|well|hey|um|and|okay|ok)[,;]?\s+)?(?:where|what|which|how|why|who|is there|are there|do you know|have you)\b/iu', $part)) return false;
+    }
+    return true;
+}
+
+/** Item 23: an unscoped follow of a non-faction NPC becomes a finite implicit agreement. */
+function stobeImm26ImplicitFollow(string $actor, array|false $npc, string $speaker, int $gamets, string $action): bool {
+    if (!is_array($npc) || (function_exists('npcIsInPlayerFaction') && npcIsInPlayerFaction($npc))) return false;
+    if ((function_exists('getSetting') ? getSetting('STOBE_IMPLICIT_FOLLOW', '1') : '1') === '0') return false;
+    if (strcasecmp($action, 'FOLLOW@' . $speaker) !== 0) return false;
+    $old = stobeTravelRead($actor, $speaker, $gamets);
+    if (is_array($old) && ($old['status'] ?? '') === 'ACCEPTED') return false;
+    $pos = stobeTravelNpcPosition($npc, $speaker, []);
+    if (!$pos) return false;
+    $point = ['source'=>'visited_location', 'label'=>'following ' . $speaker, 'x'=>$pos['x'], 'y'=>$pos['y'], 'z'=>$pos['z']];
+    $hash = stobeTravelPlanHash($actor, $speaker, 'same_route', 'player', $point);
+    if ($hash === '') return false;
+    $seconds = max(600, min(86400, intval(function_exists('getSetting') ? getSetting('STOBE_IMPLICIT_FOLLOW_SECONDS', '21600') : '21600')));
+    $state = ['status'=>'ACCEPTED', 'kind'=>'same_route', 'leader'=>'player', 'destination'=>$point['label'],
+        'destination_point'=>$point, 'reason'=>'Plain follow request', 'actor'=>$actor, 'speaker'=>$speaker,
+        'created_gamets'=>$gamets, 'plan_hash'=>$hash, 'implicit'=>true, 'origin'=>'player'];
+    $state = stobeCommitmentPrepareTravel($state, null, 'ACCEPT', 'follow me', $gamets);
+    $state['proposed_by'] = $speaker;
+    $state['expires_gamets'] = $gamets + $seconds;
+    $state['end_condition'] = 'Plain follow: ends when either side withdraws or after ' . intval($seconds / 3600) . ' game hours.';
+    return stobeTravelWrite($actor, $speaker, $gamets, $state);
+}
+
+/** Compact extra instructions appended to the travel-consent prompt (WP-D 14/20/21). */
+function stobeImm26PromptTail(string $actor, array|false $npc, string $speaker, int $gamets): string {
+    $out = '';
+    $avail = stobeNpcAvailabilityPrompt($actor, $npc, $gamets);
+    if ($avail !== '') $out .= $avail . "\n";
+    $out .= "If you cannot or will not do exactly what was asked (no reachable place, your own needs or duties), do not just refuse: offer ONE smaller grounded alternative from the choices above, e.g. only guide the speaker there (travel_kind=guide, travel_leader=npc: you show the way, no fighting). PROPOSE it with travel_destination = its ID or exact name and travel_alternative_id = the same. A loosely worded place is fine when only one choice fits. When you decline for your own priorities set travel_busy_reason to the reason, otherwise 'none'.\n";
+    $state = stobeTravelRead($actor, $speaker, $gamets);
+    if (($state['status'] ?? '') !== 'ACCEPTED') {
+        // imm26 23-b: the model agreed in words ("I'll walk with you") but answered action=Talk, so no follow order existed.
+        $out .= "If the speaker simply asks you to follow them or come along (no destination named) and you agree, set action=Follow with target = the speaker's exact name in this same response (it is a finite arrangement either side can end); words alone start nothing. A plain follow needs no destination: keep travel_decision=NONE (do not PROPOSE a place or ask where they are headed). If you decline, say so plainly and use action Talk.\n";
+    }
+    if (($state['status'] ?? '') === 'ACCEPTED') {
+        $out .= "You already agreed a trip. If the speaker's CURRENT message asks to change it and you agree, use travel_decision=REPLACE with the new terms and an exact travel_player_quote from that message, refer to the old plan and ask the speaker to confirm the change; the old trip stays in force until they confirm. If you will not go to the new place, refuse in character with travel_decision=NONE and the current trip simply continues. When the speaker's NEXT message confirms the change, use travel_decision=ACCEPT with the new destination and an exact quote. Never change the destination silently.\n";
+    }
+    $alt = stobeImm26AltRead($actor, $speaker, $gamets);
+    if (is_array($alt)) {
+        if (!empty($alt['requested']) && !empty($alt['offered'])) $out .= 'You offered ' . $alt['offered'] . ' instead of ' . $alt['requested'] . ".\n";
+        if (!empty($alt['pending_change']['offer']['destination']) && $gamets - intval($alt['pending_change']['gamets'] ?? 0) <= 21600) $out .= 'A change to ' . $alt['pending_change']['offer']['destination'] . " is waiting for the speaker's confirmation; the current trip stays in force until they confirm.\n";
+        if (!empty($alt['pending_replacement']['destination'])) $out .= 'A change of plan to ' . $alt['pending_replacement']['destination'] . " was agreed in words while the old trip was being stopped; propose it again now.\n";
+        if (!empty($alt['postponed']['what'])) $out .= 'You postponed the ask "' . $alt['postponed']['what'] . '" earlier because of your own situation (' . str_replace('_', ' ', strval($alt['postponed']['reason'] ?? '')) . "); you may bring it up again when that has changed.\n";
+    }
+    return $out === '' ? '' : "\n" . rtrim($out);
+}
+
+/** Open deal + postponed ask next to the travel/activity records (WP-D 19 unified view). */
+function stobeImm26OtherCommitments(string $actor, string $speaker, int $gamets): array {
+    $out = [];
+    try {
+        $deal = function_exists('stobeDealOpenForNpc') ? stobeDealOpenForNpc($actor) : null;
+        if (is_array($deal)) $out['deal'] = array_intersect_key($deal, array_flip(['contract_id','status','kind']));
+    } catch (Throwable $e) { /* deals unavailable: unknown, not absent */ }
+    $alt = stobeImm26AltRead($actor, $speaker, $gamets);
+    if (is_array($alt['postponed'] ?? null) && $gamets - intval($alt['postponed']['gamets'] ?? 0) <= 86400) $out['postponed'] = $alt['postponed'];
+    return $out;
+}
diff -ruN -x log -x __pycache__ -x soundcache -x '*.orig' -x '*.rej' a/lib/imm26_repair.php b/lib/imm26_repair.php
--- a/lib/imm26_repair.php	1969-12-31 18:00:00.000000000 -0600
+++ b/lib/imm26_repair.php	2026-10-15 13:26:17.519481712 -0500
@@ -0,0 +1,73 @@
+<?php
+declare(strict_types=1);
+/**
+ * NPC-immersion WP-B (item 10): gradual social repair, conversation side.
+ *
+ * - Behaviour-change relief: on a conversation turn between an NPC and someone it holds a grievance against, the
+ *   server checks whether time without new harm plus real positive conduct has earned a payout and, if so, records
+ *   it through SocialStore::acceptBehaviourChange (shared repair budget; never erases serious harm).
+ * - The NPC is told, compactly, which grievances are still open, how much is left, and what has changed since, so
+ *   its words track the ledger (it remembers, in its own words, without being able to claim more than the record).
+ * Nothing is injected when there is no grievance.
+ */
+
+function stobeRepairConversationContext(string $actor, array $npc, string $listener, array $config = [], array $meta = []): string
+{
+    try {
+        $gamets = intval($meta['stream_gamets'] ?? $meta['gamets'] ?? 0);
+        if ($gamets <= 0 || !function_exists('stobeSocialPreferenceScope') || !function_exists('stobeSocialRepairFactsForScope')) return '';
+        if (!getSettingBool('IMM26_REPAIR', true)) return '';
+        $scope = stobeSocialPreferenceScope($actor, $npc, $listener, $meta);
+        if (!$scope) return '';
+        $mode = function_exists('stobeSocialIngestMode') ? stobeSocialIngestMode() : 'off';
+        $grievances = stobeSocialRepairFactsForScope($scope, $gamets);
+        if (!$grievances) return '';
+        if (in_array($mode, ['enabled', 'fights'], true) && stobeRepairTickDue($scope, $gamets)) {
+            if (!class_exists('SocialStore')) require_once __DIR__ . '/social_store.php';
+            $store = new SocialStore($GLOBALS['db']);
+            $paid = false;
+            foreach (array_slice($grievances, 0, 4) as $g) {
+                try {
+                    $r = $store->acceptBehaviourChange($scope, strval($g['grievance_id']), $gamets, $mode);
+                    if (($r['status'] ?? '') === $mode && (int)($r['effect']['delta'] ?? 0) > 0) $paid = true;
+                } catch (Throwable $e) {
+                    if (function_exists('stobeLogWarn')) stobeLogWarn('Behaviour-change relief skipped', ['error' => $e->getMessage()]);
+                }
+            }
+            if ($paid) $grievances = stobeSocialRepairFactsForScope($scope, $gamets);
+        }
+        return stobeRepairGrievanceText($listener, $grievances, $gamets);
+    } catch (Throwable $e) { return ''; }
+}
+
+/** At most one relief check per pair per game hour (the facts query is not free). */
+function stobeRepairTickDue(array $scope, int $gamets): bool
+{
+    try {
+        $key = 'STOBE_IMM26_REPAIR_TICK_' . substr(hash('sha256', $scope['campaign_id'] . '|' . ($scope['actor_id'] ?? 0) . '|' . ($scope['speaker_id'] ?? 0)), 0, 24);
+        $last = getConfOpt($key, '');
+        if ($last !== '' && $gamets >= (int)$last && $gamets - (int)$last < 3600) return false;
+        setConfOpt($key, strval($gamets));
+        return true;
+    } catch (Throwable $e) { return false; }
+}
+
+/** Compact, factual: what is still held against this person and what has (not) changed. */
+function stobeRepairGrievanceText(string $listener, array $grievances, int $gamets): string
+{
+    $lines = [];
+    foreach (array_slice($grievances, 0, 2) as $g) {
+        $left = (int)($g['residual_grievance']['recorded_harm_remaining'] ?? 0);
+        if ($left <= 0) continue;
+        $serious = !empty($g['residual_grievance']['serious']) || !empty($g['residual_grievance']['repeated']);
+        $conduct = [];
+        foreach (array_slice($g['subsequent_behavior'] ?? [], 0, 3) as $b) $conduct[] = str_replace('_', ' ', strval($b['component']));
+        $lines[] = '- ' . ($g['harm_summary'] ?? 'earlier harm') . ($serious ? ' (serious or repeated: forgiveness is slow)' : '')
+            . '; still unforgiven: ' . $left . ' of ' . (int)$g['recorded_harm'] . '; since then: '
+            . ($conduct ? implode(', ', $conduct) : 'nothing that changes your mind');
+    }
+    if (!$lines) return '';
+    return "Open grievances against " . $listener . " (you remember them in your own words, never as a score):\n" . implode("\n", $lines) . "\n"
+        . "A specific apology, returning what was taken, helping you, keeping promises and time without new harm can soften you a little; none erases it. "
+        . "A vague sorry or an excuse changes nothing; do not forgive more than the record shows.";
+}
diff -ruN -x log -x __pycache__ -x soundcache -x '*.orig' -x '*.rej' a/lib/imm26_ties.php b/lib/imm26_ties.php
--- a/lib/imm26_ties.php	1969-12-31 18:00:00.000000000 -0600
+++ b/lib/imm26_ties.php	2026-10-15 17:15:31.618186332 -0500
@@ -0,0 +1,144 @@
+<?php
+declare(strict_types=1);
+/**
+ * NPC-immersion WP-B (item 4): ties between NPCs.
+ *
+ * A tie is a directed fact "A regards B as <kind>" with a strength (-100..100): friend, family, partner, rival, ex,
+ * debt, employer, squad, faction. Sources: A's own relationship map (typed entries and affinity, which already holds
+ * what the LLM relationship updates wrote), plus stored ties seeded from what the game shows when something happens
+ * in front of two NPCs (same squad / same faction). Ties feed (1) the witness opinion echo (a squadmate who sees a
+ * squadmate hurt cares a little even with no personal affinity), (2) referral ranking and refusal, (3) a short prompt
+ * line whenever the player names a third party the NPC has a tie to. Nothing here invents a tie: no source, no tie.
+ */
+
+require_once __DIR__ . '/imm26_knowledge.php';
+
+const STOBE_TIE_POSITIVE = ['friend', 'family', 'partner', 'employer', 'squad', 'faction'];
+
+function stobeTieEnsureSchema(): bool
+{
+    return stobeKnowledgeEnsureSchema();
+}
+
+function stobeTieNorm(string $name): string
+{
+    return mb_strtolower(trim(function_exists('normalizeParticipantNameToken') ? normalizeParticipantNameToken($name) : $name));
+}
+
+function stobeTieRecord(array $scope, string $a, string $b, string $kind, int $strength, string $source, int $ts): bool
+{
+    $a = stobeTieNorm($a); $b = stobeTieNorm($b);
+    if ($a === '' || $b === '' || $a === $b || !stobeTieEnsureSchema()) return false;
+    return $GLOBALS['db']->exec('INSERT INTO npc_ties(campaign_id,a_name,b_name,kind,strength,source,game_ts) VALUES($1,$2,$3,$4,$5,$6,$7)
+        ON CONFLICT(campaign_id,a_name,b_name,kind) DO UPDATE SET strength=EXCLUDED.strength, source=EXCLUDED.source, game_ts=GREATEST(npc_ties.game_ts,EXCLUDED.game_ts)',
+        [$scope['campaign_id'], $a, $b, $kind, max(-100, min(100, $strength)), $source, $ts]) !== false;
+}
+
+/** What the game shows about two NPCs at an event: same player squad or same faction. */
+function stobeTieSeedFromWitness(array $scope, array $victim, array $witness, int $ts): void
+{
+    try {
+        if (!stobeTieEnsureSchema() || empty($victim['name']) || empty($witness['name'])) return;
+        if (($victim['in_player_faction'] ?? null) === true && ($witness['in_player_faction'] ?? null) === true) {
+            stobeTieRecord($scope, $witness['name'], $victim['name'], 'squad', 45, 'squad', $ts);
+            return;
+        }
+        $fv = mb_strtolower(trim(strval($victim['faction'] ?? ''))); $fw = mb_strtolower(trim(strval($witness['faction'] ?? '')));
+        if ($fv !== '' && $fv === $fw && !in_array($fv, ['none', 'unknown', 'neutral', 'player', 'nobody'], true)) {
+            stobeTieRecord($scope, $witness['name'], $victim['name'], 'faction', 25, 'faction', $ts);
+        }
+    } catch (Throwable $e) {}
+}
+
+/** Map-derived tie from $row's own relationship entry for $other (typed entry or strong affinity), or null. */
+function stobeTieFromMap(array|false $row, string $other): ?array
+{
+    $entry = is_array($row) && function_exists('stobeRelationshipEntryFor') ? stobeRelationshipEntryFor($row, $other) : null;
+    if (!$entry) return null;
+    $aff = (int)($entry['aff'] ?? 0);
+    $type = strtolower(strval($entry['type'] ?? ''));
+    $byType = ['familial' => ['family', 70], 'romantic' => ['partner', 80], 'rival' => ['rival', -60], 'enemy' => ['rival', -70], 'nemesis' => ['rival', -90],
+        'ex' => ['ex', -30], 'estranged' => ['ex', -30], 'indebted' => ['debt', 30], 'patron' => ['employer', 30], 'servant' => ['employer', 30]];
+    if (isset($byType[$type])) return ['kind' => $byType[$type][0], 'strength' => $byType[$type][1], 'source' => 'relationship_map'];
+    if ($aff >= 56) return ['kind' => 'friend', 'strength' => $aff, 'source' => 'relationship_map'];
+    if ($aff <= -31) return ['kind' => 'rival', 'strength' => $aff, 'source' => 'relationship_map'];
+    return null;
+}
+
+/** Strongest known tie of $a toward $b (map first, stored ties in either direction), or null. */
+function stobeTieGet(string $a, string $b, ?array $scope = null, array|false|null $aRow = null): ?array
+{
+    $best = stobeTieFromMap($aRow ?? getNpcData($a), $b);
+    $scope = $scope ?? stobeKnowledgeScope();
+    if ($scope && stobeTieEnsureSchema()) {
+        $rows = $GLOBALS['db']->fetchAll('SELECT kind,strength,source FROM npc_ties WHERE campaign_id=$1 AND ((a_name=$2 AND b_name=$3) OR (a_name=$3 AND b_name=$2))',
+            [$scope['campaign_id'], stobeTieNorm($a), stobeTieNorm($b)]) ?: [];
+        foreach ($rows as $r) {
+            if (!$best || abs((int)$r['strength']) > abs((int)$best['strength'])) $best = ['kind' => $r['kind'], 'strength' => (int)$r['strength'], 'source' => $r['source']];
+        }
+    }
+    return $best;
+}
+
+/** Positive tie strength a witness has toward the victim from stored ties only (the map affinity is read separately). */
+function stobeTieEchoStrength(array $scope, string $witness, string $victim): int
+{
+    try {
+        if (!stobeTieEnsureSchema()) return 0;
+        $r = $GLOBALS['db']->fetchOne("SELECT COALESCE(MAX(strength),0) AS s FROM npc_ties WHERE campaign_id=$1 AND strength>0
+            AND kind IN ('friend','family','partner','employer','squad','faction') AND ((a_name=$2 AND b_name=$3) OR (a_name=$3 AND b_name=$2))",
+            [$scope['campaign_id'], stobeTieNorm($witness), stobeTieNorm($victim)]);
+        return (int)($r['s'] ?? 0);
+    } catch (Throwable $e) { return 0; }
+}
+
+/** Referral ranking: [rank adjustment, hint]. A friend is preferred, a rival is avoided and flagged; no tie = no change. */
+function stobeTieReferralAdjust(string $actor, array|false $actorRow, string $candidate): array
+{
+    $t = stobeTieGet($actor, $candidate, null, $actorRow);
+    if (!$t) return [0, ''];
+    $s = (int)$t['strength'];
+    if ($s >= 56 || in_array($t['kind'], ['family', 'partner'], true)) return [2, 'you count them as ' . $t['kind'] . '; you would gladly vouch for them'];
+    if ($s >= 31) return [1, 'you know them well enough (' . $t['kind'] . ')'];
+    if ($s <= -31) return [-2, 'bad blood between you (' . $t['kind'] . '); you would rather not send anyone to them'];
+    return [0, ''];
+}
+
+function stobeTieDescribe(array $t): string
+{
+    $s = (int)$t['strength'];
+    return match ($t['kind']) {
+        'family' => 'family', 'partner' => 'partner', 'squad' => 'a squadmate', 'faction' => 'same faction', 'employer' => 'work for/with',
+        'debt' => 'there is a debt between you', 'ex' => 'former close tie, now strained', 'rival' => $s <= -60 ? 'bitter enemy' : 'rival',
+        default => $s >= 76 ? 'close friend' : ($s >= 56 ? 'friend' : 'acquaintance'),
+    };
+}
+
+/** Prompt reader: only when the player names a third party this NPC has a real tie to (cap 2 lines). */
+function stobeTiesConversationContext(string $actor, array $npc, string $listener, array $config = [], array $meta = []): string
+{
+    try {
+        // chat.php sets player_message only; user_message kept as a fallback (mirrors npc_referrals.php).
+        $message = is_string($meta['user_message'] ?? null) ? $meta['user_message']
+            : (is_string($meta['player_message'] ?? null) ? $meta['player_message'] : '');
+        if ($message === '' || (int)($npc['id'] ?? 0) < 1) return '';
+        $names = [];
+        $map = function_exists('stobeGetNpcRelationshipMap') ? stobeGetNpcRelationshipMap($npc) : [];
+        foreach (array_slice(array_keys(is_array($map) ? $map : []), 0, 24) as $k) $names[strval($k)] = true;
+        $scope = stobeKnowledgeScope();
+        if ($scope && stobeTieEnsureSchema()) {
+            $rows = $GLOBALS['db']->fetchAll('SELECT a_name,b_name FROM npc_ties WHERE campaign_id=$1 AND (a_name=$2 OR b_name=$2) LIMIT 24',
+                [$scope['campaign_id'], stobeTieNorm($actor)]) ?: [];
+            foreach ($rows as $r) $names[$r['a_name'] === stobeTieNorm($actor) ? $r['b_name'] : $r['a_name']] = true;
+        }
+        $lines = [];
+        foreach (array_keys($names) as $other) {
+            if (strcasecmp($other, $listener) === 0 || strcasecmp($other, $actor) === 0 || !stobeKnowledgeMentions($message, $other)) continue;
+            $t = stobeTieGet($actor, $other, $scope, $npc);
+            if ($t) $lines[] = '- ' . $other . ': ' . stobeTieDescribe($t);
+            if (count($lines) >= 2) break;
+        }
+        if (!$lines) return '';
+        return "Your ties to people just named (let them colour what you say, vouch for or distrust them accordingly; do not invent more history):\n" . implode("\n", $lines);
+    } catch (Throwable $e) { return ''; }
+}
diff -ruN -x log -x __pycache__ -x soundcache -x '*.orig' -x '*.rej' a/lib/imm26_trust.php b/lib/imm26_trust.php
--- a/lib/imm26_trust.php	1969-12-31 18:00:00.000000000 -0600
+++ b/lib/imm26_trust.php	2026-10-15 13:24:48.099291184 -0500
@@ -0,0 +1,228 @@
+<?php
+declare(strict_types=1);
+/**
+ * WP-A items 12 + 13 (NPC immersion 26): trust by kind, and experience beats flattery.
+ * Everything here is read-mostly and fail-closed: no ledger rows = "no record", never an invented event.
+ */
+
+/** Ledger component -> kind of trust it informs. witness_<x> inherits <x> (only safety/combat use witnessed rows). */
+const IMM26_TRUST_COMPONENTS = [
+    'kept_promise'=>'promises', 'kept_coercive_deal'=>'promises', 'broken_promise'=>'promises', 'betrayal'=>'promises',
+    'abandoned_in_danger'=>'promises', 'deal_forgiveness'=>'promises', 'apology_relief'=>'promises',
+    'theft'=>'property', 'petty_theft'=>'property', 'major_theft'=>'property', 'primary_weapon_theft'=>'property',
+    'all_property_theft'=>'property', 'property_returned'=>'property', 'restitution_relief'=>'property',
+    'aggression'=>'safety', 'injury'=>'safety', 'serious_assault'=>'safety', 'critical_harm'=>'safety', 'maiming'=>'safety',
+    'enslavement'=>'safety', 'imprisonment'=>'safety', 'outsider_pickup'=>'safety',
+    'lifesaving'=>'safety', 'safe_rescue'=>'safety', 'meaningful_aid'=>'safety', 'routine_healing'=>'safety',
+    'food_aid'=>'safety', 'survival_food'=>'safety', 'chains_freed'=>'safety', 'slave_escape'=>'safety', 'treated_relief'=>'safety',
+    'defense_of_friend'=>'combat',
+    'confidence_kept'=>'secrets', 'confidence_betrayed'=>'secrets', // reserved for a disclosure producer
+    'gift'=>'dealings', 'fair_trade'=>'dealings', 'favorable_trade'=>'dealings', 'generous_trade'=>'dealings', 'exceptional_trade'=>'dealings',
+];
+
+/** Minimum affinity per kind of request (a floor, never a promise): the record can only raise the bar. */
+const IMM26_TRUST_MIN_GEAR = 60;
+const IMM26_TRUST_MIN_SECRETS = 56;
+const IMM26_TRUST_MIN_RISK = 40;
+const IMM26_TRUST_MIN_RISK_PROVEN = 30;
+
+/** @return array{0:string,1:bool,2:string} kind, witnessed, base component */
+function imm26TrustDomainOf(string $component): array
+{
+    $witnessed = str_starts_with($component, 'witness_');
+    $base = $witnessed ? substr($component, 8) : $component;
+    return [IMM26_TRUST_COMPONENTS[$base] ?? '', $witnessed, $base];
+}
+
+/** Applied ledger rows for (observer NPC -> other), folded per kind. [] when the ledger is off or unreachable. */
+function imm26TrustLedger(string $npcName, string $other): array
+{
+    if (trim($npcName) === '' || trim($other) === '' || !isset($GLOBALS['db'])) return [];
+    try {
+        $db = $GLOBALS['db'];
+        $scope = stobeSocialScope($db);
+        $rows = $db->fetchAll("SELECT component, delta, game_ts FROM social_effect
+            WHERE campaign_id=$1 AND applied AND lower(detail->>'observer_name')=lower($2) AND lower(detail->>'culprit_name')=lower($3)
+            ORDER BY game_ts DESC LIMIT 80", [$scope['campaign_id'], $npcName, $other]) ?: [];
+    } catch (Throwable $e) { return []; }
+    $out = [];
+    foreach ($rows as $row) {
+        [$kind, $witnessed, $base] = imm26TrustDomainOf(strval($row['component']));
+        if ($kind === '') continue;
+        if ($witnessed && !in_array($kind, ['safety', 'combat'], true)) continue;
+        $out[$kind] ??= ['net'=>0, 'pos'=>0, 'neg'=>0, 'latest'=>'', 'by'=>[]];
+        $delta = intval($row['delta']);
+        $out[$kind]['net'] += $delta;
+        if ($delta > 0) $out[$kind]['pos']++; elseif ($delta < 0) $out[$kind]['neg']++;
+        if ($out[$kind]['latest'] === '') $out[$kind]['latest'] = $base;
+        $out[$kind]['by'][$base] = ($out[$kind]['by'][$base] ?? 0) + 1;
+    }
+    return $out;
+}
+
+function imm26TrustDamaged(array $ledger, string $kind): bool
+{
+    $d = $ledger[$kind] ?? null;
+    if (!$d) return false;
+    return $d['net'] <= -5 || ($kind === 'promises' && ($d['by']['abandoned_in_danger'] ?? 0) > 0 && $d['net'] < 0);
+}
+
+/**
+ * What each kind of request needs, for one person. Pure function of affinity + folded ledger.
+ * @return array<string,array{ok:bool,why:string}>
+ */
+function imm26TrustAssess(int $aff, array $ledger): array
+{
+    $promisesBad = imm26TrustDamaged($ledger, 'promises');
+    $propertyBad = imm26TrustDamaged($ledger, 'property');
+    $secretsBad = imm26TrustDamaged($ledger, 'secrets');
+    $abandoned = ($ledger['promises']['by']['abandoned_in_danger'] ?? 0) > 0;
+    $betrayed = ($ledger['promises']['by']['betrayal'] ?? 0) > 0;
+    $safetyBad = ($ledger['safety']['net'] ?? 0) <= -10;
+    $proven = ($ledger['combat']['net'] ?? 0) > 0 && !$abandoned;
+    $gear = ['ok'=>true, 'why'=>''];
+    if ($propertyBad) $gear = ['ok'=>false, 'why'=>'theft or unreturned property on record'];
+    elseif ($promisesBad) $gear = ['ok'=>false, 'why'=>'a broken promise on record'];
+    elseif ($aff < IMM26_TRUST_MIN_GEAR) $gear = ['ok'=>false, 'why'=>'not enough personal trust yet'];
+    $secrets = ['ok'=>true, 'why'=>''];
+    if ($secretsBad) $secrets = ['ok'=>false, 'why'=>'a confidence was betrayed'];
+    elseif ($betrayed || $abandoned || $promisesBad || $propertyBad) $secrets = ['ok'=>false, 'why'=>'their record makes you guarded'];
+    elseif ($aff < IMM26_TRUST_MIN_SECRETS) $secrets = ['ok'=>false, 'why'=>'not close enough yet'];
+    $risk = ['ok'=>true, 'why'=>''];
+    if ($abandoned) $risk = ['ok'=>false, 'why'=>'they left someone in danger before'];
+    elseif ($betrayed) $risk = ['ok'=>false, 'why'=>'they betrayed an agreement'];
+    elseif ($safetyBad) $risk = ['ok'=>false, 'why'=>'they have hurt people'];
+    elseif ($promisesBad) $risk = ['ok'=>false, 'why'=>'a broken promise on record'];
+    elseif ($aff < ($proven ? IMM26_TRUST_MIN_RISK_PROVEN : IMM26_TRUST_MIN_RISK)) {
+        $risk = ['ok'=>false, 'why'=>$proven ? 'not close enough yet' : 'no proof yet that they stand firm'];
+    }
+    $business = ['ok'=>$aff > (defined('STOBE_REL_NO_TRADE_MAX') ? STOBE_REL_NO_TRADE_MAX : -80), 'why'=>'you refuse them'];
+    return ['business'=>$business, 'lend_or_give_gear'=>$gear, 'share_secrets'=>$secrets, 'risk_for_them'=>$risk];
+}
+
+function imm26TrustRecordText(array $ledger, string $kind): string
+{
+    $d = $ledger[$kind] ?? null;
+    if (!$d) return 'no record';
+    $parts = [];
+    foreach ($d['by'] as $c => $n) $parts[] = str_replace('_', ' ', (string)$c) . ' x' . $n;
+    return implode(', ', array_slice($parts, 0, 4));
+}
+
+/** Compact reader for stobeNpcConversationTail. Empty when nothing is known about this pair. */
+function imm26TrustConversationContext(string $actor, array $npc, string $listener, int $gameTs = 0): string
+{
+    if (trim($listener) === '' || strcasecmp(trim($actor), trim($listener)) === 0) return '';
+    if (function_exists('getSettingBool') && (!getSettingBool('RELATIONSHIP_STANCE', true) || !getSettingBool('IMM26_TRUST_KINDS', true))) return '';
+    $entry = function_exists('stobeRelationshipEntryFor') ? stobeRelationshipEntryFor($npc, $listener) : null;
+    $ledger = imm26TrustLedger($actor, $listener);
+    if ($entry === null && !$ledger) return '';
+    $aff = max(-100, min(100, intval($entry['aff'] ?? $entry['affinity'] ?? 0)));
+    $assess = imm26TrustAssess($aff, $ledger);
+    $q = static fn(array $a): string => $a['ok'] ? 'may consider' : 'not yet (' . $a['why'] . ')';
+    $lines = ['<trust_by_kind person="' . stobePromptXmlEscape($listener) . '">'];
+    $lines[] = 'Recorded experience (data): promises: ' . imm26TrustRecordText($ledger, 'promises') . '; property: ' . imm26TrustRecordText($ledger, 'property')
+        . '; safety: ' . imm26TrustRecordText($ledger, 'safety') . '; fighting beside: ' . imm26TrustRecordText($ledger, 'combat')
+        . '; secrets: ' . imm26TrustRecordText($ledger, 'secrets') . '.';
+    $lines[] = 'Readiness by kind of request (data): ordinary business: ' . ($assess['business']['ok'] ? 'yes' : 'no (' . $assess['business']['why'] . ')')
+        . '; lending or giving gear: ' . $q($assess['lend_or_give_gear']) . '; sharing a secret or private history: ' . $q($assess['share_secrets'])
+        . '; risking yourself (fight, raid, dangerous trip): ' . $q($assess['risk_for_them']) . '.';
+    $lines[] = 'Trust is not one feeling. Judge each request by its own kind and refuse or hedge in terms of the kind that fails ("I would not trust you with my gear", "I do not know you well enough to say that"), not as general hostility. Strong liking does not unlock a kind with a bad record, and a good record in one kind does not unlock another. Recorded actions outweigh recent flattery. Do not recite this list.';
+    $lines[] = '</trust_by_kind>';
+    return implode("\n", $lines);
+}
+
+/** Server gate: raise the item/recruit gates when the record (not just affinity) says no. Returns the adjusted config. */
+function imm26TrustAdjustConfig(array $config, array $npcData): array
+{
+    try {
+        if (!getSettingBool('IMM26_TRUST_KINDS', true)) return $config;
+        $npcName = normalizeParticipantNameToken(strval($npcData['name'] ?? ''));
+        $player = strval($config['player_name'] ?? '');
+        if ($npcName === '' || $player === '') return $config;
+        $ledger = imm26TrustLedger($npcName, $player);
+        if (!$ledger) return $config;
+        $assess = imm26TrustAssess(intval($config['player_affinity'] ?? 0), $ledger);
+        $notes = [];
+        if (!$assess['lend_or_give_gear']['ok'] && (imm26TrustDamaged($ledger, 'property') || imm26TrustDamaged($ledger, 'promises'))) {
+            $config['give_equipment_trust_threshold'] = 101;
+            $config['gift_trust_threshold'] = 101;
+            $notes[] = 'will not lend or hand over property: ' . $assess['lend_or_give_gear']['why'];
+        }
+        if (!$assess['risk_for_them']['ok'] && !empty($ledger['promises']) && empty($config['disallow_join_party']) && empty($config['in_player_faction'])) {
+            $config['disallow_join_party'] = true;
+            $config['join_party_block_reason'] = $assess['risk_for_them']['why'];
+            $notes[] = 'will not join them: ' . $assess['risk_for_them']['why'];
+        }
+        if ($notes) $config['trust_notes'] = $notes;
+    } catch (Throwable $e) { /* record unavailable: leave the gates as they were */ }
+    return $config;
+}
+
+/** Positive evaluator gains by pair in the last game day; stored as unapplied ledger rows so they follow the playthrough scope. */
+function imm26DialogueGainUsed(object $db, array $scope, string $speaker, string $target, int $now): int
+{
+    $row = $db->fetchOne("SELECT COALESCE(SUM(delta),0) AS n FROM social_effect WHERE campaign_id=$1 AND component='dialogue_gain' AND NOT applied
+        AND game_ts > $2 AND lower(detail->>'observer_name')=lower($3) AND lower(detail->>'culprit_name')=lower($4)",
+        [$scope['campaign_id'], $now - 86400, $speaker, $target]);
+    return intval($row['n'] ?? 0);
+}
+
+function imm26DialogueHasExperience(object $db, array $scope, string $speaker, string $target): bool
+{
+    $row = $db->fetchOne("SELECT 1 AS x FROM social_effect WHERE campaign_id=$1 AND applied AND delta>0 AND component NOT IN ('dialogue_repair','dialogue_gain')
+        AND lower(detail->>'observer_name')=lower($2) AND lower(detail->>'culprit_name')=lower($3) LIMIT 1", [$scope['campaign_id'], $speaker, $target]);
+    return is_array($row);
+}
+
+/**
+ * Item 13: talk alone cannot outweigh lived experience, in EVERY social mode.
+ * Positive evaluator gains per pair: at most IMM26_DIALOGUE_DAILY_BUDGET per game day (default 3), and with no
+ * recorded positive experience (kept deal, aid, trade, gift...) talk cannot carry affinity above
+ * IMM26_DIALOGUE_CEILING (default 30). Negative updates are never touched.
+ */
+function imm26DialogueBudget(string $speaker, array $updates, array $npc = [], string $listener = '', array $meta = []): array
+{
+    if (!$updates || trim($speaker) === '') return $updates;
+    try {
+        if (!getSettingBool('IMM26_FLATTERY_GUARD', true)) return $updates;
+        require_once __DIR__ . '/social_fights.php';
+        $now = stobeSocialNowGameTs();
+        if ($now <= 0) return $updates;
+        $db = $GLOBALS['db'];
+        $scope = stobeSocialScope($db);
+        $budget = max(0, getSettingInt('IMM26_DIALOGUE_DAILY_BUDGET', 3));
+        $ceiling = max(0, min(100, getSettingInt('IMM26_DIALOGUE_CEILING', 30)));
+        $npcRow = $npc ?: getNpcData($speaker);
+        foreach ($updates as &$update) {
+            if (!is_array($update)) continue;
+            $target = trim(strval($update['target'] ?? ''));
+            if ($target === '' || strcasecmp($target, $speaker) === 0) continue;
+            $entry = function_exists('stobeRelationshipEntryFor') ? stobeRelationshipEntryFor(is_array($npcRow) ? $npcRow : false, $target) : null;
+            $cur = intval($entry['aff'] ?? $entry['affinity'] ?? 0);
+            $gain = 0;
+            if (isset($update['aff_delta']) && intval($update['aff_delta']) > 0) $gain = intval($update['aff_delta']);
+            elseif (isset($update['aff_set']) && intval($update['aff_set']) > $cur) $gain = intval($update['aff_set']) - $cur;
+            if ($gain <= 0) continue;
+            $allowed = min($gain, max(0, $budget - imm26DialogueGainUsed($db, $scope, $speaker, $target, $now)));
+            $why = 'flattery_daily_budget';
+            if ($allowed > 0 && $cur + $allowed > $ceiling && !imm26DialogueHasExperience($db, $scope, $speaker, $target)) {
+                $allowed = min($allowed, max(0, $ceiling - $cur));
+                $why = 'dialogue_ceiling_no_shared_experience';
+            }
+            if ($allowed > 0) {
+                $db->exec("INSERT INTO social_effect(campaign_id,timeline_epoch,incident_id,observer_key,culprit_key,component,game_ts,delta,detail,applied,rules_version)
+                    VALUES($1,$2,$3,$4,$5,'dialogue_gain',$6,$7,jsonb_build_object('observer_name',$8::text,'culprit_name',$9::text,'source','dialogue'),false,'imm26')",
+                    [strval($scope['campaign_id']), strval($scope['timeline_epoch']), 'dgain:' . $now . ':' . bin2hex(random_bytes(4)),
+                     'name:' . strtolower($speaker), 'name:' . strtolower($target), $now, min(100, $allowed), $speaker, $target]);
+            }
+            if ($allowed >= $gain) continue;
+            if (isset($update['aff_delta']) && intval($update['aff_delta']) > 0) $update['aff_delta'] = $allowed;
+            else $update['aff_set'] = $cur + $allowed;
+            if (function_exists('stobeLogRelationshipInfo')) stobeLogRelationshipInfo('SOCIAL_DIALOGUE filtered', ['speaker'=>$speaker, 'target'=>$target,
+                'from'=>$gain, 'to'=>$allowed, 'reason'=>$why]);
+        }
+        unset($update);
+    } catch (Throwable $e) { /* ledger unavailable: legacy behaviour */ }
+    return $updates;
+}
