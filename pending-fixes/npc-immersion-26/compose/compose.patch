+    'agreedTargets'=>[404,303], 'routeRef'=>['candidateId'=>$route['candidateId']], 'campZoneRef'=>$camp];
+$proposal = $adapter->propose($context, $intent);
+expect($proposal['agreement']['scopeVersion'] === 3, 'camp scope version is explicit');
+expect($proposal['agreement']['campZone'] === $camp, 'opaque zone token and digest persist in agreement');
+expect($proposal['agreement']['agreedTargets'] === [303,404], 'fixed hostile set is sorted and persisted');
+expect(strlen($proposal['scopeDigest']) === 64, 'server digest binds camp scope and exact route');
+$accepted = $adapter->accept($context, $proposal, 'exact-displayed-consent');
+expect($accepted['record']['agreement']['campZone'] === $camp, 'acceptance retains camp scope');
+expect($accepted['envelope']['agreement']['campZone'] === $camp, 'signed grant envelope retains camp scope');
+expect($accepted['envelope']['scopeDigest'] === $proposal['scopeDigest'], 'grant carries exact signed scope digest');
+expect($grounded === 2, 'native discovery grounding repeats at propose and consent');
+
+$tamperedProposal = $proposal;
+$tamperedProposal['agreement']['campZone']['candidateId'] = 'v1:' . str_repeat('c', 48);
+$rejected = false;
+try { $adapter->accept($context, $tamperedProposal, 'exact-displayed-consent'); } catch (RuntimeException $e) { $rejected = true; }
+expect($rejected, 'proposal digest rejects a substituted opaque zone identity');
+$tamperedProposal = $proposal;
+$tamperedProposal['agreement']['campZone']['scopeDigest'] = str_repeat('c', 64);
+$rejected = false;
+try { $adapter->accept($context, $tamperedProposal, 'exact-displayed-consent'); } catch (RuntimeException $e) { $rejected = true; }
+expect($rejected, 'proposal digest rejects altered native camp facts/target digest');
+
+$legacyIntent = $intent;
