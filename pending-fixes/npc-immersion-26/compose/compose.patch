+    stobeTravelCapture($raw, $actor, $npc, 'Shay', $playerLine, 1000, $text, $actions);
+    return [$text, $actions];
+}
+function saved(string $key): array {
+    $rows = $GLOBALS['db']->fetchAll("SELECT data FROM eventlog WHERE type='travel_agreement' AND LEFT(data, LENGTH($1))=$1 ORDER BY rowid", [$key]);
+    return array_map(static fn($r) => json_decode(substr(strval($r['data']), strlen($key)), true), is_array($rows) ? $rows : []);
+}
