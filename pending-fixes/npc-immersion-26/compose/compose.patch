+/** Compare only immutable destination identity; native observation IDs may refresh. */
+function stobeTravelSameOfferedPoint(array $offered, array $observed): bool {
+    foreach (['source','label'] as $field) {
+        if (!array_key_exists($field, $offered) || !array_key_exists($field, $observed)
+            || $offered[$field] !== $observed[$field]) return false;
