+}
+
+function stobeActivityEnrichFacts(array $facts): array {
+    if (!isset($facts['candidates'])) $facts['candidates'] = [$facts];
+    $catalogPath = dirname(__DIR__) . '/destination_discovery.php';
+    if (is_file($catalogPath)) require_once $catalogPath;
+    $catalog = function_exists('stobeDestinationCatalog') ? stobeDestinationCatalog() : [];
+    $out = [];
+    foreach ($facts['candidates'] as $candidate) {
+        if (!is_array($candidate)) continue;
+        if (stobeActivityKindShape((string)($candidate['kind'] ?? '')) !== 'collect') { $candidate['resourceId']=''; $out[]=$candidate; continue; }
+        foreach ($catalog as $entry) {
+            if (($entry['source_id'] ?? '') !== ($candidate['sourceId'] ?? null)) continue;
+            foreach ($entry['yields'] ?? [] as $yield) {
+                if (($yield['confidence'] ?? '') !== 'data_defined' || !is_string($yield['resource_id'] ?? null)) continue;
+                if (($candidate['resourceId'] ?? '') !== '' && $candidate['resourceId'] !== $yield['resource_id']) continue;
+                $copy = $candidate; $copy['resourceId']=$yield['resource_id']; $copy['resourceName']=$yield['name'] ?? '';
+                $out[]=$copy;
+            }
+        }
+    }
+    $facts['candidates']=$out;
+    return $facts;
+}
+
+function stobeActivitySelectFacts(array $facts,array $agreement,?array $reference): array {
+    if (!isset($facts['candidates'])) return $facts;
+    foreach ($facts['candidates'] as $candidate) {
+        if (($candidate['sourceId'] ?? null) !== $agreement['sourceId'] || ($candidate['resourceId'] ?? '') !== $agreement['resourceId']
+            || ($candidate['kind'] ?? '') !== $agreement['kind']) continue;
+        if ($reference !== null && (($candidate['candidateId'] ?? '') !== $reference['candidateId'] || ($candidate['targetSerial'] ?? null) !== $reference['targetSerial'])) continue;
+        return array_merge($candidate,array_intersect_key($facts,array_flip(['worldId','actor','requester','npcWilling'])));
+    }
+    return [];
+}
