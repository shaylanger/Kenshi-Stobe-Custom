+// 4. Per-kind TTL: arrival stays valid 5 min, progress expires after 150 s, claim honors gate refusal.
+cleanup();
+$prefix = 'situated-v1:910003:';
+$old = function (string $id, string $kind, int $ageSeconds) use ($prefix, $G) {
+    storeEvent('situated_event', time(), $G, $prefix . json_encode(['event_id'=>$id,'activity_id'=>'z','requester_serial'=>910002,'kind'=>$kind,'fact'=>"fact $id",'recorded_unix'=>time() - $ageSeconds]), 'pending', '', '', false);
+};
+$old('e-progress', 'progress', 200);
+check('expired progress (200 s) not claimable', stobeSituatedClaimForSerials(910003, 910002, 'A', 'B', $G, [], [], $allow) === null);
+$old('e-arrival', 'arrival', 300);
+$gateSeen = [];
+check('gate refusal blocks the claim', stobeSituatedClaimForSerials(910003, 910002, 'A', 'B', $G, [], [], function ($k) use (&$gateSeen) { $gateSeen[] = $k; return false; }) === null && $gateSeen === ['arrival'], $gateSeen);
+$c3 = stobeSituatedClaimForSerials(910003, 910002, 'A', 'B', $G, [], [], $allow);
+check('arrival (300 s) still claimable', is_array($c3) && $c3['event_id'] === 'e-arrival', $c3);
