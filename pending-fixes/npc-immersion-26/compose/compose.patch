+<?php
+declare(strict_types=1);
+
+/**
+ * IMM26 WP-C1 aggregator (items 2, 5, 6, 7). One reader hooked into lib/social_additions.php and
+ * one after-reply hook hooked into processor/chat.php. Every part is independent, switchable
+ * (IMM26_PRINCIPLES, IMM26_DISCRETION, IMM26_PREF_EXT, IMM26_REFERRALS) and returns '' when it has
+ * nothing relevant, so the common turn pays no prompt tokens.
+ */
+foreach (['imm26_c1_principles.php', 'imm26_c1_discretion.php', 'imm26_c1_prefs.php', 'imm26_c1_referrals.php'] as $imm26File) {
+    require_once __DIR__ . '/' . $imm26File;
+}
+
+function stobeImm26C1Context(string $actor, array $npc, string $listener, array $config = [], array $meta = []): string
+{
+    if (!empty($meta['skip_social_context'])) return '';
+    if (function_exists('stobeIsNarratorName') ? stobeIsNarratorName($actor) : strcasecmp(trim($actor), 'The Narrator') === 0) return '';
+    $listener = function_exists('normalizeParticipantNameToken') ? normalizeParticipantNameToken($listener) : trim($listener);
+    $parts = [];
+    foreach ([
+        'stobeImm26PrinciplesContext', 'stobeImm26DiscretionContext', 'stobeImm26PrefFactionContext', 'stobeImm26IntroContext',
+    ] as $reader) {
+        try {
+            $text = $reader($actor, $npc, $listener, $config, $meta);
+            if (is_string($text) && trim($text) !== '') $parts[] = $text;
+        } catch (Throwable $e) {
+            if (function_exists('stobeLogWarn')) stobeLogWarn('IMM26 C1 context part failed', ['part' => $reader, 'error' => $e->getMessage()]);
+        }
+    }
+    return implode("\n\n", $parts);
+}
+
+/** After a surviving direct reply. Never throws; returns what each part did (for tests / log). */
+function stobeImm26C1AfterReply(string $actor, array $npc, string $listener, string $message, string $reply, int $gamets): array
+{
+    $out = [];
+    $steps = [
+        'principles' => static fn() => stobeImm26PrincipleAfterReply($actor, $npc, $listener, $message, $reply, $gamets),
+        'discretion' => static fn() => stobeImm26DiscretionAfterReply($actor, $reply),
+        'introductions' => static fn() => stobeImm26IntroAfterReply($actor, $npc, $listener, $message, $reply, $gamets),
+        'acknowledged' => static fn() => stobeImm26IntroAcknowledge($actor, $npc, $listener, $gamets, $reply),
+    ];
+    foreach ($steps as $name => $step) {
+        try { $out[$name] = $step(); }
+        catch (Throwable $e) {
+            $out[$name] = 'error';
+            if (function_exists('stobeLogWarn')) stobeLogWarn('IMM26 C1 after-reply part failed', ['part' => $name, 'error' => $e->getMessage()]);
+        }
+    }
+    unset($GLOBALS['STOBE_IMM26_C1_TURN']);
+    return $out;
+}
diff -ruN -x log -x __pycache__ -x soundcache -x '*.orig' -x '*.rej' a/lib/imm26_c1_discretion.php b/lib/imm26_c1_discretion.php
