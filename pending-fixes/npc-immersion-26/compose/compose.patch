+tr_seed($I, $Is, ['point'=>['source'=>'native_local', 'label'=>'Old Gate', 'x'=>100.0, 'y'=>2.0, 'z'=>300.0]]);
+$r = tr_turn($I, $Is, 1100, ['live'=>true]);
+tr_expect_failed('native_local destination', $r);
