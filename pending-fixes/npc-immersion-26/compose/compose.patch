+/** Decide what to do with an interrupted_by_load trip on this response.
+ * Returns ['verdict'=>'none'|'wait'|'fail'|'resume','reason'=>string,'why'=>string]. Never writes.
+ * Terminal (fail): expired, too old, resume_count at max, NPC dead, policy refusal, destination gone.
+ * Transient (wait): no fresh verified-absent snapshot, NPC not in the people list (> 80u), incapacitated or in combat.
+ */
+function stobeCommitmentResumeCheck(string $actor, string $speaker, array|false $npc, int $gamets, array $state): array {
+    $none = ['verdict'=>'none','reason'=>'','why'=>''];
+    $execution = is_array($state['execution'] ?? null) ? $state['execution'] : [];
+    if (($state['status'] ?? '') !== 'ACCEPTED' || ($execution['phase'] ?? '') !== 'interrupted_by_load'
+        || empty($state['agreement_id'])) return $none;
+    $settings = stobeCommitmentResumeSettings();
+    if (!$settings['enabled'] || !is_array($npc)) return $none;
+    $fail = static fn(string $why, string $reason): array => ['verdict'=>'fail','reason'=>$reason,'why'=>$why];
+    if (intval($state['expires_gamets'] ?? 0) - $gamets < 60) return $fail('expired',"That agreed trip ran out of time while the game was away, so we'll need a fresh plan.");
+    if ($gamets - intval($execution['interrupted_gamets'] ?? $gamets) > $settings['max_age']) return $fail('too_old',"Too much time has passed since our journey was interrupted, so we'll need a fresh plan.");
+    if (intval($execution['resume_count'] ?? 0) >= $settings['max_count']) return $fail('resume_count',"I could not get our interrupted journey moving again, so we'll need a fresh plan.");
+    $meta = function_exists('normalizeCoreNpcMetadata') ? normalizeCoreNpcMetadata($npc['metadata'] ?? []) : [];
+    if (strtolower(trim(strval($meta['character_state'] ?? ''))) === 'dead') return $fail('npc_dead','This traveller can no longer continue the journey.');
+    $policy = function_exists('stobeTravelPolicyRefusal') ? stobeTravelPolicyRefusal($npc,$speaker,$state) : '';
+    if ($policy !== '') return $fail('policy_refusal',$policy);
+    $destination = trim(strval($state['destination'] ?? ''));
+    $zoneNames = function_exists('stobeTravelZoneRows')
+        ? array_map(static fn($zone) => mb_strtolower(strval($zone['name'] ?? '')), stobeTravelZoneRows()) : [];
+    if (!is_array($state['destination_point'] ?? null) || ($state['destination_point']['source'] ?? '') !== 'visited_location'
+        || $destination === '' || ($zoneNames !== [] && !in_array(mb_strtolower($destination),$zoneNames,true))) {
+        // Gone = the zone tables are populated but no longer list this place (an empty table is "unknown", not "gone").
+        return $fail('destination_gone','The place we were heading to is no longer a known destination, so we need a fresh plan.');
+    }
+    $wait = static fn(string $why): array => ['verdict'=>'wait','reason'=>'','why'=>$why];
+    if (stobeResolveLiveParticipantSerial($actor) <= 0) return $wait('not_in_people'); // beyond the 80u participant radius
+    $snapshot = stobeCommitmentNativeSnapshot($actor,$npc,$gamets);
+    if (!$snapshot) return $wait('no_snapshot');
+    if (!stobeCommitmentAbsenceVerified($snapshot,$gamets)) return $wait('absence_unverified');
+    if (function_exists('stobeNpcAvailability')) {
+        $availability = stobeNpcAvailability($actor,$npc,$gamets);
+        if (array_intersect(['incapacitated','in_combat'],$availability['reasons'] ?? [])) return $wait('unavailable');
+    }
+    return ['verdict'=>'resume','reason'=>'','why'=>''];
+}
