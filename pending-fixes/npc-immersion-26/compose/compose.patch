+check('record threat', stobeSituatedRecordEvent(910001, 910002, $G, $t));
+check('duplicate event id refused', !stobeSituatedRecordEvent(910001, 910002, $G, $t));
+$allow = fn(string $k) => true;
+$c = stobeSituatedClaimForSerials(910001, 910002, 'A', 'B', $G, [], [], $allow);
