+[$G, $Gs] = tr_actor(); tr_seed($G, $Gs); tr_turn($G, $Gs, 1100, ['live'=>false]);
+$r = tr_turn($G, $Gs, 1200, ['live'=>true, 'char_state'=>'dead']);
+tr_expect_failed('NPC dead', $r);
