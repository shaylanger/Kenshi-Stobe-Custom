+}
+
+$regionPlanHandled = false;
+if ($regionPlanTurn !== null && !$activityHandled && !$manualActionForcedEmoteOnly
+    && !empty($streamResult['ok']) && ($npcOutNow ?? '') === ''
+    && ($socialTurnTestInjection ?? null) === null && !$autochatRewriteApplied
