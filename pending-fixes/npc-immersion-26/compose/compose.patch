+check('travel arrival recorded', stobeSituatedRecordTravelOutcome($state, ['phase'=>'completed','actor_serial'=>910005,'speaker_serial'=>910002], $G));
+check('travel arrival deduped', !stobeSituatedRecordTravelOutcome($state, ['phase'=>'completed','actor_serial'=>910005,'speaker_serial'=>910002], $G));
+check('travel running ignored', !stobeSituatedRecordTravelOutcome($state, ['phase'=>'running','actor_serial'=>910005,'speaker_serial'=>910002], $G));
+$trip = stobeSituatedRecentEventsForSerials(910005, 910002, $G);
+check('travel arrival visible next turn', str_contains($trip, 'arrived at Squin script'), $trip);
+check('travel failure recorded', stobeSituatedRecordTravelOutcome(['agreement_id'=>'trip-78','destination'=>''] + $state, ['phase'=>'failed','actor_serial'=>910005,'speaker_serial'=>910002], $G));
+cleanup();
+
+// 7. Wiring.
+$act = file_get_contents(__DIR__ . '/../activity.php');
+check('activity.php: event op validated', str_contains($act, "if (\$op === 'event')") && str_contains($act, 'stobeActivityEventNormalize'));
