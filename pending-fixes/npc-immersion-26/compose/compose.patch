+
+// Only a surviving validated direct reply can create conversational memories.
+// Replaced/dropped output and injected responses cannot write.
+if ($socialCaptureSchema && !$manualActionForcedEmoteOnly && ($npcOutNow ?? '') === ''
+    && !empty($streamResult['ok']) && ($socialTurnTestInjection ?? null) === null
