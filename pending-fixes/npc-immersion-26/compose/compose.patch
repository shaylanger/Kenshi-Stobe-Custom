--- a/lib/npc_availability.php	1969-12-31 18:00:00.000000000 -0600
+++ b/lib/npc_availability.php	2026-10-15 19:28:53.530843667 -0500
@@ -0,0 +1,85 @@
+<?php
+/** NPCs have their own priorities (WP-D item 21).
+ * Server-side availability: a starving, badly hurt, fighting, on-duty or otherwise
+ * occupied NPC declines NEW travel/activity commitments in character, whatever the
+ * model said. Inputs are stored condition fields and the (freshness-gated) native
+ * snapshot; missing data means "no restriction", never an invented excuse.
+ */
+if (is_file(__DIR__ . '/native_ai_context.php')) require_once __DIR__ . '/native_ai_context.php';
+
+const STOBE_AVAIL_REASONS = ['starving','critically_wounded','incapacitated','in_combat','on_duty','busy_with_orders','busy_with_job'];
+
+function stobeNpcAvailability(string $actor, array|false $npc, int $gamets = 0): array {
+    $out = ['available'=>true, 'reasons'=>[], 'detail'=>[]];
+    if (!is_array($npc)) return $out;
+    $meta = function_exists('normalizeCoreNpcMetadata') ? normalizeCoreNpcMetadata($npc['metadata'] ?? []) : (is_array($npc['metadata'] ?? null) ? $npc['metadata'] : []);
+    $state = strtolower(trim(strval($meta['character_state'] ?? '')));
+    $reasons = [];
+    if (in_array($state, ['dead','unconscious','knocked_out','knocked out','ko'], true)) $reasons[] = 'incapacitated';
+    $hungerPct = stobeNpcAvailPct($npc['hunger'] ?? ($meta['hunger'] ?? ''));
+    $bloodPct = stobeNpcAvailPct($npc['blood'] ?? ($meta['blood'] ?? ''));
+    $hungerMin = max(1, min(40, intval(function_exists('getSetting') ? getSetting('STOBE_AVAIL_STARVING_PCT', '10') : 10)));
+    $bloodMin = max(1, min(60, intval(function_exists('getSetting') ? getSetting('STOBE_AVAIL_WOUNDED_PCT', '25') : 25)));
+    if ($hungerPct !== null && $hungerPct < $hungerMin) $reasons[] = 'starving';
+    if ($bloodPct !== null && $bloodPct < $bloodMin) $reasons[] = 'critically_wounded';
+    $native = function_exists('stobeNativeAiSnapshot') ? stobeNativeAiSnapshot($actor, $npc, $gamets) : [];
+    if (($native['combat']['in_combat'] ?? false) === true) $reasons[] = 'in_combat';
+    if (($native['squad']['contract']['active_package'] ?? false) === true) $reasons[] = 'on_duty';
+    foreach ($native['player_orders'] ?? [] as $order) {
+        if (in_array(strval($order['type'] ?? ''), ['Guard','Patrol','Hold'], true)) { $reasons[] = 'busy_with_orders'; $out['detail']['order'] = strval($order['type']); break; }
+    }
+    $job = trim(strval($native['active_job']['name'] ?? ''));
+    if ($job === '' && is_array($native['assigned_jobs'] ?? null)) {
+        // imm26 21-b: a permajob is not reported as active_job. She is on it right now when the observed current goal IS one of her
+        // assigned jobs (the expired flags are ignored: a standing job goal keeps reporting them). A permajob alone, with a different
+        // or no current goal, is not busy.
+        $goal = mb_strtolower(trim(strval($native['current_goal']['description'] ?? '')));
+        if ($goal !== '') foreach ($native['assigned_jobs'] as $assigned) {
+            if (mb_strtolower(trim(strval($assigned))) === $goal) { $job = trim(strval($assigned)); break; }
+        }
+    }
+    if ($job !== '') { $reasons[] = 'busy_with_job'; $out['detail']['job'] = $job; }
+    $reasons = array_values(array_unique(array_intersect(STOBE_AVAIL_REASONS, $reasons)));
+    $out['reasons'] = $reasons;
+    $out['available'] = $reasons === [];
+    return $out;
+}
+
+/** Percent 0..100 from "cur/max"; null when unknown. */
+function stobeNpcAvailPct(mixed $raw): ?float {
+    if (!function_exists('stobeParseCurrentMaxRatio')) return null;
+    $r = stobeParseCurrentMaxRatio($raw);
+    return ($r['valid'] ?? false) ? floatval($r['pct']) : null;
+}
+
+/** In-character decline for the first (most pressing) reason. '' when available. */
+function stobeNpcAvailabilityRefusal(array $availability): string {
+    $reasons = $availability['reasons'] ?? [];
+    if (!$reasons) return '';
+    $job = trim(strval($availability['detail']['job'] ?? ''));
+    return match ($reasons[0]) {
+        'incapacitated'=>"I'm in no state for that right now.",
+        'in_combat'=>"Not now, I'm in the middle of a fight.",
+        'critically_wounded'=>"I'm hurt too badly to go anywhere. Let me see to my wounds first, then ask me again.",
+        'starving'=>"I need food first, I can barely keep going. Ask me again once I've eaten.",
+        'on_duty'=>"I can't leave my post, I'm on duty. Ask me again when I'm off it.",
+        'busy_with_orders'=>"I've been told to hold this position. I can't go anywhere yet.",
+        default=>$job !== '' ? "I'm in the middle of my work (" . mb_substr($job, 0, 60) . "). Ask me again later." : "I'm busy with my work right now. Ask me again later.",
+    };
+}
+
+/** Compact prompt line, only when something limits the NPC. */
+function stobeNpcAvailabilityPrompt(string $actor, array|false $npc, int $gamets = 0): string {
+    $a = stobeNpcAvailability($actor, $npc, $gamets);
+    if ($a['available']) return '';
+    return "Your own situation right now limits new commitments (server-enforced): " . implode(', ', str_replace('_', ' ', $a['reasons']))
+        . ". Decline new travel or joint activity in your own words and say why honestly; offer to help later or a smaller alternative. Do not invent other excuses and do not mention numbers.";
+}
+
+/** Remember that an ask was postponed because of the NPC's own priorities. */
+function stobeNpcAvailabilityNotePostponed(string $actor, string $speaker, int $gamets, string $reason, string $what): void {
+    if (!function_exists('stobeImm26AltWrite')) return;
+    $rec = stobeImm26AltRead($actor, $speaker, $gamets) ?: [];
+    $rec['postponed'] = ['reason'=>$reason, 'what'=>mb_substr($what, 0, 120), 'gamets'=>$gamets];
+    stobeImm26AltWrite($actor, $speaker, $gamets, $rec);
+}
