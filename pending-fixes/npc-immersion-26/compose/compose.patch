--- a/lib/activity/ActivityLifecycle.php	1969-12-31 18:00:00.000000000 -0600
+++ b/lib/activity/ActivityLifecycle.php	2026-10-15 13:31:13.797233982 -0500
@@ -0,0 +1,69 @@
+<?php
+declare(strict_types=1);
+require_once __DIR__.'/ActivityKinds.php';
+/**
+ * Activity lifecycle visible to chat and to the goal history (imm26 item 26).
+ * The terminal native report may carry an allow-listed `reason` and a `handBack` object
+ * ({"status":"handed_over|failed|not_applicable","reason":"<allow-listed>"}). Anything outside the lists is dropped, never stored,
+ * so free text from the game or the model cannot become an instruction.
+ */
+function stobeActivityReasonTexts(): array {
+    return [
+        'no_observed_suitable_reachable_target' => 'no suitable, reachable target could be found',
+        'target_lost'          => 'the target was lost before the job was finished',
+        'timeout'              => 'there was no progress for too long',
+        'expired'              => 'the agreed time ran out',
+        'cancelled_by_player'  => 'it was called off',
+        'actor_incapacitated'  => 'the worker was knocked down or hurt too badly to continue',
+        'route_unreachable'    => 'the way there was blocked',
+        'threat_too_high'      => 'the danger around the target was too high',
+        'inventory_full'       => 'there was no room left to carry the result',
+    ];
+}
+
+function stobeActivityNormalizeReason(mixed $value): string {
+    $reason = is_string($value) ? $value : '';
+    return isset(stobeActivityReasonTexts()[$reason]) ? $reason : '';
+}
+
+function stobeActivityNormalizeHandBack(mixed $value): array {
+    if (!is_array($value)) return [];
+    $status = strval($value['status'] ?? '');
+    if (!in_array($status, ['handed_over','failed','not_applicable'], true)) return [];
+    $out = ['status' => $status];
+    $reason = stobeActivityNormalizeReason($value['reason'] ?? null);
+    if ($reason !== '') $out['reason'] = $reason;
+    return $out;
+}
+
+/** One compact sentence for the NPC about how the agreed job ended; null while it is still running. */
+function stobeActivityOutcomeText(array $record): ?string {
+    $status = strval($record['status'] ?? '');
+    if (!in_array($status, ['completed','failed','cancelled','expired'], true)) return null;
+    $a = $record['agreement'] ?? [];
+    $info = stobeActivityKindInfo(strval($a['kind'] ?? '')) ?? ['gerund' => 'working', 'shape' => 'place'];
+    $what = $info['gerund'];
+    if (($info['shape'] ?? '') === 'collect' && intval($a['quantity'] ?? 0) > 0) $what .= ' '.intval($a['quantity']).' '.strval($a['resourceId'] ?? 'items');
+    $reasons = stobeActivityReasonTexts();
+    $reason = strval($record['failureReason'] ?? '');
+    $text = $status === 'completed' ? 'The agreed job ('.$what.') is finished.'
+        : 'The agreed job ('.$what.') ended without success'.($reason !== '' ? ': '.$reasons[$reason] : '').'.';
+    $hb = is_array($record['handBack'] ?? null) ? $record['handBack'] : [];
+    if (($hb['status'] ?? '') === 'handed_over') $text .= ' The result was handed over to the player.';
+    elseif (($hb['status'] ?? '') === 'failed') $text .= ' Handing the result over did not work'.(!empty($hb['reason']) ? ' ('.($reasons[$hb['reason']] ?? '').')' : '').'.';
+    return $text;
+}
+
+/** Goal-history row: a durable, structured record of how each agreed job ended (eventlog type activity_history). */
+function stobeActivityRecordHistory(array $record): bool {
+    $text = stobeActivityOutcomeText($record);
+    if ($text === null || !isset($GLOBALS['db']) || !function_exists('storeEvent')) return false;
+    $a = $record['agreement'];
+    $payload = ['agreement_id' => $a['id'], 'kind' => $a['kind'], 'status' => $record['status'], 'requester_serial' => $a['requester'],
+        'resource' => $a['resourceId'] ?? '', 'quantity' => $a['quantity'] ?? 0, 'reason' => strval($record['failureReason'] ?? ''),
+        'hand_back' => $record['handBack'] ?? null, 'summary' => $text];
+    try {
+        return is_array(storeEvent('activity_history', time(), intval($record['lastNow']),
+            'activity-v1:'.$a['actor'].':'.json_encode($payload, JSON_UNESCAPED_UNICODE), 'pending', '', '', false));
+    } catch (Throwable $e) { return false; }
+}
