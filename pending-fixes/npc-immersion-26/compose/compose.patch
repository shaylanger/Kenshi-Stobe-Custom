+    $names=[];
+    if (function_exists('stobeDestinationCatalog')) foreach (stobeDestinationCatalog() as $entry) foreach ($entry['yields'] ?? [] as $yield) {
+        if (($yield['resource_id'] ?? '')!==$resource || ($yield['confidence'] ?? '')!=='data_defined') continue;
+        $name=strtolower(trim(strval($yield['name'] ?? '')));
+        if ($name==='') continue;
+        $names[]=$name; if (str_starts_with($name,'raw ')) $names[]=substr($name,4);
+    }
