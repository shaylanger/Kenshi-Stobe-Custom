+    $generic="(?:i(?:'ll| will) (?:come|go)(?: (?:along|with you|with))?|i(?:'m| am) in|let(?:'s|s| us) (?:do it|get it done|go)|sounds good|that sounds good|i agree|i accept|count me in)";
