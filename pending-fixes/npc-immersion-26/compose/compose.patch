+/** Trip-resume hook (called once per response from streamResponse before the action loop): returns the already agreed
+ * movement action (TRAVEL_LOCATION@<destination> when the NPC leads, FOLLOW@<speaker> when the player leads) or ''.
+ * Everything after this is the ordinary pipeline: new request_id, new world/generation pin, OWNED_TRAVEL start wire.
+ * $actions are the model's actions of this response; a response that already carries movement is left alone.
+ */
+function stobeCommitmentResumeAction(string $actor, array|false $npc, int $gamets, array $actions = []): string {
+    if (!is_array($npc) || trim($actor) === '' || $gamets <= 0 || !isset($GLOBALS['db'])) return '';
+    if (($GLOBALS['STOBE_TRIP_RESUME_DONE'][$actor] ?? null) === $gamets) return ''; // at most one injection per response
+    $speaker = stobeTravelSpeaker();
+    if ($speaker === '') return '';
+    if (intval($GLOBALS['STOBE_TRAVEL_GAMETS'] ?? 0) <= 0) $GLOBALS['STOBE_TRAVEL_GAMETS'] = $gamets;
+    try {
+        $state = stobeTravelRead($actor,$speaker,$gamets);
+        if (!is_array($state) || ($state['execution']['phase'] ?? '') !== 'interrupted_by_load') {
+            // A bored/director turn may not have built the travel prompt: let the reconcile enter the paused phase first.
+            if (is_array($state) && ($state['status'] ?? '') === 'ACCEPTED' && !empty($state['execution']['dispatch_world_id'])) {
+                stobeCommitmentReconcileNative($actor,$speaker,$npc,$gamets);
+                $state = stobeTravelRead($actor,$speaker,$gamets);
+            }
+            if (!is_array($state) || ($state['execution']['phase'] ?? '') !== 'interrupted_by_load') return '';
+        }
+        $check = stobeCommitmentResumeCheck($actor,$speaker,$npc,$gamets,$state);
+        if ($check['verdict'] === 'fail') {
+            stobeCommitmentResumeFail($actor,$speaker,$gamets,$state,$check['reason'],$check['why']);
+            stobeLogInfo('Trip resume ended',['npc'=>$actor,'why'=>$check['why']]);
+            return '';
+        }
+        if ($check['verdict'] !== 'resume') return '';
+        foreach ($actions as $existing) {
+            $command = strtoupper(explode('@',strval($existing),2)[0]);
+            if (in_array($command,['FOLLOW','STOP_FOLLOW','MOVE_TO','TRAVEL_LOCATION','MOVE_TO_TARGET','HOLD_POSITION','PATROL','BODYGUARD','GUARD_TARGET','ATTACK','IDLE'],true)) return '';
+        }
+        $action = ($state['leader'] ?? '') === 'player' ? 'FOLLOW@'.$speaker : 'TRAVEL_LOCATION@'.strval($state['destination']);
+        $state['execution']['resume_count'] = intval($state['execution']['resume_count'] ?? 0) + 1;
+        $state['execution']['resume_gamets'] = $gamets;
+        if (!stobeTravelWrite($actor,$speaker,$gamets,$state)) return '';
+        $GLOBALS['STOBE_TRIP_RESUME_DONE'][$actor] = $gamets;
+        stobeLogInfo('Trip resume injected',['npc'=>$actor,'action'=>$action,'resume_count'=>$state['execution']['resume_count']]);
+        return $action;
+    } catch (Throwable $error) {
+        stobeLogWarn('Trip resume failed safely',['npc'=>$actor,'error'=>$error->getMessage()]);
+        return '';
+    }
+}
