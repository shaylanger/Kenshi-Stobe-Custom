diff -ruN -x log -x __pycache__ -x soundcache -x '*.orig' -x '*.rej' a/data/imm26_wpB_schema.sql b/data/imm26_wpB_schema.sql
--- a/data/imm26_wpB_schema.sql	1969-12-31 18:00:00.000000000 -0600
+++ b/data/imm26_wpB_schema.sql	2026-10-15 13:26:32.653184057 -0500
@@ -0,0 +1,19 @@
+-- NPC immersion WP-B (2026-10-15): provenance ledger of personal knowledge (items 3/15) and NPC ties (item 4). Additive only.
+CREATE TABLE IF NOT EXISTS social_rumor (
+ id bigserial PRIMARY KEY, campaign_id text NOT NULL, timeline_epoch text NOT NULL DEFAULT '',
+ holder_key text NOT NULL, holder_name text NOT NULL, subject_key text NOT NULL, subject_name text NOT NULL,
+ victim_key text NOT NULL DEFAULT '', victim_name text NOT NULL DEFAULT '', incident_id text NOT NULL,
+ component text NOT NULL DEFAULT '', claim_kind text NOT NULL, claim_text text NOT NULL, severity integer NOT NULL DEFAULT 1,
+ basis text NOT NULL, basis_rank integer NOT NULL DEFAULT 1, source_name text NOT NULL DEFAULT '', hops integer NOT NULL DEFAULT 0,
+ confidence text NOT NULL DEFAULT 'certain', game_ts bigint NOT NULL, learned_ts bigint NOT NULL, ttl_ts bigint NOT NULL,
+ attenuation real NOT NULL DEFAULT 1, victim_total integer NOT NULL DEFAULT 0, effect_delta integer NOT NULL DEFAULT 0,
+ status text NOT NULL DEFAULT 'active', disputed boolean NOT NULL DEFAULT false, corrected_by text NOT NULL DEFAULT '',
+ created_at timestamptz NOT NULL DEFAULT now(),
+ UNIQUE(campaign_id, holder_key, incident_id, subject_key)
+);
+CREATE INDEX IF NOT EXISTS social_rumor_holder ON social_rumor(campaign_id, lower(holder_name));
+CREATE TABLE IF NOT EXISTS npc_ties (
+ campaign_id text NOT NULL, a_name text NOT NULL, b_name text NOT NULL, kind text NOT NULL,
+ strength integer NOT NULL CHECK(strength BETWEEN -100 AND 100), source text NOT NULL, game_ts bigint NOT NULL DEFAULT 0,
+ PRIMARY KEY(campaign_id,a_name,b_name,kind)
+);
