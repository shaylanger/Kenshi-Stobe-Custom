+$legacy = $adapter->propose($context, $legacyIntent);
+expect($legacy['agreement']['scopeVersion'] === 1 && !isset($legacy['agreement']['campZone']),
+    'legacy ClearGroup stays route-backed but unqualified by camp scope');
+
+$tampered = $intent;
+$tampered['campZoneRef']['candidateId'] = 'town-record-44';
