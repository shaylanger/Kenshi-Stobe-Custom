+/** One prompt line for a trip paused by a save/load (data, not an instruction to re-negotiate). */
+function stobeCommitmentResumeNote(?array $state): string {
+    if (!is_array($state) || ($state['status'] ?? '') !== 'ACCEPTED'
+        || ($state['execution']['phase'] ?? '') !== 'interrupted_by_load') return '';
+    return "A save/load paused the agreed walk to " . strval($state['destination'] ?? 'the destination')
+        . "; the same agreement stands and the walk resumes now. Do not re-propose the trip or ask for consent again, and do not say it failed.\n";
