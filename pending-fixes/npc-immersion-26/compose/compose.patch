+<?php
+// WP-C2 items 8 and 9: follow-up resumption + communication preferences with teeth.
+// Run: STOBE_DB_NAME=stobe_test php tests/imm26_wpC2_followups_comm_regression.php   (use flock /tmp/stobe-tests.lock)
+require_once __DIR__ . '/../lib/postgresql.class.php';
+$GLOBALS['db'] = new sql();
+$db = $GLOBALS['db'];
+$checks = 0;
+function check(string $name, bool $ok): void { global $checks; $checks++; if (!$ok) { echo "FAIL $name\n"; cleanup(); exit(1); } }
+
+const T0 = 4000000000; // far above anything real tests write
+$RUN = bin2hex(random_bytes(4));
+function cleanup(): void {
+    // compose: earlier suites (chat_flow) leave recent inputtext/claim rows that block the optional-claim gate (30 s manual-input check, global spacing).
+    $GLOBALS['db']->exec("DELETE FROM eventlog WHERE type IN ('inputtext','inputtext_s','situated_remark_claim') AND localts >= " . (time() - 300));
+    global $db;
+    $db->exec("DELETE FROM eventlog WHERE gamets >= " . T0 . " AND type IN ('social_followup','situated_event','situated_remark_claim','travel_agreement','imm26_squad_comm','imm26_plan_notice','inputtext')");
+}
+cleanup();
+
+/* ---- stubs for the heavy runtime ---- */
+$GLOBALS['T_ATTN'] = []; $GLOBALS['T_COMM'] = ['amount' => 'normal', 'plan_notice' => 'normal']; $GLOBALS['T_PREFS'] = [];
+function storeEvent(string $type, int $ts, int $gamets, string $data, string $sess = 'pending', string $u = '', string $d = '', bool $t = true): ?array {
+    global $db;
+    $ok = $db->exec('INSERT INTO eventlog(type,data,sess,gamets,localts,ts) VALUES ($1,$2,$3,$4,$5,$6)', [$type, $data, $sess, $gamets, time(), $ts]);
+    return $ok === false ? null : ['ok' => true];
+}
+function stobeSocialPreferenceScope(string $actor, array $npc, string $listener, array $meta = []): ?array {
+    global $RUN; return ['key' => "scope-$RUN|$actor|$listener", 'campaign_id' => "camp-$RUN"];
+}
+function stobeSocialScope(object $db, ?array $e = null): array { global $RUN; return ['campaign_id' => "camp-$RUN", 'timeline_epoch' => '1', 'native_session_id' => 's']; }
+function stobeResolveLiveParticipantSerial(string $name, bool $x = false): int { return ['Cind' => 101, 'Shay' => 1, 'Marta' => 102, 'Raider Bob' => 900][$name] ?? 0; }
+function stobeSocialPreferenceRead(string $actor, array $npc, string $listener, int $gamets, array $meta = []): array { return $GLOBALS['T_PREFS'][$actor] ?? []; }
+function stobeSocialAttentionOptionalSpeechAllowed(string $actor, array $npc, array $meta = []): bool { return empty(imm26C2LimitingFlags($GLOBALS['T_ATTN'])) && ($GLOBALS['T_ATTN']['in_combat'] ?? null) !== true; }
+function stobeSocialAttentionState(string $actor, array $npc, array $meta = []): array { return $GLOBALS['T_ATTN']; }
+function extractParticipantNames(array $a): array { return array_values(array_filter(array_map('trim', explode(',', strval($a['people'] ?? ''))))); }
+function stobeTravelKey(string $actor, string $speaker): string { return 'travel-v1:' . stobeResolveLiveParticipantSerial($actor) . ':' . stobeResolveLiveParticipantSerial($speaker) . ':'; }
+function stobeTravelRead(string $actor, string $speaker, int $gamets): ?array { return $GLOBALS['T_TRAVEL'] ?? null; }
+function stobeLogInfo(...$a): void {}
+function stobeLogWarn(...$a): void {}
+
+require_once __DIR__ . '/../lib/social_communication.php';   // also pulls imm26_c2.php
+require_once __DIR__ . '/../lib/social_followups.php';
+require_once __DIR__ . '/../lib/situated_dialogue.php';
+
+$npc = ['name' => 'Cind', 'metadata' => []];
+$base = ['manual_turn_verified' => true, 'response_success' => true, 'social_scope' => ['x' => 1], 'followup_creation_allowed' => true];
+$turnN = 0;
+$npc = ['name' => 'Cind', 'metadata' => []];
+$scope = stobeSocialPreferenceScope('Cind', $npc, 'Shay');
+$n = 0;
+$cap = function (string $text, array $parsed, array $flags, int $now) use ($npc, &$n) {
+    $n++;
+    return stobeSocialFollowupsCapture('Cind', $npc, 'Shay', $text, $parsed, $flags + ['manual_turn_verified' => true, 'response_success' => true, 'social_scope' => ['x' => 1], 'manual_turn_id' => "g-turn-$n", 'stream_gamets' => $now]);
+};
+$none = ['followup_update' => ['decision' => 'NONE', 'topic_id' => '', 'kind' => 'unanswered_question', 'source_quote' => '']];
+$open = fn(int $now) => array_filter(stobeFollowupRead($scope, $now, true), fn($r) => $r['status'] === 'open');
+$hubQ = "I'm heading to the Hub to find my brother.";
+// 08-a as seen on the lane: travel_decision=PROPOSE => chat.php sets followup_creation_allowed=false
+check('A: creation_allowed=false (current PROPOSE gate) -> no row', $cap($hubQ, $none, ['followup_creation_allowed' => false], T0 + 100) === false && count($open(T0 + 200)) === 0);
+// after the patch chat.php sends creation_allowed=true + followup_travel_proposed=true for PROPOSE
+check('B: creation_allowed=true + travel_proposed -> row created from plan grammar', $cap($hubQ, $none, ['followup_creation_allowed' => true, 'followup_travel_proposed' => true], T0 + 300) === true);
+$rows = $open(T0 + 400); check('B2: exactly one open personal_plan', count($rows) === 1 && array_values($rows)[0]['kind'] === 'personal_plan' && array_values($rows)[0]['ask_count'] === 0);
+$r = array_values($rows)[0]; check('B3: not_before +3600, expires +7d', $r['not_before_gamets'] === T0 + 300 + 3600 && $r['expires_gamets'] === T0 + 300 + 7 * 86400);
+// shared plan phrased as "I want us ..." with a model CREATE: must stay blocked while a travel offer is pending
+$shared = "I want us to go to the Hub together.";
+$mc = ['followup_update' => ['decision' => 'CREATE', 'topic_id' => '', 'kind' => 'personal_plan', 'source_quote' => $shared]];
+check('C: shared plan + model CREATE + travel_proposed -> refused', $cap($shared, $mc, ['followup_creation_allowed' => true, 'followup_travel_proposed' => true], T0 + 500) === false);
+check('C2: same without the travel_proposed flag -> would create (why the gate existed)', $cap($shared, $mc, ['followup_creation_allowed' => true], T0 + 600) === true);
+// 08-c: close the Hub topic
+$id = ''; foreach ($open(T0 + 700) as $k => $rec) if (str_contains($rec['source_quote'], 'Hub to find')) $id = $k;
+check('D0: hub topic found', $id !== '');
+$close = ['followup_update' => ['decision' => 'CLOSE', 'topic_id' => $id, 'kind' => 'personal_plan', 'source_quote' => 'I found my brother.']];
+check('D: model CLOSE with listed topic_id and exact quote closes it', $cap('I found my brother.', $close, [], T0 + 800) === true);
+$all = stobeFollowupRead($scope, T0 + 900, true);
+check('D2: topic status closed', ($all[$id]['status'] ?? '') === 'closed');
