+function npc_row(string $name, string $sid): array {
+    return ['name' => $name, 'race' => 'Greenlander', 'faction' => 'No Faction',
+        'metadata' => ['storage_id' => $sid],
+        'extended_data' => ['relationships' => ['Shay' => ['aff' => 80]]]];
+}
+function capture(string $actor, array $npc, string $decision, string $playerLine, string $quote = ''): array {
+    $GLOBALS['STOBE_TRAVEL_STATE'] = [];   // a new HTTP request each turn
+    $raw = json_encode(['travel_decision' => $decision, 'travel_kind' => 'detour', 'travel_leader' => 'npc',
+        'travel_destination' => 'Stumble Inn', 'travel_player_quote' => $quote, 'travel_reason' => 'test']);
