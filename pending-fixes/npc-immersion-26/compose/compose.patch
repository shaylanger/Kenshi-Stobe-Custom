+<?php
+// imm26 15-a: a trade/transfer event is not told to an NPC that was knocked out (unaware) when it happened;
+// participants and aware witnesses still get it.
+// Run: STOBE_DB_NAME=stobe_test php tests/imm26_15a_trade_awareness_regression.php   (flock /tmp/stobe-tests.lock)
+require __DIR__ . '/../lib/bootstrap.php';
+$db = $GLOBALS['db'];
+$pass = 0; $fail = 0;
+function check(string $name, bool $ok, $detail = null): void {
+    global $pass, $fail;
+    if ($ok) { $pass++; echo "PASS $name\n"; } else { $fail++; echo "FAIL $name" . ($detail !== null ? ' :: ' . json_encode($detail) : '') . "\n"; }
+}
+if (strval(getenv('STOBE_DB_NAME')) !== 'stobe_test') { echo "refusing: STOBE_DB_NAME must be stobe_test\n"; exit(2); }
+register_shutdown_function(static function () use ($db): void { $db->exec("ROLLBACK"); });
+$db->exec('BEGIN');
+$db->exec("DELETE FROM eventlog");
+$g = 5000000;
+function ev(string $type, string $data, int $g, string $people): void {
+    $GLOBALS['db']->exec("INSERT INTO eventlog (type, data, gamets, localts, ts, people, location) VALUES ($1,$2,$3,$4,$4,$5,'The Hub')",
+        [$type, $data, $g, time() - 1000 + intval(($g - 5000000) / 10), $people]);
+}
+$all = 'UtKoNpc|UtThief|UtTaker|UtAware';
+ev('chat', 'UtKoNpc: Hello there. (talking to: UtThief)', $g + 10, $all);
+ev('knockout', 'UtKoNpc was knocked out', $g + 20, $all);
+ev('trade', 'UtThief: transferred 1x Sabreclaw (talking to: UtTaker)', $g + 30, $all);
+ev('recovered', 'UtKoNpc regained consciousness', $g + 40, $all);
+ev('trade', 'UtThief: transferred 2x Dried Meat (talking to: UtTaker)', $g + 50, $all);
+ev('trade', 'UtKoNpc: transferred 1x Rags (talking to: UtTaker)', $g + 5, $all);
+$text = static fn(array $rows): string => implode("\n", array_map(static fn($r) => strval($r['data'] ?? ''), $rows));
+
+$ko = $text(DataEventLog(50, 'UtKoNpc'));
+check('KO NPC is not told the transfer that happened while unconscious', !str_contains($ko, 'Sabreclaw'), $ko);
+check('KO NPC still gets the transfer after waking', str_contains($ko, 'Dried Meat'), $ko);
+check('KO NPC still gets its own transfer (participant)', str_contains($ko, 'Rags'), $ko);
+check('KO NPC keeps non-trade rows', str_contains($ko, 'Hello there') && str_contains($ko, 'knocked out'), $ko);
+$aw = $text(DataEventLog(50, 'UtAware'));
+check('an aware bystander is told every transfer', str_contains($aw, 'Sabreclaw') && str_contains($aw, 'Dried Meat'), $aw);
+$tk = $text(DataEventLog(50, 'UtTaker'));
+check('the receiving participant is told the transfer', str_contains($tk, 'Sabreclaw'), $tk);
+echo "imm26_15a_trade_awareness: $pass passed, $fail failed\n";
+exit($fail === 0 ? 0 : 1);
