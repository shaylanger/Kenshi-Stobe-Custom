+/** A refreshed native observation may select a new ID only for the exact same stored point. */
+function stobeTravelObservationMatchesStoredPoint(string $actor, array|false $npc, string $requested, array $stored): bool {
+    if ($requested === '' || ($stored['source'] ?? '') !== 'native_local') return false;
