     p.lastSeen = nowSec;
+    p.lastReal = realSec;
     if (!leaverFree) { p.farSince = -1.0; return false; }
     if (dist <= ArmRadius()) p.armed = true;
     if (dist < FarRadius()) { p.farSince = -1.0; return false; }
