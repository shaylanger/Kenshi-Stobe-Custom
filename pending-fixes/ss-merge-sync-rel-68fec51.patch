+// storage_alias: still bound to its profile. The imposter above (no alias) stays unattributed.
+$resquad = ['entity_key'=>'sess2:7:998', 'serial'=>998, 'name'=>'Combat Delta', 'storage_id'=>'hand_998', 'storage_alias'=>'hand_104',
