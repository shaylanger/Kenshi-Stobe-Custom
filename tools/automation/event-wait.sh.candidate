#!/usr/bin/env bash
# event-wait.sh [--me <name>] [--batch <out-dir>] [--backstop <sec>] [--poll <sec>] [--no-health]   (WSL; start it in the background)
# Event-driven wait (Shay 2026-10-14; replaces the fixed 2-minute check-in, which woke the coordinator for every HEALTH OK).
# The script ends, and so wakes the session, only when one of these happens:
#   INBOX     a file appears in C:\KenshiTestRuns\inbox\<me>\ (a sender drops it next to its SendMessage); the wait prints it and moves it to delivered\ so a re-armed wait does not wake again on the same file
#             QUIET FILTER: an 'AGENT STALL <n>' / 'AGENT ORPHANED <n>' message (agent-host monitor, possibly an older daemon) is re-checked with agent-rollcall.ps1 first:
#             process alive (STALL) AND newest of status/log/outputs-dir evidence < EW_STALL_FRESH_MIN (default 10 min), or the agent is no longer RUNNING => moved to delivered/suppressed/, no wake.
#             DEAD / KILLED / WALL-CLOCK / FAILED / DONE / STOPPED / questions / peer messages always wake. Fails open. Test seam: EW_ROLLCALL_CMD (command printing ROLLCALL lines).
#   STATUS    an agent status file in C:\KenshiTestRuns\agents\ is rewritten to DONE, FAILED or STOPPED-CONTEXT (the latter two end with: respawn fresh <task> from <handoff path>)
#   BATCH     batch-health.sh <out-dir> (--batch) is not HEALTH OK (HEALTH DONE or HEALTH STALL)
#   RIG       rig-health.sh exits non-zero (stall, alert, idle with no reason)
#   BACKSTOP  none of the above for --backstop s (default 600): runs event-sweep.sh and prints its lines after the header
# BATCHING (PI-10, Shay 2026-10-15): non-urgent events (an agent status rewritten to DONE; an inbox message that starts with INFO / ROWTOOL(S) / LANE-INFO or is
#   '<agent> DONE|INFO|interim...' and carries no urgent word or '?') do not end the wait. The first one opens a window of EW_BATCH_SEC (default 90 s, 0 = off = old behaviour);
#   everything that happens meanwhile is printed in ONE wake (one 'EVENT ...' line per item, then 'EVENT BATCH n events over Ns'). Anything urgent
#   (STATUS FAILED / STOPPED-CONTEXT, DEAD, KILLED, WALL-CLOCK, ORPHANED, STALL, questions, peer/unknown inbox messages, BATCH/RIG health, LANE IDLE/NO-OPERATOR, host stall)
#   is never delayed: it wakes at once and flushes the buffered items in front of itself. The backstop flushes too. Unknown message formats are urgent (fail open).
# DIGEST (PI-40 extension, Shay 2026-10-16; EW_DIGEST=1 default, 0 = previous behaviour): the wait ends ONLY for actionable events. Everything else goes into a DIGEST
#   (printed as 'EVENT DIGEST n items' + one '  - kind: text' line per item in front of the next actionable wake or at the backstop; never a wake of its own):
#     * DONE statuses / 'x DONE' / 'TAIL-RELAY x DONE' messages (kind DONE), INFO / ROWTOOL(S) / LANE-INFO / 'x interim' messages (kind INFO)
#     * a duplicate TAIL-RELAY / status for the same agent + outcome class (DONE | STOP) already seen within EW_SEEN_TTL_MIN (180) min (kind DUP); the seen-set is kept in
#       $KAH_RUNS/waker-seen.tsv so a restarted waker remembers
#     * a FAILED / STOPPED-CONTEXT status or relay for an agent that already has a successor (kind HAS-SUCCESSOR): cheap name check (<name>2/b/-2, or a RUNNING/DONE
#       status that names it) first, else the agent-guard-lib Open list (powershell Get-AgentReport; test seam EW_OPEN_CMD prints OPENCHECK-OK + the open agent names;
#       EW_OPEN_PS=0 skips the powershell call). Fails open: no status file, no answer, agent in the Open list => wakes.
#     * a 'SETUP-FAIL <row> ...' notice whose ticket $KAH_RUNS/setupfail/<row>.json is state 'ready' (kind SETUP-FAIL-READY, the newest ticket note is printed; PI-43)
#   Still wake at once: lane idle/no-operator, STOPPED-CONTEXT/FAILED with no successor, STALL/ORPHANED/DEAD/KILLED/WALL-CLOCK, batch/rig/host health, '?', peer/unknown messages.
#   Every suppressed event is also appended to $KAH_RUNS/waker-suppressed.log and every real wake to $KAH_RUNS/waker-wakes.log (epoch<TAB>iso<TAB>kind<TAB>text);
#   tools/automation/waker-stats.sh prints wakes/hour and suppressed/hour from them. EW_DIGEST=0 restores the previous batching/quiet behaviour.
# Inbox and status are checked every --poll s (default 5); batch and rig health every 300 s (EW_HEALTH_EVERY), silently (no model turn).
# Output: "EVENT <kind> <detail>" then exit 0. Test switches: KAH_RUNS (root, default /mnt/c/KenshiTestRuns), --no-health.
# kenshi-waker-guard counts this script as a waker (its name is in the command line).
set -u
ME=coordinator; BATCH=""; BACK=600; POLL=5; HEALTH=1
while [ $# -gt 0 ]; do
  case "$1" in
    --me) ME="$2"; shift 2;;
    --batch) BATCH="$2"; shift 2;;
    --backstop) BACK="$2"; shift 2;;
    --poll) POLL="$2"; shift 2;;
    --no-health) HEALTH=0; shift;;
    *) echo "usage: event-wait.sh [--me name] [--batch out-dir] [--backstop sec] [--poll sec] [--no-health]" >&2; exit 2;;
  esac
done
R=${KAH_RUNS:-/mnt/c/KenshiTestRuns}
HERE=$(cd "$(dirname "$0")" && pwd)
INBOX="$R/inbox/$ME"; mkdir -p "$INBOX"
# stall_suppress <message text>: exit 0 = the message is an AGENT STALL/ORPHANED about an agent that is in fact working (or gone): do not wake. Fails open (exit 1) on any doubt.
stall_suppress() {
  local msg=$1 kind an out line proc sa la rc
  [[ $msg =~ ^AGENT[[:space:]]+(STALL|ORPHANED)[[:space:]]+([A-Za-z0-9._-]+) ]] || return 1
  kind=${BASH_REMATCH[1]}; an=${BASH_REMATCH[2]}
  if [ -n "${EW_ROLLCALL_CMD:-}" ]; then out=$(eval "$EW_ROLLCALL_CMD" 2>/dev/null)
  else
    rc=$(wslpath -w "$HERE/agent-rollcall.ps1" 2>/dev/null) || rc='C:\KenshiModding\tools\automation\agent-rollcall.ps1'
    out=$(timeout 60 powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$rc" 2>/dev/null < /dev/null | tr -d '\r')
  fi
  case "$out" in *ROLLCALL*) ;; *) return 1;; esac
  line=$(printf '%s\n' "$out" | grep -m1 "^ROLLCALL $an ")
  [ -z "$line" ] && return 0                      # no longer RUNNING: terminal statuses wake on their own
  proc=$(printf '%s' "$line" | sed -n 's/.* proc=\([A-Za-z/]*\).*/\1/p')
  sa=$(printf '%s' "$line" | sed -n 's/.* status_age=\([0-9.]*\)m.*/\1/p')
  la=$(printf '%s' "$line" | sed -n 's/.* log_age=\([0-9.]*\)m.*/\1/p')
  [ "$proc" = DEAD ] && return 1
  [ "$kind" = STALL ] && [ "$proc" != alive ] && return 1
  [ -z "$sa" ] && return 1
  awk -v s="$sa" -v l="${la:-$sa}" -v f="${EW_STALL_FRESH_MIN:-10}" 'BEGIN{m=(l+0<s+0)?l:s; exit !(m+0<f+0)}'
}
BATCH_SEC=${EW_BATCH_SEC:-90}; PEND=(); PEND_T0=0; declare -A SEEN
# PI-40 (Shay 2026-10-16): in-session subagents already report DONE by hand-back + task notification, tail-owned ones by a TAIL-RELAY; a waker wake for the same
# DONE is a third duplicate model turn. EW_QUIET_DONE=1 (default; 0 = old PI-10 batching) keeps DONE status events and 'x DONE' / 'TAIL-RELAY x DONE' inbox
# messages OUT of the wake decision: they are buffered in QUIET and printed (as 'EVENT DONE ...' lines) in front of the NEXT wake of any kind or the backstop.
# FAILED / STOPPED-CONTEXT / DEAD / KILLED / ORPHANED / STALL / lane / health / questions still wake at once.
QUIET_DONE=${EW_QUIET_DONE:-1}; QUIET=()
quiet_msg() { [ "$QUIET_DONE" = 1 ] && { [[ $1 != *'?'* ]] || [[ $1 == TAIL-RELAY* ]]; } && [[ $1 =~ ^(TAIL-RELAY[[:space:]]+)?[A-Za-z0-9._-]+[[:space:]]+DONE([[:space:]:]|$) ]]; }
# ---- DIGEST machinery (EW_DIGEST=1 default) ----
DIGEST_ON=${EW_DIGEST:-1}; DIGEST=(); SUPP_LOG="$R/waker-suppressed.log"; WAKE_LOG="$R/waker-wakes.log"; SEEN_FILE="$R/waker-seen.tsv"
SEEN_TTL=$(( ${EW_SEEN_TTL_MIN:-180} * 60 ))
# logline <file> <kind> <text>: epoch TAB iso TAB kind TAB one-line text
logline() { printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$(date +%Y-%m-%dT%H:%M:%S)" "$2" "$(printf '%s' "$3" | tr '\n\t' '  ' | cut -c1-300)" >> "$1" 2>/dev/null; }
# dig <kind> <text>: record a suppressed (digest) event
dig() { logline "$SUPP_LOG" "$1" "$2"; DIGEST+=("$1: $(printf '%s' "$2" | tr '\n' ' ' | cut -c1-300)"); }
# seen_has <key> / seen_add <key>: (agent:CLASS) already reported within the TTL; persisted so a restarted waker remembers
seen_has() { [ -f "$SEEN_FILE" ] && awk -F'\t' -v t=$(( $(date +%s) - SEEN_TTL )) -v k="$1" '$1>=t && $2==k{f=1} END{exit !f}' "$SEEN_FILE"; }
seen_add() { printf '%s\t%s\n' "$(date +%s)" "$1" >> "$SEEN_FILE" 2>/dev/null; }
# has_successor <agent>: cheap successor check on the status files (prints the successor name, rc 0): <name>+[-_]?[2-9b-z], or a RUNNING/DONE status written
# after the agent's own that names it as a whole word (agent-guard-lib rule f).
has_successor() {
  local x=$1 xf="$R/agents/$1.status" f sn sl xr
  [ -f "$xf" ] || return 1
  xr=${x//./\\.}
  while IFS= read -r f; do
    sn=$(basename "$f" .status); [ "$sn" = "$x" ] && continue
    sl=$(head -1 "$f" | tr -d '\r'); [[ $sl =~ ^[^|]*[|][[:space:]]*(RUNNING|DONE)[[:space:]]*[|] ]] || continue
    if [[ $sn == "$x"* ]] && [[ ${sn#"$x"} =~ ^[-_]?([2-9]|[b-z])$ ]]; then echo "$sn"; return 0; fi
    if grep -qE "(^|[^A-Za-z0-9_.-])${xr}([^A-Za-z0-9_.-]|\$)" "$f" 2>/dev/null; then echo "$sn"; return 0; fi
  done < <(find "$R/agents" -maxdepth 1 -name '*.status' -newer "$xf" 2>/dev/null)
  return 1
}
# open_check <agent>: rc 0 = agent-guard-lib says the agent is NOT in its Open (no successor) list, i.e. a successor exists or it was abandoned. Any doubt => rc 1 (wake).
open_check() {
  local n=$1 out aw
  [ -f "$R/agents/$n.status" ] || return 1
  if [ -n "${EW_OPEN_CMD:-}" ]; then out=$(eval "$EW_OPEN_CMD" 2>/dev/null)
  else
    [ "${EW_OPEN_PS:-1}" = 1 ] || return 1
    aw=$(wslpath -w "$R/agents" 2>/dev/null) || return 1
    out=$(timeout 60 powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ". 'C:\KenshiModding\tools\automation\agent-guard-lib.ps1'; \$r = Get-AgentReport -AgentsDir '$aw'; 'OPENCHECK-OK'; \$r.Open | ForEach-Object { \$_.Name }" 2>/dev/null < /dev/null | tr -d '\r')
  fi
  case "$out" in *OPENCHECK-OK*) ;; *) return 1;; esac
  printf '%s\n' "$out" | grep -qxF -- "$n" && return 1
  return 0
}
# stop_suppress <agent> <source text>: exit 0 = a FAILED/STOPPED-CONTEXT event that need not wake (duplicate, or the agent already has a successor); digest line written.
stop_suppress() {
  local n=$1 txt=$2 succ
  [ "$DIGEST_ON" = 1 ] || return 1
  if seen_has "$n:STOP"; then dig DUP "$txt"; return 0; fi
  seen_add "$n:STOP"
  if succ=$(has_successor "$n"); then dig HAS-SUCCESSOR "$txt (successor $succ)"; return 0; fi
  if open_check "$n"; then dig HAS-SUCCESSOR "$txt (agent-guard-lib: not open, successor or abandoned)"; return 0; fi
  return 1
}
# setupfail_ready <row>: rc 0 + the newest ticket note when the ticket exists and is state 'ready' (PI-43)
setupfail_ready() {
  local row=${1#IMM-}; local f="$R/setupfail/$row.json"
  [ -f "$f" ] || f="$R/setupfail/$(printf '%s' "$row" | tr 'A-Z' 'a-z').json"
  [ -f "$f" ] || return 1
  python3 -c '
import json, sys
t = json.load(open(sys.argv[1], encoding="utf-8-sig"))
if t.get("state") != "ready":
    sys.exit(1)
n = t.get("notes") or [""]
print(str(n[-1]).replace("\n", " ")[:220])
' "$f"
}
# digest_msg <first line of the message>: exit 0 = the inbox message is handled by the digest (no wake). Only the first line is inspected.
digest_msg() {
  local hd=$1 ag st note row
  [ "$DIGEST_ON" = 1 ] || return 1
  [[ $hd == *'?'* ]] && return 1                       # a question always wakes
  if [[ $hd =~ ^SETUP-FAIL[[:space:]]+([A-Za-z0-9._-]+) ]]; then
    row=${BASH_REMATCH[1]}
    if note=$(setupfail_ready "$row"); then dig SETUP-FAIL-READY "$row (ticket already ready; newest note: $note)"; return 0; fi
    return 1
  fi
  if [[ $hd =~ ^(TAIL-RELAY[[:space:]]+)?([A-Za-z0-9._-]+)[[:space:]]+(FAILED|STOPPED-CONTEXT)([[:space:]:]|$) ]]; then
    ag=${BASH_REMATCH[2]}; st=${BASH_REMATCH[3]}
    [ -f "$R/agents/$ag.status" ] || return 1          # not a known agent: never judge it (fail open)
    stop_suppress "$ag" "${BASH_REMATCH[1]:+TAIL-RELAY }$ag $st" && return 0
  fi
  return 1
}
# urgent_msg <text>: exit 0 = must wake at once. Non-urgent only when the text is clearly an INFO/DONE report with no alarm word and no question mark.
urgent_msg() {
  local t=$1
  [[ $t == *'?'* ]] && return 0
  [[ $t =~ (DEAD|KILLED|WALL-CLOCK|FAILED|STOPPED|ORPHANED|STALL|STUCK|IDLE|NO-OPERATOR|ALERT|HEALTH) ]] && return 0
  [[ $t =~ ^(INFO|ROWTOOLS?|LANE-INFO)([[:space:]:]|$) ]] && return 1
  [[ $t =~ ^[A-Za-z0-9._-]+[[:space:]]+(DONE|INFO|interim)([[:space:]:]|$) ]] && return 1
  return 0
}
# defer <line>: buffer a non-urgent event (opens the window on the first one)
defer() { if [ "$DIGEST_ON" = 1 ]; then dig INFO "${1#EVENT }"; return 0; fi; [ "${#PEND[@]}" -eq 0 ] && PEND_T0=$(date +%s); PEND+=("$1"); }
# quiet_add <EVENT line>: a DONE report (never a wake)
quiet_add() { if [ "$DIGEST_ON" = 1 ]; then dig DONE "${1#EVENT }"; else QUIET+=("$1"); fi; }
# flush: print buffered events (called before any wake)
flush() {
  local n=${#PEND[@]} l
  if [ "${#DIGEST[@]}" -gt 0 ]; then echo "EVENT DIGEST ${#DIGEST[@]} items"; for l in "${DIGEST[@]}"; do echo "  - $l"; done; DIGEST=(); fi
  if [ "${#QUIET[@]}" -gt 0 ]; then for l in "${QUIET[@]}"; do echo "EVENT DONE(quiet) ${l#EVENT }"; done; QUIET=(); fi
  [ "$n" -eq 0 ] && return 0
  for l in "${PEND[@]}"; do echo "$l"; done
  echo "EVENT BATCH $n events over $(( $(date +%s) - PEND_T0 ))s"
  PEND=()
}
# wake <line...>: flush the buffer, print the urgent event, end the wait
wake() { flush; echo "$*"; logline "$WAKE_LOG" "$(printf '%s' "$1" | awk '{print $2}')" "$*"; exit 0; }
MARK=$(mktemp); trap 'rm -f "$MARK"' EXIT   # created now: status files rewritten after this point are "new"
start=$(date +%s); last_health=0
while :; do
  now=$(date +%s)
  # INBOX: a message file waiting directly in the inbox
  m=$(find "$INBOX" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort | head -1)
  if [ -n "$m" ] && stall_suppress "$(head -c 400 "$INBOX/$m" | tr -d '\r' | tr '\n' ' ')"; then
    logline "$SUPP_LOG" STALL-SUPPRESSED "$m: $(head -c 200 "$INBOX/$m" | tr -d '\r' | tr '\n' ' ')"
    mkdir -p "$INBOX/delivered/suppressed"; mv "$INBOX/$m" "$INBOX/delivered/suppressed/"; m=""   # quiet filter: working/gone agent, no wake
  fi
  if [ -n "$m" ]; then
    txt=$(head -c 300 "$INBOX/$m" | tr -d '\r' | tr '\n' ' '); hd1=$(head -1 "$INBOX/$m" | tr -d '\r' | cut -c1-200); mkdir -p "$INBOX/delivered"; mv "$INBOX/$m" "$INBOX/delivered/"
    if quiet_msg "$txt"; then
      if [ "$DIGEST_ON" = 1 ] && [[ $txt =~ ^TAIL-RELAY[[:space:]]+([A-Za-z0-9._-]+)[[:space:]]+DONE ]]; then
        if seen_has "${BASH_REMATCH[1]}:DONE"; then dig DUP "$m: $txt"; continue; fi
        seen_add "${BASH_REMATCH[1]}:DONE"
      fi
      quiet_add "EVENT INBOX $m: $txt"; continue
    fi
    if digest_msg "$hd1"; then continue; fi
    if [ "$BATCH_SEC" -gt 0 ] && ! urgent_msg "$txt"; then defer "EVENT INBOX $m: $txt"; continue; fi
    wake "EVENT INBOX $m: $txt"
  fi
  # STATUS: an agent status file rewritten since this wait started, now DONE / FAILED / STOPPED-CONTEXT
  while IFS= read -r f; do
    l=$(head -1 "$f" | tr -d '\r')
    if [[ $l =~ ^[^|]*[|][[:space:]]*(DONE|FAILED|STOPPED-CONTEXT)[[:space:]]*[|] ]]; then
      n=$(basename "$f" .status); st=${BASH_REMATCH[1]}; task=$(sed -n 2p "$f" | tr -d '\r' | cut -c1-200)
      rs=""
      if [ "$st" != DONE ]; then   # work is not finished: say how to pick it up (a fresh agent, never SendMessage the old one)
        h="$R/agents/$n.handoff.md"; [ -f "$h" ] || h="$f"
        case "$h" in /mnt/c/*|/c/*) h="C:\$(printf '%s' "${h#/mnt}" | sed 's|^/c/||; s|/|\|g')";; esac
        rs=" | respawn fresh ${task#task: } from $h (unless a successor such as ${n}2 or ${n}b already runs)"
      fi
      if [ "$st" = DONE ] && [ "$QUIET_DONE" = 1 ]; then
        sk="$f:$(stat -c %Y "$f")"; [ -n "${SEEN[$sk]:-}" ] && continue
        SEEN[$sk]=1; quiet_add "EVENT STATUS $n $st: $task"; continue
      fi
      if [ "$st" != DONE ] && [ "$DIGEST_ON" = 1 ]; then
        sk="$f:$(stat -c %Y "$f")"; [ -n "${SEEN[$sk]:-}" ] && continue
        SEEN[$sk]=1
        stop_suppress "$n" "STATUS $n $st: $task" && continue
      fi
      if [ "$st" = DONE ] && [ "$BATCH_SEC" -gt 0 ]; then
        sk="$f:$(stat -c %Y "$f")"; [ -n "${SEEN[$sk]:-}" ] && continue
        SEEN[$sk]=1; defer "EVENT STATUS $n $st: $task"; continue
      fi
      wake "EVENT STATUS $n $st: $task$rs"
    fi
  done < <(find "$R/agents" -maxdepth 1 -name '*.status' -newer "$MARK" 2>/dev/null)
  # AGENT-HOST: the hidden daemon that owns the independent agents writes agent-queue/host.state.json every ~2 s; stale > 120 s while it had agents/jobs = restart it hidden and wake
  hs="$R/agent-queue/host.state.json"
  if [ -f "$hs" ] && [ $(( now - $(stat -c %Y "$hs") )) -gt "${EW_HOST_STALE:-120}" ] && grep -Eq '"(live|queued)": *[1-9]' "$hs"; then
    powershell.exe -NoProfile -Command "Start-Process powershell.exe -WindowStyle Hidden -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File','C:\KenshiModding\tools\automation\agent-host.ps1'" < /dev/null >/dev/null 2>&1
    touch "$hs"
    wake "EVENT STALL agent-host: heartbeat was > ${EW_HOST_STALE:-120}s old with live/queued agents; restarted it hidden (check agent-rollcall.ps1 and the agents' pids)"
  fi
  # BATCH + RIG: silent health checks every 300 s (EW_HEALTH_EVERY); anything not healthy wakes the session
  if [ "$HEALTH" = 1 ] && [ $(( now - last_health )) -ge "${EW_HEALTH_EVERY:-300}" ]; then
    last_health=$now
    if [ -n "$BATCH" ]; then
      b=$(timeout 120 bash "$HERE/batch-health.sh" "$BATCH" 2>&1 | tail -1)
      case "$b" in "HEALTH OK"*) ;; *) wake "EVENT BATCH ${b:-no output from batch-health}";; esac
    fi
    rg=$(timeout 150 bash "$HERE/rig-health.sh" 2>&1); rc=$?
    if [ "$rc" -ne 0 ]; then wake "EVENT RIG rc=$rc $(printf '%s\n' "$rg" | tail -1)"; fi
  fi
  # LANES: per-lane activity check (lane-idle.ps1: operator RUNNING + status/evidence younger than 6 min); wakes on LANE IDLE / LANE NO-OPERATOR
  if [ "$HEALTH" = 1 ] && [ $(( now - ${last_lane:-0} )) -ge "${EW_LANE_EVERY:-90}" ]; then
    last_lane=$now
    li=$(timeout 60 powershell.exe -NoProfile -ExecutionPolicy Bypass -File 'C:\KenshiModding\tools\automation\lane-idle.ps1' 2>&1 < /dev/null | tr -d '\r')
    case "$li" in *"LANE IDLE"*|*"LANE NO-OPERATOR"*) wake "EVENT LANE $(printf '%s\n' "$li" | grep -E 'LANE (IDLE|NO-OPERATOR)' | head -5 | tr '\n' ' ')";; esac
  fi
  # OPERATOR WARN (handover overlap): operator-warn.sh prints one line per NEW warn (successor spawn text); urgent
  ow=$(KAH_RUNS="$R" bash "$HERE/operator-warn.sh" 2>/dev/null)
  if [ -n "$ow" ]; then wake "EVENT $(printf '%s\n' "$ow" | head -3 | tr '\n' ' ')"; fi
  # BACKSTOP: nothing else happened for --backstop seconds; the sweep catches what no sender reported
  if [ $(( now - start )) -ge "$BACK" ]; then
    flush; echo "EVENT BACKSTOP after $(( now - start ))s"; logline "$WAKE_LOG" BACKSTOP "after $(( now - start ))s"; bash "$HERE/event-sweep.sh" 2>&1; exit 0
  fi
  # BATCH WINDOW: the first non-urgent event is old enough: one wake with everything collected
  if [ "${#PEND[@]}" -gt 0 ] && [ $(( now - PEND_T0 )) -ge "$BATCH_SEC" ]; then flush; logline "$WAKE_LOG" BATCH "${#PEND[@]} events"; exit 0; fi
  sleep "$POLL"
done
