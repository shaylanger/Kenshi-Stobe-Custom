#!/bin/bash
# stobe-fight-watch "<pay line>" [timeout_s]
# Watches stobe.log from now. On the first attack on Shay, it sends the pay line right away
# (no waiting for Claude), then keeps logging fight lines for 20 s and exits.
L=/mnt/d/Steam/steamapps/common/Kenshi/RE_Kenshi/mods/Stobe/stobe.log
PAY="$1"; T=${2:-600}
OUT=/tmp/fight-watch.log; : > $OUT
start=$(stat -c %s "$L")
deadline=$(( $(date +%s) + T ))
while [ $(date +%s) -lt $deadline ]; do
  if tail -c +$((start+1)) "$L" | grep -aq "\[EVENT\] combat: .* -> Shay"; then
    echo "ATTACK $(date +%T)" >> $OUT
    ( sleep ${DELAY:-0}; [ -n "$PAY" ] && stobe-say say Malzin "$PAY" >> $OUT 2>&1 ) &
    sleep 20
    tail -c +$((start+1)) "$L" | grep -a "combat: \|PERSONAL_FIGHT\|PERSONAL_TRUCE\|STOP_ATTACK" | cut -c1-220 >> $OUT
    echo "TRIGGERED"; cat $OUT; exit 0
  fi
  sleep 0.25
done
echo "TIMEOUT (no attack)"
