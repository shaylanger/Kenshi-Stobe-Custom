#!/bin/bash
# stobe-reset-npc <npc> [since-date]
# Clears one NPC's server-side test state (live `stobe` DB; Shay OK'd this for test
# data, 2026-09-30): her deals and queued directives, memories / summaries / diary / events
# involving her since <since-date> (default 2026-09-29), and her relationship entry for the
# player (affinity back to neutral). The game save is untouched: reload it separately.
# Her relationship entry for the player is saved first (only the first time, so repeated
# test resets keep the real value) to /root/stobe-backups/relationship_saved/<npc>.json;
# `stobe-reset-npc --restore <npc>` puts it back and removes the saved copy.
set -e
SAVE_DIR=/root/stobe-backups/relationship_saved
mkdir -p "$SAVE_DIR"
if [ "$1" = "--restore" ]; then
  npc="${2:?usage: stobe-reset-npc --restore <npc>}"
  lower=$(echo "$npc" | tr '[:upper:]' '[:lower:]')
  f="$SAVE_DIR/$lower.json"
  [ -s "$f" ] || { echo "nothing saved for $npc"; exit 1; }
  player=$(sudo -u postgres psql -d stobe -At -c "SELECT value FROM general_settings WHERE id='PLAYER_NAME'" 2>/dev/null); player="${player:-Shay}"
  entry=$(cat "$f")
  sudo -u postgres psql -d stobe -v ON_ERROR_STOP=1 -q -v entry="$entry" <<SQL
UPDATE core_npc_master SET extended_data = jsonb_set(COALESCE(extended_data,'{}'::jsonb), '{relationships}',
    COALESCE(extended_data->'relationships','{}'::jsonb) || jsonb_build_object('${player}', :'entry'::jsonb))
  WHERE LOWER(name)='${lower}';
UPDATE core_npc_master SET relationships = (CASE WHEN relationships LIKE '{%' THEN relationships::jsonb ELSE '{}'::jsonb END
    || jsonb_build_object('${player}', :'entry'::jsonb))::text WHERE LOWER(name)='${lower}';
SQL
  rm -f "$f"
  echo "restored $npc -> $player: $entry"
  exit 0
fi
npc="${1:?usage: stobe-reset-npc <npc> [since-date YYYY-MM-DD] | --restore <npc>}"
since="${2:-2026-09-29}"
lower=$(echo "$npc" | tr '[:upper:]' '[:lower:]')
player=$(sudo -u postgres psql -d stobe -At -c "SELECT value FROM general_settings WHERE id='PLAYER_NAME'" 2>/dev/null)
player="${player:-Shay}"
if [ ! -s "$SAVE_DIR/$lower.json" ]; then
  saved=$(sudo -u postgres psql -d stobe -At -c "SELECT v FROM core_npc_master m, jsonb_each(m.extended_data->'relationships') AS e(k, v) WHERE LOWER(m.name)='${lower}' AND LOWER(k)=LOWER('${player}') LIMIT 1")
  if [ -n "$saved" ]; then echo "$saved" > "$SAVE_DIR/$lower.json"; echo "saved $npc -> $player: $saved"; fi
fi
sudo -u postgres psql -d stobe -v ON_ERROR_STOP=1 -q <<SQL
BEGIN;
\set since 'extract(epoch from timestamptz ''${since} 00:00-06'')'
SELECT 'deals', count(*) FROM stobe_social_contract WHERE LOWER(npc_name)='${lower}';
DELETE FROM stobe_social_contract WHERE LOWER(npc_name)='${lower}';
DELETE FROM stobe_negotiation_directive WHERE LOWER(npc_name)='${lower}';
DELETE FROM memory WHERE people ILIKE '%${lower}%' AND localts >= :since;
DELETE FROM memory_summary WHERE people ILIKE '%${lower}%' AND localts >= :since;
DELETE FROM diarylog WHERE people ILIKE '%${lower}%' AND localts >= :since;
DELETE FROM eventlog WHERE people ILIKE '%${lower}%' AND localts >= :since;
-- the player's key in either case ("Shay" vs setting "shay"), in both copies (extended_data + relationships column)
UPDATE core_npc_master SET extended_data = jsonb_set(extended_data, '{relationships}',
    COALESCE((SELECT jsonb_object_agg(k, v) FROM jsonb_each(extended_data->'relationships') AS e(k, v) WHERE LOWER(k) <> LOWER('${player}')), '{}'::jsonb))
  WHERE LOWER(name)='${lower}' AND jsonb_typeof(extended_data->'relationships') = 'object';
UPDATE core_npc_master SET relationships = COALESCE((SELECT jsonb_object_agg(k, v) FROM jsonb_each(relationships::jsonb) AS e(k, v) WHERE LOWER(k) <> LOWER('${player}')), '{}'::jsonb)::text
  WHERE LOWER(name)='${lower}' AND relationships LIKE '{%';
SELECT 'relationship left', COUNT(*) FROM core_npc_master WHERE LOWER(name)='${lower}'
  AND (EXISTS (SELECT 1 FROM jsonb_object_keys(COALESCE(extended_data->'relationships','{}'::jsonb)) k WHERE LOWER(k)=LOWER('${player}'))
    OR (relationships LIKE '{%' AND EXISTS (SELECT 1 FROM jsonb_object_keys(relationships::jsonb) k WHERE LOWER(k)=LOWER('${player}'))));
COMMIT;
SQL
echo "reset $npc (since $since, relationship to $player cleared)"
